def require(value, message):
    if not value: raise ValueError(message)


def canonical(value):
    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('ascii')


def digest(value):
    return sha256(canonical(value)).hexdigest()


def pin(raw):
    return dict(bytes=len(raw), sha256=sha256(raw).hexdigest())


def keys(value, fields):
    require(type(value) is dict and set(value) == set(fields.split()), 'closed fields required')


def parse(raw):
    require(type(raw) is bytes and len(raw) <= 8*1024**2, 'bounded JSON bytes required')
    depth = nodes = 0
    quoted = escaped = False
    for byte in raw:
        if quoted:
            if escaped: escaped = False
            elif byte == 92: escaped = True
            elif byte == 34: quoted = False
        elif byte == 34: quoted, nodes = True, nodes+1
        elif byte in (91, 123): depth, nodes = depth+1, nodes+1
        elif byte in (93, 125): depth -= 1
        elif byte == 44: nodes += 1
        require(0 <= depth <= 256 and nodes <= 1000000, 'JSON complexity limit')
    def pairs(items):
        result = {}
        for key, value in items:
            require(key not in result, 'duplicate JSON key')
            result[key] = value
        return result
    def nonfinite(value): raise ValueError('nonfinite JSON')
    value = json.loads(raw, object_pairs_hook=pairs, parse_constant=nonfinite)
    require(canonical(value) == raw, 'noncanonical JSON')
    return value


def ordinary(path, *, directory=False, allow_links=False):
    info = os.lstat(path)
    require(not stat.S_ISLNK(info.st_mode) and not getattr(info, 'st_file_attributes', 0)&0x400, 'reparse path')
    require(stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode)
        and (allow_links or info.st_nlink == 1), 'nonordinary path')
    return info


def directories(path):
    path = Path(path).absolute()
    return tuple((str(p), s.st_dev, s.st_ino) for p in reversed((path, *path.parents))
        for s in (ordinary(p, directory=True),))


def identity(info):
    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns


def read(path, *, allow_links=False):
    path = Path(path)
    parents = directories(path.parent)
    before = identity(ordinary(path, allow_links=allow_links))
    require(before[2] <= 8*1024**2, 'file byte cap')
    with path.open('rb') as stream:
        require(identity(os.fstat(stream.fileno())) == before, 'file changed before read')
        raw = stream.read(8*1024**2+1)
        require(identity(os.fstat(stream.fileno())) == before, 'file changed during read')
    require(len(raw) == before[2] and identity(ordinary(path, allow_links=allow_links)) == before
        and directories(path.parent) == parents, 'file/parent changed after read')
    return raw


def source_names():
    raw = read(INHERITED)
    require(sha256(raw).hexdigest() == INHERITED_SHA, 'frozen inherited source inventory differs')
    inherited = json.loads(raw)
    require(type(inherited) is dict and len(inherited) == 45, 'inherited source set differs')
    return tuple(sorted(set(inherited)|set(NEW_SOURCES)))


def source_pins():
    names = source_names()
    require(len(names) == 49, 'selected source count differs')
    return {name: pin(read(ROOT/name)) for name in names}


def environment():
    allowed = {'PATH', 'SYSTEMROOT', 'WINDIR', 'COMSPEC', 'PATHEXT', 'TEMP', 'TMP', 'USERPROFILE',
        'APPDATA', 'LOCALAPPDATA', 'PROGRAMFILES', 'PROGRAMFILES(X86)', 'COMMONPROGRAMFILES',
        'NUMBER_OF_PROCESSORS', 'PROCESSOR_ARCHITECTURE', 'CONDA_PREFIX', 'CONDA_DEFAULT_ENV'}
    result = {k: v for k, v in os.environ.items() if k.upper() in allowed}
    result.update(PYTHONDONTWRITEBYTECODE='1', PYTHONNOUSERSITE='1', PYTHONHASHSEED='0',
        OMP_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1', MKL_NUM_THREADS='1')
    return result


def output_mode(path):
    path = Path(path).absolute()
    if path == OUTPUT: return 'saved_P1_F_validation'
    temporary = Path(tempfile.gettempdir()).resolve()
    require(path.resolve().is_relative_to(temporary) and path.name == 'output'
        and path.parent.name.startswith('test_') and path.parent.parent.name.startswith('pytest-'),
        'fixed F output or dedicated ordinary pytest output required')
    return 'ordinary_pytest_fixture'


def validate_context(value):
    keys(value, 'schema authority scope repo_root input_root output_root source_pins executable environment '
        'anchor_sha input_files invocation_started deadline stage_seconds limits inherited_sources_pin '
        'caller_core caller_sha output_mode output_parent_directories '+' '.join(GATES))
    require(value['schema'] == SCHEMA and value['authority'] == 'DRAFT_NONAUTHORITATIVE'
        and value['scope'] == SCOPE and all(value[k] is False for k in GATES), 'context authority/scope differs')
    require(value['repo_root'] == str(ROOT) and value['input_root'] == str(P1), 'fixed saved P1 root differs')
    output = Path(value['output_root'])
    require(output.is_absolute() and '..' not in output.parts and str(output.absolute()) == str(output)
        and not output.is_relative_to(P1) and not P1.is_relative_to(output), 'output overlaps saved P1')
    require(value['output_mode'] == output_mode(output), 'output mode differs')
    require(value['output_parent_directories'] == [list(row) for row in directories(output.parent)], 'output parent identity changed')
    require(value['limits'] == CAPS and value['stage_seconds'] == STAGE_SECONDS, 'fixed F budget differs')
    require(type(value['deadline']) is float and math.isfinite(value['deadline']) and value['deadline'] > 0,
        'finite absolute deadline required')
    require(type(value['invocation_started']) is float and math.isfinite(value['invocation_started'])
        and 0 < value['invocation_started'] <= time.monotonic()
        and value['deadline'] == value['invocation_started']+180, 'absolute deadline differs from invocation budget')
    require(value['anchor_sha'] == ANCHOR_SHA and type(value['input_files']) is dict
        and len(value['input_files']) == 683, 'saved anchor/input map differs')
    require(type(value['source_pins']) is dict and set(value['source_pins']) == set(source_names()), 'closed selected source group differs')
    for item in tuple(value['source_pins'].values())+tuple(value['input_files'].values())+(value['inherited_sources_pin'],):
        keys(item, 'bytes sha256')
        require(type(item['bytes']) is int and 0 <= item['bytes'] <= 8*1024**2 and type(item['sha256']) is str
            and len(item['sha256']) == 64 and all(c in '0123456789abcdef' for c in item['sha256']), 'invalid held pin')
    keys(value['executable'], 'path pin identity python')
    require(value['executable']['path'] == str(EXE) and value['executable']['python'] == sys.version,
        'bound executable/Python differs')
    require(type(value['environment']) is dict and all(type(k) is type(v) is str for k, v in value['environment'].items()),
        'controlled environment fields differ')
    require(type(value['caller_core']) is dict and value['caller_sha'] == digest(value['caller_core'])
        and value['caller_core']['files'] == value['input_files']
        and value['caller_core']['source'] == value['source_pins'], 'external caller core differs')
    canonical(value)
    return value


def check_context(raw, expected_sha):
    require(type(expected_sha) is str and len(expected_sha) == 64 and sha256(raw).hexdigest() == expected_sha,
        'held context SHA differs')
    value = validate_context(parse(raw))
    require(Path.cwd().absolute() == ROOT, 'actual working directory differs')
    require(pin(read(INHERITED)) == value['inherited_sources_pin'], 'inherited source inventory changed')
    anchor = read(P1.parent/'p1_execution_review_01/postcheck_03.stdout.json')
    require(sha256(anchor).hexdigest() == ANCHOR_SHA and json.loads(anchor)['p1_files'] == value['input_files'],
        'held full P1 map differs from frozen external anchor')
    require(source_pins() == value['source_pins'], 'selected source bytes changed')
    require(str(Path(sys.executable).absolute()) == value['executable']['path']
        and pin(read(sys.executable, allow_links=True)) == value['executable']['pin']
        and list(identity(ordinary(sys.executable, allow_links=True))) == value['executable']['identity'],
        'actual executable differs')
    require(environment() == value['environment'], 'controlled environment changed')
    require(time.monotonic() <= value['deadline'], 'whole F absolute deadline')
    return value


def make_context(output_root, *, started):
    """Build bytes only; creation/spawn need a separately held trusted invocation."""
    require(type(started) is float and math.isfinite(started) and started <= time.monotonic(), 'invocation start required')
    anchor = read(P1.parent/'p1_execution_review_01/postcheck_03.stdout.json')
    require(sha256(anchor).hexdigest() == ANCHOR_SHA, 'external saved P1 anchor differs')
    require(Path(sys.executable).absolute() == EXE, 'bound compute executable required')
    output = Path(output_root).absolute()
    mode = output_mode(output)
    require(not os.path.lexists(output), 'dedicated output already exists')
    selected = source_pins()
    require(pin(read(EXE, allow_links=True))['bytes'] > 0, 'bound executable missing')
    # Only the trusted initial capture imports scientific definitions. Its inputs
    # and selected bytes have already been checked; role bootstrap stays stdlib.
    from src import staged_rts24_saved_fresh_adoption_v1 as adapter
    captured = adapter.capture(selected)
    caller_core = parse(captured.image)
    value = dict(schema=SCHEMA, authority='DRAFT_NONAUTHORITATIVE', scope=SCOPE, repo_root=str(ROOT), input_root=str(P1),
        output_root=str(output), output_mode=mode, output_parent_directories=[list(row) for row in directories(output.parent)],
        source_pins=selected, caller_core=caller_core, caller_sha=digest(caller_core),
        executable=dict(path=str(EXE), pin=pin(read(EXE, allow_links=True)),
            identity=list(identity(ordinary(EXE, allow_links=True))), python=sys.version), environment=environment(),
        anchor_sha=ANCHOR_SHA, input_files=json.loads(anchor)['p1_files'], inherited_sources_pin=pin(read(INHERITED)),
        invocation_started=started, deadline=started+180, stage_seconds=dict(STAGE_SECONDS), limits=dict(CAPS), **GATES)
    raw = canonical(validate_context(value))
    check_context(raw, sha256(raw).hexdigest())
    return raw


def argv_for(role, context_raw, context_sha, *, tree_sha, channel_name, channel_nonce):
    require(role in ('parent', 'fresh'), 'saved supervise requires a separate trusted invocation')
    context = check_context(context_raw, context_sha)
    return _saved_file_tokens(role, str(Path(context['output_root'])/'context.json'), context_sha,
        tree_sha, channel_name, channel_nonce)


def validate_actual_entry(role, context_raw, context_sha):
    held = _held_saved_bootstrap(role, context_raw, context_sha)
    transport = parse(held.transport)
    expected = argv_for(role, context_raw, context_sha, tree_sha=transport['tree_sha'],
        channel_name=transport['channel_name'], channel_nonce=transport['channel_nonce'])
    main = _direct_main_shape(expected)
    context = parse(context_raw)
    require(pin(read(main.__file__)) == context['source_pins'][NEW_SOURCES[1]], 'actual entry bytes differ')
    return context


def execution_context(role, context_raw, context_sha):
    context = parse(context_raw)
    require(context['output_mode'] == 'saved_P1_F_validation', 'ordinary test context cannot enter F execution/adoption')
    return validate_actual_entry(role, context_raw, context_sha)


@dataclass(frozen=True, init=False)
class HeldContext:
    """Immutable creating-process validated data; no process or run authority."""
    raw: bytes
    sha: str
    output_root: str
    output_directories: tuple
    creator: tuple

    def __reduce__(self): raise TypeError('held validation context cannot be serialized')


def hold_context(raw, expected_sha):
    value = check_context(raw, expected_sha)
    held = object.__new__(HeldContext)
    for name, data in dict(raw=raw, sha=expected_sha, output_root=value['output_root'],
            output_directories=directories(value['output_root']), creator=(os.getpid(), get_ident())).items():
        object.__setattr__(held, name, data)
    return held


def safety_accounting(held, global_output_root):
    """Metadata only, permitted while quiet is unknown; never reads artifacts."""
    require(type(held) is HeldContext and held.creator == (os.getpid(), get_ident())
        and sha256(held.raw).hexdigest() == held.sha, 'creating-process held context required')
    root = Path(global_output_root).absolute()
    require(str(root) == held.output_root, 'global F output root required for safety accounting')
    return _output_safety(root, held.output_directories)


def _output_safety(root, expected_directories):
    root_identity = directories(root)
    require(root_identity == expected_directories, 'held global output root identity changed')
    allowed_dirs = {Path('.')}
    for name in TARGETS:
        allowed_dirs.update(Path(name).parents)
    total = entries = 0
    files = {}
    def visit(path, depth):
        nonlocal total, entries
        require(depth <= 12, 'output depth cap')
        ordinary(path, directory=True)
        with os.scandir(path) as stream:
            for item in stream:
                entries += 1
                require(entries <= 16384, 'output metadata entry cap')
                child = Path(item.path)
                info = os.lstat(child)
                require(not stat.S_ISLNK(info.st_mode) and not getattr(info, 'st_file_attributes', 0)&0x400, 'linked output')
                relative = child.relative_to(root).as_posix()
                if stat.S_ISDIR(info.st_mode):
                    require(Path(relative) in allowed_dirs, 'unexpected output directory')
                    visit(child, depth+1)
                else:
                    base = relative.removesuffix('.pending')
                    require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1 and base in TARGETS
                        and (base == relative or base.endswith('.json')), 'unexpected output file')
                    files[relative] = identity(info)
                    total += info.st_size
                    require(info.st_size <= 8*1024**2 and total <= CAPS['output_bytes'] and len(files) <= CAPS['files'],
                        'output storage cap')
    visit(root, 0)
    reserved_bytes = reserved_files = 0
    for name in RECORDS:
        present = [n for n in (name, name+'.pending') if n in files]
        require(len(present) <= 1, 'terminal final/pending conflict')
        actual = files[present[0]][2] if present else 0
        require(actual <= CAPS['record_bytes'], 'terminal record byte cap')
        reserved_bytes += CAPS['record_bytes']-actual
        reserved_files += int(not present)
    require(total+reserved_bytes <= CAPS['output_bytes'] and len(files)+reserved_files <= CAPS['files'],
        'remaining terminal reservations do not fit')
    require(directories(root) == root_identity, 'output root identity changed')
    return dict(bytes=total, files=len(files), remaining_reserved_bytes=reserved_bytes,
        remaining_reserved_files=reserved_files, metadata_entries=entries,
        safety_only=True, worker_accounting='unknown', content_read=False)


STAGE_SLOT_BYTES = 4096
STAGE_SLOTS = 16
STAGE_MAP_BYTES = STAGE_SLOT_BYTES*(STAGE_SLOTS+1)
STAGE_COMMIT = b'GRIDFRM1'
STAGE_HEADER_COMMIT = b'GRIDHDR1'
STAGE_PREFIX = 'Local\\electricity_grid_saved_F_'
STAGE_PHASES = dict(fresh=('fresh',), parent=('parent', 'fresh', 'inner_quiesce', 'inner_terminal', 'parent_compare'),
    controller=('prepare', 'parent', 'fresh', 'inner_quiesce', 'inner_terminal', 'parent_compare',
        'outer_quiesce', 'outer_terminal', 'final_check', 'final_publish'))


def _stage_spec_value(role, preset):
    require(role in STAGE_PHASES, 'unknown owner-stage role')
    phases = STAGE_PHASES[role]
    if preset is None:
        caps = tuple(float(STAGE_SECONDS[name]) for name in phases)
        total, cleanup, terminal = dict(fresh=(50., 5., 5.), parent=(125., 5., 10.), controller=(180., 5., 5.))[role]
        mode, rss, commit = 'production_descriptor_only', 1024**3, 1024**3
    else:
        require(preset in ('steady', 'deadline', 'nested', 'role_graph', 'invocation'), 'fixed ordinary owner preset required')
        require(preset != 'nested' or role == 'parent', 'nested preset requires parent role')
        require(preset != 'role_graph' or role in ('parent', 'fresh'), 'role graph preset requires bounded child role')
        require(preset != 'invocation' or role == 'controller', 'invocation preset requires controller role')
        cap = (1.2 if role == 'parent' else 1.4) if preset == 'role_graph' else dict(steady=1., deadline=.2, nested=.8, invocation=1.)[preset]
        if role == 'controller': cap = min(cap, .5)
        caps = (cap,)*len(phases)
        if preset == 'invocation': caps = (3., 1.2, 1.4, 1., .5, 1.2, 1., .5, 2., 2.)
        cleanup, terminal = 1., .5
        total = sum(caps)+cleanup+terminal
        mode, rss, commit = 'ordinary_owner_probe', 256*1024**2, 256*1024**2
    require(len(phases)+2 <= STAGE_SLOTS, 'normal and error frame reservation does not fit')
    return dict(schema='staged_saved_F_owner_descriptor_v1', authority='DRAFT_NONAUTHORITATIVE', mode=mode,
        role=role, preset=preset, phases=list(phases), phase_seconds=list(caps), total_seconds=total,
        quiesce_seconds=cleanup, terminal_seconds=terminal, rss_bytes=rss,
        process_commit_bytes=commit, job_commit_bytes=2*commit, member_handles=1024)


def stage_descriptor(role): return canonical(_stage_spec_value(role, None))


def ordinary_stage_descriptor(role='fresh', preset='steady'): return canonical(_stage_spec_value(role, preset))


def checked_stage_descriptor(raw):
    value = parse(raw)
    expected = _stage_spec_value(value.get('role'), value.get('preset')) if type(value) is dict else None
    if type(value) is dict and 'invocation_ack_sha' in value:
        ack = value['invocation_ack_sha']
        require(value.get('role') == 'controller' and value.get('preset') == 'invocation'
            and type(ack) is str and len(ack) == 64 and all(c in '0123456789abcdef' for c in ack), 'invocation ACK descriptor domain')
        expected['invocation_ack_sha'] = ack
    require(type(value) is dict and value == expected,
        'owner-stage descriptor differs')
    require(canonical(value) == canonical(expected), 'owner-stage scalar domains differ')
    return value


def _bounded_stage_error_image(value, depth):
    if type(value) is not dict or depth <= 0: return None
    result = {key: str(value[key])[:limit] for key, limit in (('type', 64), ('message', 256), ('kind', 64),
        ('phase', 64), ('expected_sha', 64), ('target', 256), ('layer', 32)) if key in value}
    if 'may_have_published' in value: result['may_have_published'] = value['may_have_published']
    for key in ('primary', 'cause', 'context', 'construction_primary', 'channel_cleanup', 'role_primary'):
        if value.get(key) is not None: result[key] = _bounded_stage_error_image(value[key], depth-1)
    if type(value.get('cleanup_errors')) is list:
        result['cleanup_errors'] = [_bounded_stage_error_image(item, depth-1) for item in value['cleanup_errors'][:4]]
    return result


def _stage_error(error, *, _depth=3, _seen=frozenset()):
    try: kind = type(error).__name__[:64]
    except BaseException: kind = 'Exception'
    try: message = str(error)
    except BaseException: message = '[message unavailable]'
    result = dict(type=kind, message=message[:256])
    if id(error) in _seen:
        result['chain_cycle'] = True; return result
    if isinstance(error, StageChannelError):
        result.update(kind=error.kind[:64], primary=_bounded_stage_error_image(error.primary, 3))
    publication_type = globals().get('RolePublicationUnresolved')
    if publication_type is not None and isinstance(error, publication_type):
        result.update(phase=error.phase, expected_sha=error.expected_sha, may_have_published=error.may_have_published,
            target=error.target[:256], primary=_bounded_stage_error_image(error.primary_error, 3))
    construction_type = globals().get('StageConstructionUnresolved')
    if construction_type is not None and isinstance(error, construction_type):
        result['construction_primary'] = _bounded_stage_error_image(error.primary_error, 3)
        result['cleanup_errors'] = [_bounded_stage_error_image(item, 3) for item in error.cleanup_errors[:4]]
    channel_type = globals().get('StageChannelConstructionUnresolved')
    if channel_type is not None and isinstance(error, channel_type): result['channel_cleanup'] = _bounded_stage_error_image(error.cleanup_error, 3)
    execution_types = tuple(globals()[name] for name in ('RoleExecutionUnresolved', 'OwnedStageCloseUnresolved') if name in globals())
    if _depth > 0 and execution_types and isinstance(error, execution_types):
        details = []
        for index, item in enumerate(error.cleanup_errors[:4]):
            layer, secondary = item if type(item) is tuple and len(item) == 2 else ('cleanup_'+str(index), item)
            details.append(dict(layer=layer, **_stage_error(secondary, _depth=_depth-1, _seen=_seen|{id(error)})))
        result['cleanup_errors'] = details
        if isinstance(error, globals().get('RoleExecutionUnresolved', ())):
            result['role_primary'] = _stage_error(error.primary, _depth=_depth-1, _seen=_seen|{id(error)})
    if _depth > 0:
        seen = _seen|{id(error)}
        for key, related in (('cause', error.__cause__), ('context', error.__context__)):
            if related is not None:
                result[key] = _stage_error(related, _depth=_depth-1, _seen=seen)
    return result


class StageChannelError(RuntimeError):
    def __init__(self, kind, message, primary=None):
        self.kind, self.primary = kind, None if primary is None else _stage_error(primary)
        super().__init__(kind+': '+message[:256])


class StageChannelConstructionUnresolved(StageChannelError):
    def __init__(self, channel, primary, cleanup, kind):
        self.channel = channel
        self.cleanup_error = _stage_error(cleanup)
        super().__init__(kind, 'partial channel retained for creating-thread cleanup', primary)

    def __reduce__(self): raise TypeError('partial live stage channel cannot be serialized')


def _stage_api():
    require(os.name == 'nt', 'Windows retained-owner protocol required')
    api = C.WinDLL('kernel32', use_last_error=True)
    definitions = {
        'CreateFileMappingW': ([W.HANDLE, C.c_void_p, W.DWORD, W.DWORD, W.DWORD, W.LPCWSTR], W.HANDLE),
        'OpenFileMappingW': ([W.DWORD, W.BOOL, W.LPCWSTR], W.HANDLE),
        'MapViewOfFile': ([W.HANDLE, W.DWORD, W.DWORD, W.DWORD, C.c_size_t], C.c_void_p),
        'UnmapViewOfFile': ([C.c_void_p], W.BOOL),
        'CreateMutexW': ([C.c_void_p, W.BOOL, W.LPCWSTR], W.HANDLE),
        'OpenMutexW': ([W.DWORD, W.BOOL, W.LPCWSTR], W.HANDLE),
        'WaitForSingleObject': ([W.HANDLE, W.DWORD], W.DWORD),
        'ReleaseMutex': ([W.HANDLE], W.BOOL), 'CloseHandle': ([W.HANDLE], W.BOOL),
        'GetHandleInformation': ([W.HANDLE, C.POINTER(W.DWORD)], W.BOOL),
        'GetCurrentProcess': ([], W.HANDLE),
        'GetProcessTimes': ([W.HANDLE]+[C.POINTER(W.FILETIME)]*4, W.BOOL),
    }
    for name, (args, result) in definitions.items():
        function = getattr(api, name); function.argtypes, function.restype = args, result
    return api


def _native(value):
    if not value: raise C.WinError(C.get_last_error())
    return value


def _own_process_identity(api):
    created, ended, kernel, user = (W.FILETIME() for _ in range(4))
    _native(api.GetProcessTimes(api.GetCurrentProcess(), C.byref(created), C.byref(ended), C.byref(kernel), C.byref(user)))
    return os.getpid(), created.dwLowDateTime | created.dwHighDateTime << 32


def _stage_slot(raw, marker):
    require(type(raw) is bytes and len(raw) <= STAGE_SLOT_BYTES-44, 'whole slot byte limit')
    return struct.pack('<I', len(raw))+raw+b'\0'*(STAGE_SLOT_BYTES-44-len(raw))+sha256(raw).digest()+marker


def _stage_decode(slot, marker):
    if slot[-8:] != marker: return None
    length = struct.unpack('<I', slot[:4])[0]
    if not 0 < length <= STAGE_SLOT_BYTES-44: return None
    raw = slot[4:4+length]
    if slot[4+length:-40] != b'\0'*(STAGE_SLOT_BYTES-44-length) or sha256(raw).digest() != slot[-40:-8]: return None
    return raw


class StageChannel:
    """Single-writer fixed slots; progress/corruption detection, never authority."""
    def __init__(self): raise TypeError('use create or attach')

    @classmethod
    def _open(cls, name, nonce, context_sha, descriptor, create):
        require(type(name) is str and name.startswith(STAGE_PREFIX) and len(name) == len(STAGE_PREFIX)+64
            and all(c in '0123456789abcdef' for c in name[len(STAGE_PREFIX):]), 'fixed Local stage tag required')
        require(type(nonce) is str and len(nonce) == 64 and all(c in '0123456789abcdef' for c in nonce), 'stage nonce differs')
        require(type(context_sha) is str and len(context_sha) == 64 and all(c in '0123456789abcdef' for c in context_sha), 'stage context SHA differs')
        checked_stage_descriptor(descriptor)
        obj = object.__new__(cls)
        obj._api = _stage_api(); obj._map = obj._mutex = obj._view = None
        obj._creator = os.getpid(), get_ident(); obj._reader = create; obj._in_lock = False
        obj._poison = None; obj._header = None; obj._history = []; obj._terminal = False
        obj.pending_data = False
        obj.name, obj.nonce, obj.context_sha, obj.descriptor = name, nonce, context_sha, descriptor
        obj._binding_inputs = name, nonce, context_sha, descriptor
        try:
            if create:
                C.set_last_error(0)
                obj._map = _native(obj._api.CreateFileMappingW(C.c_void_p(-1), None, 4, 0, STAGE_MAP_BYTES, name))
                mapping_error = C.get_last_error()
                if mapping_error == 183: raise StageChannelError('collision', 'mapping already exists')
                C.set_last_error(0)
                obj._mutex = _native(obj._api.CreateMutexW(None, False, name+'_mutex'))
                mutex_error = C.get_last_error()
                if mutex_error == 183: raise StageChannelError('collision', 'mutex already exists')
            else:
                obj._map = _native(obj._api.OpenFileMappingW(6, False, name))
                obj._mutex = _native(obj._api.OpenMutexW(0x100001, False, name+'_mutex'))
            for handle in (obj._map, obj._mutex):
                flags = W.DWORD(); _native(obj._api.GetHandleInformation(handle, C.byref(flags)))
                require(not flags.value&1, 'stage handles must not be inherited')
            obj._view = _native(obj._api.MapViewOfFile(obj._map, 6, 0, 0, STAGE_MAP_BYTES))
            if create: require(C.string_at(obj._view, STAGE_MAP_BYTES) == b'\0'*STAGE_MAP_BYTES, 'new mapping not zero')
            return obj
        except BaseException as primary:
            try: obj.close()
            except BaseException as cleanup: raise StageChannelConstructionUnresolved(obj, primary, cleanup, 'construction_cleanup') from primary
            raise

    @classmethod
    def create(cls, context_sha, descriptor, *, name=None, nonce=None):
        return cls._open(name or STAGE_PREFIX+secrets.token_hex(32), nonce or secrets.token_hex(32), context_sha, descriptor, True)

    @classmethod
    def attach(cls, name, nonce, context_sha, descriptor):
        obj = cls._open(name, nonce, context_sha, descriptor, False)
        try:
            with obj._locked(100) as acquired:
                require(acquired, 'writer could not acquire initial stage mutex')
                initial = C.string_at(obj._view, STAGE_MAP_BYTES); header = initial[:STAGE_SLOT_BYTES]
                require(initial[STAGE_SLOT_BYTES:] == b'\0'*(STAGE_MAP_BYTES-STAGE_SLOT_BYTES), 'writer episode already contains frames')
            raw = _stage_decode(header, STAGE_HEADER_COMMIT)
            require(raw is not None, 'stage header not committed')
            value = parse(raw)
            obj._validate_header(value)
            require(tuple(value[n] for n in ('owner_pid', 'owner_creation_filetime')) == _own_process_identity(obj._api), 'wrong stage writer process')
            obj._header = header
            return obj
        except BaseException as primary:
            try: obj.close()
            except BaseException as cleanup: raise StageChannelConstructionUnresolved(obj, primary, cleanup, 'attach_cleanup') from primary
            raise

    @property
    def spec(self): return checked_stage_descriptor(self.descriptor)

    def _live(self, *, poisoned=False):
        require(self._creator == (os.getpid(), get_ident()), 'creating PID/thread required for stage channel')
        require(self._view is not None and self._map is not None and self._mutex is not None, 'closed stage channel')
        require((self.name, self.nonce, self.context_sha, self.descriptor) == self._binding_inputs, 'frozen channel inputs changed')
        if self._poison is not None and not poisoned: raise StageChannelError(self._poison, 'stage channel remains unresolved')

    @contextmanager
    def _locked(self, milliseconds):
        self._live(); require(not self._in_lock, 'recursive stage lock forbidden')
        result = self._api.WaitForSingleObject(self._mutex, milliseconds)
        if result == 258:
            yield False; return
        if result not in (0, 128):
            self._poison = 'mutex_wait'; raise StageChannelError('mutex_wait', str(C.WinError(C.get_last_error())))
        self._in_lock = True
        primary = None
        try:
            if result == 128:
                self._poison = 'abandoned'; raise StageChannelError('abandoned', 'writer mutex abandoned')
            yield True
        except BaseException as error:
            primary = error; raise
        finally:
            self._in_lock = False
            if not self._api.ReleaseMutex(self._mutex):
                self._poison = 'mutex_release'
                raise StageChannelError('mutex_release', str(C.WinError(C.get_last_error())), primary) from primary

    def _validate_header(self, value):
        keys(value, 'schema context_sha nonce descriptor owner_pid owner_creation_filetime slots slot_bytes')
        require(value['schema'] == 'staged_saved_F_memory_header_v1' and value['context_sha'] == self.context_sha
            and value['nonce'] == self.nonce and canonical(value['descriptor']) == self.descriptor
            and type(value['slots']) is int and value['slots'] == STAGE_SLOTS
            and type(value['slot_bytes']) is int and value['slot_bytes'] == STAGE_SLOT_BYTES, 'stage header binding differs')
        require(type(value['owner_pid']) is int and 0 < value['owner_pid'] < 2**32
            and type(value['owner_creation_filetime']) is int and 0 < value['owner_creation_filetime'] < 2**64, 'stage owner identity domain')

    def bind_owner(self, owner):
        self._live(); require(self._reader and self._header is None, 'stage owner already bound')
        owner._live_owner(); require(not owner._released, 'suspended owner required')
        value = dict(schema='staged_saved_F_memory_header_v1', context_sha=self.context_sha, nonce=self.nonce,
            descriptor=self.spec, owner_pid=owner.pid, owner_creation_filetime=owner.creation_filetime,
            slots=STAGE_SLOTS, slot_bytes=STAGE_SLOT_BYTES)
        self._validate_header(value); header = _stage_slot(canonical(value), STAGE_HEADER_COMMIT)
        with self._locked(0) as acquired:
            require(acquired and C.string_at(self._view, STAGE_MAP_BYTES) == b'\0'*STAGE_MAP_BYTES, 'new stage map changed before bind')
            C.memmove(self._view, header[:-8], len(header)-8)
            C.memmove(self._view+STAGE_SLOT_BYTES-8, STAGE_HEADER_COMMIT, 8)
        self._header = header

    def _snapshot(self, milliseconds):
        self._live(); require(self._header is not None, 'stage owner header missing')
        with self._locked(milliseconds) as acquired:
            if not acquired: return None
            first = C.string_at(self._view, STAGE_MAP_BYTES); second = C.string_at(self._view, STAGE_MAP_BYTES)
        require(first == second, 'stage map changed under mutex')
        if first[:STAGE_SLOT_BYTES] != self._header:
            self._poison = 'header'; raise StageChannelError('header', 'frozen header changed')
        return first

    def read_available(self):
        try:
            require(self._reader, 'stage observer endpoint required')
            image = self._snapshot(0)
            if image is None: return None
            frames = []
            self.pending_data = False
            for index in range(STAGE_SLOTS):
                slot = image[(index+1)*STAGE_SLOT_BYTES:(index+2)*STAGE_SLOT_BYTES]
                if index < len(self._history) and slot != self._history[index]: raise StageChannelError('history', 'accepted stage slot changed')
                raw = _stage_decode(slot, STAGE_COMMIT)
                if raw is None:
                    self.pending_data = image[(index+1)*STAGE_SLOT_BYTES:] != b'\0'*(STAGE_MAP_BYTES-(index+1)*STAGE_SLOT_BYTES)
                    break
                value = parse(raw)
                keys(value, 'schema sequence phase binding_sha previous_sha producer_pid producer_creation_filetime stamp error_code')
                binding = parse(_stage_decode(self._header, STAGE_HEADER_COMMIT))
                previous = sha256(_stage_decode(self._history[index-1], STAGE_COMMIT)).hexdigest() if index else '0'*64
                require(value['schema'] == 'staged_saved_F_memory_frame_v1' and type(value['sequence']) is int
                    and value['sequence'] == index and value['binding_sha'] == sha256(self._header).hexdigest()
                    and value['previous_sha'] == previous
                    and (value['producer_pid'], value['producer_creation_filetime']) == (binding['owner_pid'], binding['owner_creation_filetime'])
                    and type(value['stamp']) is float and math.isfinite(value['stamp']) and value['stamp'] > 0, 'stage frame binding differs')
                require((value['phase'] == 'error' and type(value['error_code']) is str and 0 < len(value['error_code']) <= 64)
                    or (value['phase'] != 'error' and value['error_code'] is None), 'stage error domain differs')
                if index >= len(self._history): self._history.append(slot)
                frames.append(value)
            return frames
        except BaseException as error:
            if not isinstance(error, (KeyboardInterrupt, SystemExit)) and self._poison is None: self._poison = 'protocol'
            raise

    def enter(self, phase):
        return self._publish(phase, None)

    def fail(self, error_code):
        require(type(error_code) is str and 0 < len(error_code) <= 64, 'bounded stage error code required')
        return self._publish('error', error_code)

    def _publish(self, phase, error_code):
        try: return self._publish_once(phase, error_code)
        except BaseException as error:
            if self._poison is None: self._poison = 'writer'
            raise

    def _publish_once(self, phase, error_code):
        self._live(); require(not self._reader and not self._terminal, 'single live stage writer required')
        index = len(self._history)
        phases = self.spec['phases']
        expected = phases[index] if index < len(phases) else 'terminal'
        require(index < STAGE_SLOTS and (phase == expected or phase == 'error'), 'strict next phase required')
        binding = parse(_stage_decode(self._header, STAGE_HEADER_COMMIT))
        previous = sha256(_stage_decode(self._history[-1], STAGE_COMMIT)).hexdigest() if self._history else '0'*64
        raw = canonical(dict(schema='staged_saved_F_memory_frame_v1', sequence=index, phase=phase,
            binding_sha=sha256(self._header).hexdigest(), previous_sha=previous,
            producer_pid=binding['owner_pid'], producer_creation_filetime=binding['owner_creation_filetime'],
            stamp=time.monotonic(), error_code=error_code))
        slot = _stage_slot(raw, STAGE_COMMIT)
        with self._locked(100) as acquired:
            require(acquired, 'writer stage mutex busy')
            current = C.string_at(self._view, STAGE_MAP_BYTES)
            require(current[:STAGE_SLOT_BYTES] == self._header, 'writer frozen header changed')
            for n, old in enumerate(self._history):
                require(current[(n+1)*STAGE_SLOT_BYTES:(n+2)*STAGE_SLOT_BYTES] == old, 'writer old slot changed')
            offset = (index+1)*STAGE_SLOT_BYTES
            require(current[offset:offset+STAGE_SLOT_BYTES] == b'\0'*STAGE_SLOT_BYTES, 'next stage slot already used')
            C.memmove(self._view+offset, slot[:-8], len(slot)-8)
            C.memmove(self._view+offset+STAGE_SLOT_BYTES-8, STAGE_COMMIT, 8)
        self._history.append(slot); self._terminal = phase in ('terminal', 'error')

    def close(self):
        require(self._creator == (os.getpid(), get_ident()), 'creating PID/thread required for stage close')
        errors = []
        if self._view is not None:
            if self._api.UnmapViewOfFile(self._view): self._view = None
            else: errors.append(C.WinError(C.get_last_error()))
        for name in ('_mutex', '_map'):
            value = getattr(self, name)
            if value is not None:
                if self._api.CloseHandle(value): setattr(self, name, None)
                else: errors.append(C.WinError(C.get_last_error()))
        if errors: raise StageChannelError('close', str(_stage_error(errors[0])))

    def __reduce__(self): raise TypeError('live stage channel cannot be serialized')


class StageConstructionUnresolved(RuntimeError):
    def __init__(self, owner, primary, cleanup):
        self.owner = owner
        self.primary_error = _stage_error(primary)
        self.cleanup_errors = cleanup
        super().__init__('ordinary stage construction unresolved')

    def __reduce__(self): raise TypeError('live stage cleanup capability cannot be serialized')


@dataclass(frozen=True, init=False)
class OwnedStage:
    """Creating-thread probe owner capability; never a production lease."""
    owner: object
    channel: StageChannel
    startup: bytes
    created_at: float
    real_owner: bool
    _creator: tuple
    _binding: tuple
    _attempted: bool
    last_observation: object
    last_image: object
    observation_commit: object
    domain: str
    launch_binding: object
    _domain_binding: tuple

    def __init__(self, owner, channel, startup, created, real_owner, *, domain='ordinary', launch_binding=None):
        require(type(startup) is bytes and type(created) is float and math.isfinite(created)
            and type(real_owner) is bool, 'typed retained owner binding required')
        binding = (id(owner), id(channel), sha256(startup).hexdigest(), created, real_owner,
            owner.pid, owner.creation_filetime, channel._binding_inputs)
        for name, value in dict(owner=owner, channel=channel, startup=startup, created_at=created,
                real_owner=real_owner, _creator=(os.getpid(), get_ident()), _binding=binding,
                _attempted=False, last_observation=None, last_image=None, observation_commit=None,
                domain=domain, launch_binding=launch_binding, _domain_binding=(domain, id(launch_binding))).items():
            object.__setattr__(self, name, value)
        object.__setattr__(self, '_saved_error_retention_unresolved', ())

    def _entry(self):
        require(self._creator == (os.getpid(), get_ident()), 'creating PID/thread required for stage owner')
        require((self.domain, id(self.launch_binding)) == self._domain_binding, 'held stage domain changed')
        if self.domain == 'ordinary': require(self.launch_binding is None, 'ordinary owner cannot carry saved binding')
        else:
            require(self.domain == 'saved' and type(self.launch_binding) is SavedStageBinding, 'exact saved stage binding required')
            self.launch_binding.entry(self)
        require((id(self.owner), id(self.channel)) == self._binding[:2], 'held owner/channel binding changed')
        require(type(self.startup) is bytes and sha256(self.startup).hexdigest() == self._binding[2]
            and type(self.created_at) is float and self.created_at == self._binding[3]
            and self.real_owner is self._binding[4]
            and (self.owner.pid, self.owner.creation_filetime, self.channel._binding_inputs) == self._binding[5:],
            'held startup/clock/evidence binding changed')
        if self.observation_commit is not None:
            current = canonical(self.last_observation)
            require(self._attempted and (len(current), sha256(current).hexdigest()) == self.observation_commit
                and (self.last_image is None or (len(self.last_image), sha256(self.last_image).hexdigest()) == self.observation_commit),
                'held terminal observation changed')

    def close(self):
        self._entry()
        errors = []
        try: self.owner.close()
        except BaseException as error: errors.append(('owner_close', error))
        try: self.channel.close()
        except BaseException as error: errors.append(('channel_close', error))
        if errors: raise OwnedStageCloseUnresolved(self, errors)

    def __reduce__(self): raise TypeError('live stage owner cannot be serialized')


class OwnedStageCloseUnresolved(StageChannelError):
    def __init__(self, stage, errors):
        self.stage, self.cleanup_errors = stage, tuple(errors)
        super().__init__('owner_close', 'owned stage resources remain unresolved', errors[0][1])

    def __reduce__(self): raise TypeError('unresolved live stage close cannot be serialized')


def _stop_owned_job(owner):
    """Private-ABI bridge: request kill before quiesce's member enumeration."""
    owner._live_owner()
    _native(owner._k.TerminateJobObject(owner._job, 0xE0F1))


def _ordinary_probe_argv(probe_id, channel):
    """Closed, source-bound tiny programs; caller code and paths are rejected."""
    probes = {
        'normal': ('fresh', 'steady', "w.enter('fresh'); time.sleep(.15); w.enter('terminal'); w.close()"),
        'no_first_frame': ('fresh', 'deadline', 'time.sleep(20)'),
        'hang': ('fresh', 'deadline', "w.enter('fresh'); time.sleep(20)"),
        'terminal_hang': ('fresh', 'deadline', "w.enter('fresh'); w.enter('terminal'); time.sleep(20)"),
        'terminal_exit_hang': ('fresh', 'steady', "w.enter('fresh'); w.enter('terminal'); time.sleep(20)"),
        'late_terminal_hang': ('fresh', 'steady', "w.enter('fresh'); time.sleep(.75); w.enter('terminal'); time.sleep(20)"),
        'missing_terminal': ('fresh', 'steady', "w.enter('fresh'); time.sleep(.1); w.close()"),
        'exit_nonzero': ('fresh', 'steady', "w.enter('fresh'); time.sleep(.1); w.enter('terminal'); os._exit(7)"),
        'reported_error': ('fresh', 'steady', "w.enter('fresh'); time.sleep(.1); w.fail('probe_error'); w.close()"),
        'nested_quiet': ('parent', 'nested', "from src.staged_rts24_process_guard_v1 import OwnedChild; "
            "w.enter('parent'); child=OwnedChild([str(d.EXE),'-B','-s','-c','import time; time.sleep(20)'],"
            "cwd=d.ROOT,max_process_commit_bytes=128*1024**2,max_job_commit_bytes=256*1024**2,environment=d.environment()); "
            "child.release(); w.enter('fresh'); time.sleep(.3); w.enter('inner_quiesce'); child.quiesce(max_seconds=1); "
            "w.enter('inner_terminal'); child.close(); w.enter('parent_compare'); w.enter('terminal'); w.close()"),
        'root_exited_with_descendants': ('parent', 'nested', "import subprocess; w.enter('parent'); "
            "child=subprocess.Popen([str(d.EXE),'-B','-s','-c','import time; time.sleep(20)']); "
            "w.enter('fresh'); time.sleep(.3); w.enter('inner_quiesce'); w.enter('inner_terminal'); "
            "w.enter('parent_compare'); w.enter('terminal'); os._exit(0)"),
    }
    require(type(probe_id) is str and probe_id in probes, 'closed ordinary probe identifier required')
    role, preset, body = probes[probe_id]
    require(channel.descriptor == ordinary_stage_descriptor(role, preset), 'probe and fixed descriptor differ')
    preamble = ('import time,os,sys; from experiments import staged_rts24_saved_fresh_adoption_v1 as d; '
        f'w=d.StageChannel.attach({channel.name!r},{channel.nonce!r},{channel.context_sha!r},{channel.descriptor!r}); ')
    return [str(EXE), '-B', '-s', '-c', preamble+body]


def create_probe_owner(probe_id, channel):
    return _create_probe_owner(probe_id, channel)


def _create_probe_owner(probe_id, channel, *, owner_factory=None):
    """Private owner injection is logic-only; public real probes use a closed ID."""
    channel._live()
    require(channel._reader and channel._header is None, 'unbound observer endpoint required')
    spec = channel.spec
    require(spec['mode'] == 'ordinary_owner_probe', 'production stage launch remains disabled')
    args = _ordinary_probe_argv(probe_id, channel)
    return _construct_stage_owner(args, channel, probe_id, owner_factory=owner_factory)


def _construct_stage_owner(args, channel, label, *, owner_factory=None, started=None):
    channel._live()
    require(channel._reader and channel._header is None, 'unbound observer endpoint required')
    spec = channel.spec
    require(spec['mode'] == 'ordinary_owner_probe', 'production stage launch remains disabled')
    frozen_environment = environment()
    prospective = dict(schema='staged_saved_F_probe_CreateProcess_inputs_v1', authority='DRAFT_NONAUTHORITATIVE',
        scope='ordinary_owner_probe_only', probe_id=label, creator_pid=os.getpid(), argv=args, command_line=subprocess.list2cmdline(args),
        cwd=str(ROOT), environment_sha=digest(frozen_environment), context_sha=channel.context_sha,
        descriptor_sha=sha256(channel.descriptor).hexdigest(), channel_name=channel.name,
        owner_pid=2**32-1, owner_creation_filetime=2**64-1,
        actual_os_commandline_independently_verified=False)
    require(len(canonical(prospective)) <= 16384, 'bounded probe startup record required')
    from src.staged_rts24_process_guard_v1 import OwnedChild
    factory = _stage_owner_factory(OwnedChild, owner_factory, label)
    # Allocate before __init__ so a partial constructor's actual handles remain reachable.
    owner = object.__new__(factory)
    if started is None: started = time.monotonic()
    require(type(started) is float and math.isfinite(started) and 0 < started <= time.monotonic(), 'actual reservation start required')
    try:
        factory.__init__(owner, args, cwd=ROOT, max_process_commit_bytes=spec['process_commit_bytes'],
            max_job_commit_bytes=spec['job_commit_bytes'], environment=frozen_environment)
        channel.bind_owner(owner)
        prospective.update(owner_pid=owner.pid, owner_creation_filetime=owner.creation_filetime)
        raw = canonical(prospective)
        require(len(raw) <= 16384, 'probe startup bytes exceed cap')
        return OwnedStage(owner, channel, raw, started, owner_factory is None)
    except BaseException as primary:
        cleanup = []
        if getattr(owner, '_job', None) is not None:
            try: _stop_owned_job(owner)
            except BaseException as error: cleanup.append(dict(layer='termination', **_stage_error(error)))
            try: owner.quiesce(max_seconds=1)
            except BaseException as error: cleanup.append(dict(layer='quiesce', **_stage_error(error)))
        try: owner.close()
        except BaseException as error: cleanup.append(dict(layer='close', **_stage_error(error)))
        raise StageConstructionUnresolved(owner, primary, cleanup) from primary


def _stage_complete_witness(value, owner_pid, owner_creation):
    if type(value) is not dict or set(value) != {'observed_unique_member_handles', 'all_handles_signaled', 'member_identities',
            'total_processes', 'final_pids', 'active_processes', 'complete_inventory'}: return False
    members = value['member_identities']
    if type(members) is not list or not 1 <= len(members) <= 1024: return False
    identities = []
    for item in members:
        if type(item) is not dict or set(item) != {'pid', 'creation_filetime'}: return False
        if type(item['pid']) is not int or not 0 < item['pid'] < 2**32: return False
        if type(item['creation_filetime']) is not int or not 0 < item['creation_filetime'] < 2**64: return False
        identities.append((item['pid'], item['creation_filetime']))
    return (len(set(identities)) == len(identities) and (owner_pid, owner_creation) in identities
        and value['all_handles_signaled'] is value['complete_inventory'] is True
        and type(value['active_processes']) is int and value['active_processes'] == 0 and value['final_pids'] == []
        and type(value['total_processes']) is type(value['observed_unique_member_handles']) is int
        and value['total_processes'] == value['observed_unique_member_handles'] == len(identities))


def watch_probe_stage(held, *, absolute_deadline=None):
    require(type(held) is OwnedStage, 'ordinary probe owner required')
    held._entry()
    require(held.channel.spec['mode'] == 'ordinary_owner_probe', 'ordinary probe owner required')
    return _watch_stage(held, absolute_deadline=absolute_deadline)


def _watch_stage(held, *, absolute_deadline=None, relay=None, invocation=None, initial_phase_deadline=None):
    require(type(held) is OwnedStage, 'actual creating-thread probe owner required')
    held._entry()
    require(held.domain == 'ordinary' and held.channel.spec['mode'] == 'ordinary_owner_probe', 'production stage observation remains disabled')
    return _watch_owned_stage(held, absolute_deadline=absolute_deadline, relay=relay,
        invocation=invocation, initial_phase_deadline=initial_phase_deadline)


def _watch_owned_stage(held, *, absolute_deadline=None, relay=None, invocation=None, initial_phase_deadline=None):
    """Active loop: kernel queries and fixed RAM only; no artifact/source I/O."""
    require(type(held) is OwnedStage, 'actual creating-thread probe owner required')
    held._entry(); require(not held._attempted, 'stage observation already attempted')
    owner, channel = held.owner, held.channel
    channel._live()
    spec = channel.spec
    saved = held.domain == 'saved'
    if saved:
        require(spec['mode'] == 'production_descriptor_only' and channel.descriptor == stage_descriptor(spec['role'])
            and invocation is None and initial_phase_deadline is None
            and relay is held.launch_binding.upstream and absolute_deadline == held.launch_binding.deadline,
            'fixed saved stage supervision inputs required')
    else: require(spec['mode'] == 'ordinary_owner_probe', 'production stage observation remains disabled')
    def retain_error(layer, error):
        if saved:
            try: held.launch_binding.retain_error(layer, error)
            except BaseException as retention_error:
                pending = held._saved_error_retention_unresolved
                if len(pending) < 9:
                    object.__setattr__(held, '_saved_error_retention_unresolved', pending+((layer, error, retention_error),))
    relay_phases = None
    invocation_bridge = type(relay) is globals().get('InvocationRelay')
    if invocation_bridge:
        relay.check(held)
    elif relay is not None:
        require(type(relay) is StageChannel, 'actual stage writer relay required')
        relay._live()
        pair = spec['role'], relay.spec['role']
        require(not relay._reader and relay.context_sha == channel.context_sha and relay.descriptor != channel.descriptor
            and relay.spec['mode'] == spec['mode'] and pair in (('fresh', 'parent'), ('parent', 'controller')),
            'fixed same-context role relay required')
        relay_phases = ('inner_quiesce', 'inner_terminal') if pair[0] == 'fresh' else ('outer_quiesce', 'outer_terminal')
    accounting_start = held.created_at
    if invocation is not None:
        require(type(invocation) is ArmedInvocation, 'actual armed external invocation required')
        invocation.check(active=True)
        require(invocation.stage is held, 'armed owner differs')
        accounting_start = invocation.started
    total_deadline = accounting_start+spec['total_seconds']
    if absolute_deadline is not None:
        require(type(absolute_deadline) is float and math.isfinite(absolute_deadline), 'finite earlier stage deadline required')
        total_deadline = min(total_deadline, absolute_deadline)
    active_deadline = total_deadline-spec['quiesce_seconds']-spec['terminal_seconds']
    phases, caps = spec['phases'], spec['phase_seconds']
    poll_interval = .01
    start = time.monotonic(); phase_entered = start; phase_index = 0; seen = 0
    phase_deadline = min(start+caps[0], active_deadline)
    if initial_phase_deadline is not None:
        require(type(initial_phase_deadline) is float and math.isfinite(initial_phase_deadline), 'finite earlier initial phase deadline required')
        phase_deadline = min(phase_deadline, initial_phase_deadline)
    if invocation is not None: phase_deadline = min(phase_deadline, invocation.started+caps[0])
    primary = monitor_error = termination_error = quiesce_error = close_error = channel_error = channel_close_error = final_bookend_error = relay_error = None
    exit_code = None; terminal = False; released = False; kill_requested = False; kill_succeeded = False
    samples = peak_rss = peak_commit = 0
    terminal_rss = None
    terminal_accepted = terminal_exit_deadline = None
    terminal_exit_limiting_deadline = None
    root_exit_observed_at = termination_requested_at = quiesce_completed_at = None
    phase_entries = [dict(phase=phases[0], observer_entered=start)]
    frames = []; terminal_system_helpers = []

    def termination(reason):
        nonlocal primary, termination_error, kill_requested, kill_succeeded, termination_requested_at
        primary = primary or reason
        if kill_requested: return
        kill_requested = True
        termination_requested_at = time.monotonic()
        try: _stop_owned_job(owner); kill_succeeded = True
        except BaseException as error:
            retain_error('termination', error); termination_error = _stage_error(error)

    def sample():
        nonlocal samples, peak_rss, peak_commit, terminal_rss
        data = owner.sample()
        if exit_code is None:
            samples += 1; peak_rss = max(peak_rss, data['rss_bytes'])
        else: terminal_rss = data['rss_bytes']
        peak_commit = max(peak_commit, data['peak_job_commit_bytes'])
        if invocation is not None:
            _invocation_poll(invocation, data)
        if data['rss_bytes'] > spec['rss_bytes']: termination('rss_limit' if exit_code is None else 'terminal_rss_limit')
        elif peak_commit > spec['job_commit_bytes']: termination('commit_limit')
        return data

    try:
        object.__setattr__(held, '_attempted', True)
        owner._live_owner()
        require(owner._released is (invocation is not None), 'unreleased owner or actual armed invocation required for phase clock')
        if start >= active_deadline: termination('construction_or_total_budget')
        else:
            released = True
            if invocation is None: owner.release()
            while primary is None:
                now = time.monotonic()
                if terminal_exit_deadline is not None and now >= terminal_exit_deadline: termination('terminal_exit_limit'); break
                if now >= active_deadline: termination('total_active_limit'); break
                if now >= phase_deadline: termination('phase_limit'); break
                exit_code = owner.poll()
                if exit_code is not None and root_exit_observed_at is None: root_exit_observed_at = time.monotonic()
                data = sample()
                if primary is not None: break
                new_frames = channel.read_available()
                if new_frames is not None:
                    frames = new_frames
                    for frame in frames[seen:]:
                        now = time.monotonic()
                        if now >= min(active_deadline, phase_deadline): termination('phase_limit'); break
                        phase = frame['phase']
                        if phase == 'error': termination('child_reported_error'); break
                        if seen < len(phases):
                            if phase != phases[seen]: termination('phase_protocol'); break
                            if seen:
                                phase_index = seen; phase_entered = now
                                phase_deadline = min(now+caps[seen], active_deadline)
                                phase_entries.append(dict(phase=phase, observer_entered=now))
                                if relay is not None:
                                    try: relay.enter(phase)
                                    except BaseException as error:
                                        retain_error('relay_active', error); relay_error = _stage_error(error); raise
                        elif seen == len(phases) and phase == 'terminal':
                            terminal = True; terminal_accepted = now
                            candidates = dict(active=active_deadline, phase=phase_deadline, exit_cap=now+spec['terminal_seconds'])
                            terminal_exit_limiting_deadline = min(candidates, key=candidates.get)
                            terminal_exit_deadline = candidates[terminal_exit_limiting_deadline]
                        else: termination('phase_protocol'); break
                        seen += 1
                if primary is not None: break
                if exit_code is not None:
                    # A root exit never substitutes for a final descendant sample.
                    last = sample()
                    remaining_pids = (set(data['pids'])|set(last['pids']))-{owner.pid}
                    helpers = None
                    if remaining_pids and held.real_owner and spec['preset'] in ('role_graph', 'invocation'):
                        helpers = _terminal_console_helpers(owner, remaining_pids)
                    if remaining_pids and helpers is None: termination('root_exited_with_descendants')
                    elif exit_code != 0: termination('child_exit_nonzero')
                    elif not terminal or seen != len(phases)+1 or channel.pending_data: termination('incomplete_terminal')
                    elif helpers is not None: terminal_system_helpers = helpers
                    break
                remaining = min(active_deadline, phase_deadline)-time.monotonic()
                if terminal_exit_deadline is not None: remaining = min(remaining, terminal_exit_deadline-time.monotonic())
                if remaining > 0: time.sleep(min(poll_interval, remaining))
    except BaseException as error:
        retain_error('monitor', error)
        if invocation is not None and invocation.active_error is None:
            object.__setattr__(invocation, 'active_error', error); invocation._commit()
        monitor_error = _stage_error(error)
        if isinstance(error, StageChannelError): channel_error = _stage_error(error)
        termination('monitor_or_channel_error')
    finally:
        if relay is not None and not invocation_bridge:
            try: relay.enter(relay_phases[0])
            except BaseException as error:
                retain_error('relay_quiesce', error)
                relay_error = relay_error or _stage_error(error); termination('relay_unknown')
        quiesce_started = time.monotonic()
        quiet = False
        try:
            remaining = min(spec['quiesce_seconds'], total_deadline-spec['terminal_seconds']-quiesce_started)
            if remaining <= 0:
                termination('quiesce_reservation_exhausted')
                # Cleanup still attempted, but cannot turn an over-budget run into success.
                remaining = spec['quiesce_seconds']
            owner.quiesce(max_seconds=remaining)
            quiesce_completed_at = time.monotonic()
            exit_code = owner.poll()
            if exit_code is not None and root_exit_observed_at is None: root_exit_observed_at = time.monotonic()
            post = owner.sample(); peak_commit = max(peak_commit, post['peak_job_commit_bytes'])
            quiet = _stage_complete_witness(getattr(owner, 'quiescence_witness', None), owner.pid, owner.creation_filetime)
            if not quiet: primary = primary or 'complete_inventory_unknown'
            if peak_commit > spec['job_commit_bytes']: primary = primary or 'post_quiesce_commit_limit'
            if time.monotonic()-quiesce_started > spec['quiesce_seconds']: primary = primary or 'quiesce_budget'
        except BaseException as error:
            retain_error('quiesce', error)
            quiesce_error = _stage_error(error); primary = primary or 'quiesce_unknown'
        try:
            final = channel.read_available()
            if final is None: raise StageChannelError('busy_final', 'final channel bookend unavailable')
            if len(final) != len(frames): raise StageChannelError('late_frame', 'transcript changed after exit observation')
        except BaseException as error:
            retain_error('channel_bookend', error)
            final_bookend_error = _stage_error(error); primary = primary or 'channel_bookend_unknown'
        try: owner.close()
        except BaseException as error:
            retain_error('owner_close', error)
            close_error = _stage_error(error); quiet = False; primary = primary or 'close_unknown'
        try: channel.close()
        except BaseException as error:
            retain_error('channel_close', error)
            channel_close_error = _stage_error(error); primary = primary or 'channel_close_unknown'
        close_completed_at = time.monotonic()
        if (relay is not None and not invocation_bridge and relay_error is None and quiet
                and all(error is None for error in (quiesce_error, close_error, channel_error, final_bookend_error, channel_close_error))):
            try: relay.enter(relay_phases[1])
            except BaseException as error:
                retain_error('relay_terminal', error)
                relay_error = _stage_error(error); primary = primary or 'relay_unknown'
        closed_at = time.monotonic()
        if closed_at > total_deadline: primary = primary or 'total_budget'
        if samples == 0: primary = primary or 'rss_observation_unavailable'
    if saved and held._saved_error_retention_unresolved: primary = primary or 'saved_error_retention_unknown'
    completed = terminal and seen == len(phases)+1 and channel_error is final_bookend_error is None and not channel.pending_data
    success = primary is None and exit_code == 0 and quiet and completed and samples > 0
    startup = parse(held.startup)
    record = dict(authority='DRAFT_NONAUTHORITATIVE', scope='saved_retained_child_stage_development_only' if saved else 'ordinary_retained_owner_stage_process_only',
        owner_evidence='direct_owned_child' if held.real_owner else 'injected_unit_owner', startup=startup,
        descriptor=spec, exit_code=exit_code, primary_stop_reason=primary, monitor_error=monitor_error,
        termination_requested=kill_requested, termination_call_succeeded=kill_succeeded, termination_error=termination_error,
        quiesce_error=quiesce_error, close_error=close_error, channel_error=channel_error, final_bookend_error=final_bookend_error,
        channel_close_error=channel_close_error, quiet_witness_consistent=quiet,
        relay_error=relay_error,
        job_quiet_confirmed=quiet and held.real_owner, quiescence_witness=getattr(owner, 'quiescence_witness', None),
        stage_process_observed_successfully=success and held.real_owner, logic_path_completed=success, stage_transcript_complete=completed,
        frames_observed=seen, phases_observed=phase_entries, transcript_sha=sha256(b''.join(channel._history)).hexdigest(),
        stage_header=parse(_stage_decode(channel._header, STAGE_HEADER_COMMIT)),
        transcript_frames=[parse(_stage_decode(slot, STAGE_COMMIT)) for slot in channel._history],
        samples=samples, sampled_tree_peak_rss_bytes=peak_rss if samples else None, terminal_tree_rss_bytes=terminal_rss,
        peak_job_commit_bytes=peak_commit, release_attempted=released,
        terminal_system_helpers=terminal_system_helpers,
        construction_seconds=start-accounting_start, observation_seconds=closed_at-start,
        remaining_total_seconds=max(0., total_deadline-closed_at), total_deadline=total_deadline,
        terminal_accepted=terminal_accepted, terminal_exit_deadline=terminal_exit_deadline,
        terminal_exit_cap_seconds=spec['terminal_seconds'], terminal_exit_limiting_deadline=terminal_exit_limiting_deadline,
        root_exit_observed_at=root_exit_observed_at, termination_requested_at=termination_requested_at,
        quiesce_started_at=quiesce_started, quiesce_completed_at=quiesce_completed_at, close_attempts_finished_at=close_completed_at,
        observation_finished_at=closed_at,
        active_io_scope='kernel_and_fixed_shared_memory_only', artifact_contents_read=False,
        external_constructor_and_monitor_interrupt_bound_proved=False, terminal_publication_bound_proved=False,
        clock=dict(implementation=time.get_clock_info('monotonic').implementation,
            resolution=time.get_clock_info('monotonic').resolution), poll_interval_seconds=poll_interval,
        F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
    if saved: record['schema'] = 'staged_saved_F_saved_child_process_development_v1'
    object.__setattr__(held, 'last_observation', record)
    if len(canonical(record)) > 131072:
        record['stage_process_observed_successfully'] = False
        record['record_encoding_error'] = 'stage process record exceeds128KiB; original observation retained'
        raw = canonical(record)
        object.__setattr__(held, 'observation_commit', (len(raw), sha256(raw).hexdigest()))
        raise StageChannelError('record_byte_cap', 'original observation retained on live capability')
    object.__setattr__(held, 'last_image', canonical(record))
    object.__setattr__(held, 'observation_commit', (len(held.last_image), sha256(held.last_image).hexdigest()))
    return record


ROLE_PROBE_SCHEMA = 'staged_saved_F_ordinary_role_graph_v1'
ROLE_PROBE_SCOPE = 'ordinary_role_algebra_only'
ROLE_PROBE_CASES = ('normal', 'fresh_error', 'mismatch', 'g0_error', 'g1_error', 'g2_error', 'g3_error',
    'entry_alias_occupied', 'entry_alias_drift', 'entry_path_drift', 'entry_orig_argv_drift', 'entry_repo_module')


def role_target_caps():
    caps = {name: 64*1024 for name in TARGETS}
    caps.update({'context.json': 2*1024**2, 'worker/parent_metrics.json': 1024**2,
        'worker/fresh/metrics.json': 1024**2, 'worker/comparison_candidate.json': 256*1024,
        'worker/parent_startup.json': 16384, 'worker/fresh/startup.json': 16384,
        'diagnostics/failure.json': 131072})
    caps.update({name: 131072 for name in RECORDS})
    require(sum(caps.values()) == 5537792 and len(caps) == 17, 'fixed role target reservations differ')
    return caps


def role_targets(role):
    ownership = dict(external=('context.json',), controller=('worker/parent_startup.json', 'worker/launcher.json',
        'parent/parent_observation.json', 'diagnostics/failure.json'),
        parent=('worker/events.jsonl', 'worker/parent.stdout.log', 'worker/parent.stderr.log', 'worker/parent_metrics.json',
            'worker/comparison_candidate.json', 'worker/fresh/startup.json', 'worker/fresh/launcher.json',
            'worker/fresh_parent/parent_observation.json'),
        fresh=('worker/fresh/events.jsonl', 'worker/fresh/stdout.log', 'worker/fresh/stderr.log', 'worker/fresh/metrics.json'))
    require(role in ownership, 'closed output writer role required')
    return ownership[role]


def _role_tree(root):
    return tuple((name, directories(root/name)) for name in ('', 'worker', 'worker/fresh', 'worker/fresh_parent', 'parent', 'diagnostics'))+(
        ('context_file_identity', identity(ordinary(root/'context.json'))),)


def make_role_probe_context(output, case='normal', *, started=None):
    output = Path(output).absolute()
    require(output_mode(output) == 'ordinary_pytest_fixture' and not os.path.lexists(output), 'fresh dedicated ordinary output required')
    require(case in ROLE_PROBE_CASES, 'closed ordinary role fixture required')
    if started is None: started = time.monotonic()
    require(type(started) is float and math.isfinite(started) and 0 < started <= time.monotonic(), 'host invocation start required')
    value = dict(schema=ROLE_PROBE_SCHEMA, authority='DRAFT_NONAUTHORITATIVE', scope=ROLE_PROBE_SCOPE,
        repo_root=str(ROOT), output_root=str(output), output_parent_directories=directories(output.parent), source_pins=source_pins(),
        executable=dict(path=str(EXE), pin=pin(read(EXE, allow_links=True)), python=sys.version), environment=environment(),
        fixture=dict(left=2, right=3, expected=5), case=case, started=started, deadline=started+8., nonce=secrets.token_hex(32),
        F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
    return canonical(value)


def check_role_probe_context(raw, expected_sha):
    require(type(raw) is bytes and sha256(raw).hexdigest() == expected_sha, 'held ordinary role context SHA differs')
    value = parse(raw)
    keys(value, 'schema authority scope repo_root output_root output_parent_directories source_pins executable environment fixture case '
        'started deadline nonce F_launch_admitted saved_P1_fresh_process_verified saved_P1_parent_adoption_verified '+' '.join(GATES))
    require(value['schema'] == ROLE_PROBE_SCHEMA and value['authority'] == 'DRAFT_NONAUTHORITATIVE'
        and value['scope'] == ROLE_PROBE_SCOPE and all(value[k] is False for k in GATES)
        and value['F_launch_admitted'] is value['saved_P1_fresh_process_verified'] is value['saved_P1_parent_adoption_verified'] is False,
        'ordinary role authority differs')
    root = Path(value['output_root'])
    require(str(root.absolute()) == str(root) and '..' not in root.parts and output_mode(root) == 'ordinary_pytest_fixture',
        'ordinary role output differs')
    require(value['output_parent_directories'] == [list(row) for row in directories(root.parent)], 'ordinary output parent identity differs')
    require(value['fixture'] == dict(left=2, right=3, expected=5)
        and canonical(value['fixture']) == b'{"expected":5,"left":2,"right":3}'
        and value['case'] in ROLE_PROBE_CASES, 'closed ordinary fixture differs')
    require(type(value['started']) is float and type(value['deadline']) is float
        and math.isfinite(value['started']) and math.isfinite(value['deadline'])
        and 0 < value['started'] <= time.monotonic() <= value['deadline'] == value['started']+8., 'ordinary graph deadline')
    require(type(value['nonce']) is str and len(value['nonce']) == 64 and all(c in '0123456789abcdef' for c in value['nonce']), 'role nonce domain')
    require(value['repo_root'] == str(ROOT) and value['source_pins'] == source_pins() and value['environment'] == environment()
        and value['executable'] == dict(path=str(EXE), pin=pin(read(EXE, allow_links=True)), python=sys.version)
        and Path(sys.executable).absolute() == EXE and Path.cwd().absolute() == ROOT, 'ordinary role actual source/runtime differs')
    for name in value['source_pins']:
        if not name.endswith('.py'): continue
        module = sys.modules.get(name[:-3].replace('/', '.').removesuffix('.__init__'))
        if module is not None:
            require(type(getattr(module, '__file__', None)) is str and Path(module.__file__).absolute() == ROOT/name
                and pin(read(module.__file__)) == value['source_pins'][name], 'ordinary loaded selected module differs')
    return value


def _role_context(raw, expected_sha):
    value = parse(raw)
    return check_role_probe_context(raw, expected_sha) if value.get('schema') == ROLE_PROBE_SCHEMA else check_context(raw, expected_sha)


class RolePublicationUnresolved(OSError):
    def __init__(self, target, raw, phase, may, primary):
        self.target, self.expected_sha, self.phase = str(target), sha256(raw).hexdigest(), phase
        self.may_have_published, self.primary_error = may, _stage_error(primary)
        super().__init__('role publication unresolved at '+phase)


class RoleExecutionUnresolved(RuntimeError):
    def __init__(self, primary, stage=None, diagnostic=None, cleanup_errors=()):
        self.primary, self.stage, self.diagnostic = primary, stage, diagnostic
        self.cleanup_errors = tuple(cleanup_errors)
        super().__init__('role execution unresolved; original errors and capabilities retained')

    def __reduce__(self): raise TypeError('unresolved role capabilities cannot be serialized')


def _role_error_holds_capability(error):
    pending, seen = [error], set()
    while pending:
        current = pending.pop()
        if current is None or id(current) in seen: continue
        if len(seen) >= 256: return True
        seen.add(id(current))
        if isinstance(current, (StageConstructionUnresolved, StageChannelConstructionUnresolved, RoleExecutionUnresolved, OwnedStageCloseUnresolved)): return True
        pending.extend((current.__cause__, current.__context__))
    return False


def _role_stage_still_open(stage):
    return stage is not None and (any(getattr(stage.owner, name, None) is not None for name in ('_job', '_process', '_thread'))
        or bool(getattr(stage.owner, '_members', {}))
        or any(getattr(getattr(stage.owner, '_info', None), name, None) is not None for name in ('process', 'thread'))
        or any(getattr(stage.channel, name, None) is not None for name in ('_view', '_map', '_mutex'))
        or stage.last_observation is not None and stage.last_image is None)


def _publish_role_file(target, raw, *, hook=None):
    """Private fault seam; production uses closed role paths with no callback."""
    target = Path(target)
    require(type(raw) is bytes and len(raw) <= 8*1024**2, 'bounded role publication bytes required')
    pending = target.with_name(target.name+'.pending')
    phase, may = 'before_open', False
    def step(name):
        nonlocal phase
        phase = name
        if hook is not None: hook(name, target)
    try:
        expected_parent = directories(target.parent)
        require(not os.path.lexists(target), 'create-only role target required')
        require(not os.path.lexists(pending), 'role pending already exists')
        step('before_open')
        with pending.open('xb') as stream:
            stream.write(raw); step('after_write')
            stream.flush(); os.fsync(stream.fileno()); step('after_fsync')
        published_identity = identity(ordinary(pending))
        require(read(pending) == raw, 'role pending readback differs'); step('after_pending_readback')
        step('before_rename')
        require(directories(target.parent) == expected_parent, 'role directory changed before rename')
        phase, may = 'rename', True
        os.rename(pending, target); step('after_rename')
        require(read(target) == raw, 'role final readback differs'); step('after_final_readback')
        require(directories(target.parent) == expected_parent and identity(ordinary(target)) == published_identity,
            'role directory/file identity changed after publish')
        return dict(pin(raw), identity=published_identity)
    except BaseException as error:
        raise RolePublicationUnresolved(target, raw, phase, may, error) from error


@dataclass(frozen=True, init=False)
class RoleStore:
    root: Path
    raw: bytes
    sha: str
    tree: tuple
    creator: tuple
    binding: tuple
    writer: str
    schema: str
    receipts: tuple
    receipt_commit: str
    child_reservation: object
    child_consumed: bool
    reservation_commit: str
    target_attempts: tuple
    attempt_commit: str

    def __init__(self, raw, expected_sha, expected_tree_sha, writer='controller'):
        if _DIRECT_BOOTSTRAP is not None: _DIRECT_BOOTSTRAP.check()
        context = _role_context(raw, expected_sha)
        if context['schema'] == SCHEMA:
            _held_saved_bootstrap(writer, raw, expected_sha, tree_sha=expected_tree_sha, require_channel=False)
        else: require(_SAVED_BOOTSTRAP is None, 'saved bootstrap cannot enter an ordinary store')
        require(writer in ('controller', 'parent', 'fresh'), 'closed role store writer required')
        root = Path(context['output_root']); tree = _role_tree(root)
        require(digest(tree) == expected_tree_sha and read(root/'context.json') == raw, 'external output/context binding differs')
        values = dict(root=root, raw=raw, sha=expected_sha, tree=tree, writer=writer, schema=context['schema'], creator=(os.getpid(), get_ident()),
            receipts=(), receipt_commit=digest(()))
        values.update(child_reservation=None, child_consumed=False, reservation_commit=digest([None, False]))
        values.update(target_attempts=(), attempt_commit=digest(()))
        values['binding'] = str(root), expected_sha, tree, writer, context['schema']
        for name, value in values.items(): object.__setattr__(self, name, value)

    def check(self):
        if _DIRECT_BOOTSTRAP is not None: _DIRECT_BOOTSTRAP.check()
        if self.schema == SCHEMA:
            _held_saved_bootstrap(self.writer, self.raw, self.sha, tree_sha=digest(self.tree))
        else: require(_SAVED_BOOTSTRAP is None, 'saved bootstrap cannot enter an ordinary store')
        require(self.creator == (os.getpid(), get_ident()) and (str(self.root), self.sha, self.tree, self.writer, self.schema) == self.binding
            and type(self.raw) is bytes and sha256(self.raw).hexdigest() == self.sha, 'creating held role store required')
        require(_role_tree(self.root) == self.tree and read(self.root/'context.json') == self.raw, 'role output/context bookend differs')
        require(digest(self.receipts) == self.receipt_commit, 'held role publication receipts changed')
        require(type(self.child_consumed) is bool and digest([self.child_reservation, self.child_consumed]) == self.reservation_commit,
            'held one-shot role reservation changed')
        require(digest(self.target_attempts) == self.attempt_commit, 'held role target attempts changed')
        for name, _, _, expected_identity in self.receipts:
            require(identity(ordinary(self.root/name)) == expected_identity, 'published role file identity changed')

    def accounting(self):
        self.check(); safety = _output_safety(self.root, self.tree[0][1])
        caps = role_target_caps(); remaining_bytes = remaining_files = 0
        for name, cap in caps.items():
            present = [self.root/n for n in (name, name+'.pending') if os.path.lexists(self.root/n)]
            require(len(present) <= 1, 'role final/pending conflict')
            used = ordinary(present[0]).st_size if present else 0
            require(used <= cap, 'role per-target byte cap')
            remaining_bytes += cap-used; remaining_files += int(not present)
        require(safety['bytes']+remaining_bytes == sum(caps.values()) <= CAPS['output_bytes']
            and safety['files']+remaining_files == len(caps) <= CAPS['files'], 'all role reservations do not fit')
        self.check()
        return dict(safety, all_targets_reserved_bytes=remaining_bytes, all_targets_reserved_files=remaining_files,
            reservation_envelope_bytes=sum(caps.values()))

    def publish(self, role, name, value):
        return _publish_role_target(self, role, name, canonical(value))

    def reserve_child(self, role):
        self.check()
        require((self.writer, role) in (('controller', 'parent'), ('parent', 'fresh'))
            and self.child_reservation is None, 'single nested role reservation required')
        reservation = (role, time.monotonic(), secrets.token_hex(32), self.creator)
        object.__setattr__(self, 'child_reservation', reservation)
        object.__setattr__(self, 'reservation_commit', digest([reservation, False]))
        return reservation

    def consume_child(self, role, reservation):
        if self.schema == SCHEMA: _saved_owner_store(self, role, reservation, consumed=False)
        else: self.check()
        require(reservation is self.child_reservation and reservation[0] == role and reservation[3] == self.creator
            and not self.child_consumed, 'creating one-shot role reservation required')
        object.__setattr__(self, 'child_consumed', True)
        object.__setattr__(self, 'reservation_commit', digest([reservation, True]))

    def read_after_quiet(self, name, held_owner):
        record = _held_role_process(held_owner, self)
        role = held_owner.channel.spec['role']
        require(name in TARGETS and name.startswith('worker/fresh/' if role == 'fresh' else 'worker/')
            and role in ('parent', 'fresh') and record['stage_process_observed_successfully'] is True,
            'successful retained owner quiet required before child content')
        _checked_role_process_record(self, record, role)
        self.accounting(); raw = read(self.root/name)
        require(len(raw) <= role_target_caps()[name], 'bounded child target required')
        self.accounting(); return raw

    def read_diagnostic_after_quiet(self, name, held_owner):
        _held_role_process(held_owner, self)
        require(name in ('worker/events.jsonl', 'worker/parent.stdout.log', 'worker/parent.stderr.log',
            'worker/fresh/events.jsonl', 'worker/fresh/stdout.log', 'worker/fresh/stderr.log'), 'application diagnostic target required')
        self.accounting(); raw = read(self.root/name)
        require(len(raw) <= role_target_caps()[name], 'bounded diagnostic required')
        self.accounting(); return raw

    def __reduce__(self): raise TypeError('live role store cannot be serialized')


def _held_role_process(held, store):
    require(type(held) is OwnedStage and held.domain == 'ordinary', 'direct ordinary retained owner capability required')
    held._entry()
    require(held._attempted and held.real_owner and type(held.last_image) is bytes
        and canonical(held.last_observation) == held.last_image and held.channel.context_sha == store.sha,
        'held process observation changed or unavailable')
    record = parse(held.last_image)
    require(canonical(record['startup']) == held.startup, 'held actual startup image differs')
    role = held.channel.spec['role']
    require((role, store.writer) in (('fresh', 'parent'), ('parent', 'controller'))
        and record['startup']['probe_id'] == 'role_graph_'+role
        and record['startup']['creator_pid'] == store.creator[0]
        and record['startup']['argv'] == _role_child_argv(role, store, held.channel), 'exact role owner/output binding differs')
    require(record['owner_evidence'] == 'direct_owned_child' and record['job_quiet_confirmed'] is True
        and held.owner._process is held.owner._job is held.owner._thread is None and not held.owner._members
        and _stage_complete_witness(held.owner.quiescence_witness, held.owner.pid, held.owner.creation_filetime)
        and canonical(held.owner.quiescence_witness) == canonical(record['quiescence_witness'])
        and held.channel._map is held.channel._mutex is held.channel._view is None,
        'closed retained owner quiet required before content')
    return record


def _checked_role_process_record(store, value, role):
    keys(value, 'authority scope owner_evidence startup descriptor exit_code primary_stop_reason monitor_error '
        'termination_requested termination_call_succeeded termination_error quiesce_error close_error channel_error '
        'final_bookend_error channel_close_error quiet_witness_consistent relay_error job_quiet_confirmed quiescence_witness '
        'stage_process_observed_successfully logic_path_completed stage_transcript_complete frames_observed phases_observed '
        'transcript_sha stage_header transcript_frames samples sampled_tree_peak_rss_bytes terminal_tree_rss_bytes peak_job_commit_bytes '
        'release_attempted terminal_system_helpers construction_seconds observation_seconds remaining_total_seconds total_deadline terminal_accepted '
        'terminal_exit_deadline terminal_exit_cap_seconds terminal_exit_limiting_deadline root_exit_observed_at termination_requested_at '
        'quiesce_started_at quiesce_completed_at close_attempts_finished_at observation_finished_at active_io_scope artifact_contents_read '
        'external_constructor_and_monitor_interrupt_bound_proved terminal_publication_bound_proved clock poll_interval_seconds '
        'F_launch_admitted saved_P1_fresh_process_verified saved_P1_parent_adoption_verified '+' '.join(GATES))
    spec = checked_stage_descriptor(canonical(value['descriptor']))
    require(canonical(spec) == ordinary_stage_descriptor(role, 'role_graph'), 'role process fixed descriptor differs')
    require(value['authority'] == 'DRAFT_NONAUTHORITATIVE' and value['scope'] == 'ordinary_retained_owner_stage_process_only'
        and value['owner_evidence'] == 'direct_owned_child' and value['exit_code'] == 0
        and all(value[name] is True for name in ('stage_process_observed_successfully', 'job_quiet_confirmed',
            'quiet_witness_consistent', 'logic_path_completed', 'stage_transcript_complete', 'release_attempted')),
        'successful direct role process required')
    require(all(value[name] is None for name in ('primary_stop_reason', 'monitor_error', 'termination_error', 'quiesce_error',
        'close_error', 'channel_error', 'final_bookend_error', 'channel_close_error', 'relay_error')), 'role process error remains')
    require(all(value[name] is False for name in (*GATES, 'F_launch_admitted', 'saved_P1_fresh_process_verified',
        'saved_P1_parent_adoption_verified', 'external_constructor_and_monitor_interrupt_bound_proved', 'terminal_publication_bound_proved',
        'artifact_contents_read', 'termination_requested', 'termination_call_succeeded')), 'role process authority differs')
    startup, header = value['startup'], value['stage_header']
    keys(startup, 'schema authority scope probe_id creator_pid argv command_line cwd environment_sha context_sha descriptor_sha '
        'channel_name owner_pid owner_creation_filetime actual_os_commandline_independently_verified')
    require(startup['schema'] == 'staged_saved_F_probe_CreateProcess_inputs_v1'
        and startup['authority'] == 'DRAFT_NONAUTHORITATIVE' and startup['scope'] == 'ordinary_owner_probe_only', 'role startup schema differs')
    keys(header, 'schema context_sha nonce descriptor owner_pid owner_creation_filetime slots slot_bytes')
    require(header['context_sha'] == startup['context_sha'] == store.sha and header['descriptor'] == spec
        and header['slots'] == 16 and header['slot_bytes'] == 4096 and header['schema'] == 'staged_saved_F_memory_header_v1', 'role frame header differs')
    require(startup['probe_id'] == 'role_graph_'+role and startup['owner_pid'] == header['owner_pid']
        and startup['owner_creation_filetime'] == header['owner_creation_filetime'], 'role startup owner differs')
    require(type(header['owner_pid']) is int and 0 < header['owner_pid'] < 2**32
        and type(header['owner_creation_filetime']) is int and 0 < header['owner_creation_filetime'] < 2**64
        and type(startup['owner_pid']) is int and type(startup['owner_creation_filetime']) is int
        and type(startup['creator_pid']) is int and 0 < startup['creator_pid'] < 2**32
        and type(header['nonce']) is str and len(header['nonce']) == 64 and all(c in '0123456789abcdef' for c in header['nonce'])
        and type(startup['channel_name']) is str and startup['channel_name'].startswith(STAGE_PREFIX)
        and len(startup['channel_name']) == len(STAGE_PREFIX)+64
        and all(c in '0123456789abcdef' for c in startup['channel_name'][len(STAGE_PREFIX):]), 'role startup/header scalar domains differ')
    class Channel:
        name, nonce, descriptor = startup['channel_name'], header['nonce'], canonical(spec)
    require(startup['argv'] == _role_child_argv(role, store, Channel)
        and startup['command_line'] == subprocess.list2cmdline(startup['argv']) and startup['cwd'] == str(ROOT)
        and startup['environment_sha'] == digest(parse(store.raw)['environment'])
        and startup['descriptor_sha'] == sha256(canonical(spec)).hexdigest()
        and startup['actual_os_commandline_independently_verified'] is False, 'role exact CreateProcess inputs differ')
    require(_stage_complete_witness(value['quiescence_witness'], header['owner_pid'], header['owner_creation_filetime']), 'role complete inventory required')
    require(type(value['samples']) is int and value['samples'] > 0 and type(value['sampled_tree_peak_rss_bytes']) is int
        and 0 <= value['sampled_tree_peak_rss_bytes'] <= spec['rss_bytes'] and type(value['peak_job_commit_bytes']) is int
        and 0 <= value['peak_job_commit_bytes'] <= spec['job_commit_bytes'], 'role resource observation differs')
    frames = value['transcript_frames']; require(type(frames) is list and len(frames) == len(spec['phases'])+1, 'complete role frames required')
    previous, slots = '0'*64, []; header_sha = sha256(_stage_slot(canonical(header), STAGE_HEADER_COMMIT)).hexdigest()
    for index, frame in enumerate(frames):
        keys(frame, 'schema sequence phase binding_sha previous_sha producer_pid producer_creation_filetime stamp error_code')
        require(frame['schema'] == 'staged_saved_F_memory_frame_v1' and type(frame['sequence']) is int and frame['sequence'] == index
            and frame['phase'] == (spec['phases']+['terminal'])[index] and frame['binding_sha'] == header_sha
            and frame['previous_sha'] == previous and frame['error_code'] is None
            and frame['producer_pid'] == header['owner_pid'] and frame['producer_creation_filetime'] == header['owner_creation_filetime']
            and type(frame['stamp']) is float and math.isfinite(frame['stamp']) and frame['stamp'] > 0, 'role transcript binding differs')
        raw = canonical(frame); slots.append(_stage_slot(raw, STAGE_COMMIT)); previous = sha256(raw).hexdigest()
    require(value['frames_observed'] == len(frames) and value['transcript_sha'] == sha256(b''.join(slots)).hexdigest(), 'role transcript digest differs')
    for key in ('root_exit_observed_at', 'quiesce_started_at', 'quiesce_completed_at', 'close_attempts_finished_at', 'observation_finished_at', 'total_deadline'):
        require(type(value[key]) is float and math.isfinite(value[key]), 'finite role observer time required')
    require(value['root_exit_observed_at'] <= value['quiesce_started_at'] <= value['quiesce_completed_at']
        <= value['close_attempts_finished_at'] <= value['observation_finished_at'] <= value['total_deadline']
        and value['remaining_total_seconds'] == value['total_deadline']-value['observation_finished_at'], 'role observer time order differs')
    require(value['active_io_scope'] == 'kernel_and_fixed_shared_memory_only' and value['poll_interval_seconds'] == .01
        and value['clock'] == dict(implementation=time.get_clock_info('monotonic').implementation,
            resolution=time.get_clock_info('monotonic').resolution), 'role monitor contract differs')
    entries = value['phases_observed']
    require(type(entries) is list and len(entries) == len(spec['phases']), 'complete observer phase entries required')
    for index, entry in enumerate(entries):
        keys(entry, 'phase observer_entered')
        require(entry['phase'] == spec['phases'][index] and type(entry['observer_entered']) is float
            and math.isfinite(entry['observer_entered']) and entry['observer_entered'] > 0
            and (index == 0 or entries[index-1]['observer_entered'] <= entry['observer_entered']), 'observer phase order differs')
    require(type(value['terminal_accepted']) is float and type(value['terminal_exit_deadline']) is float
        and math.isfinite(value['terminal_accepted']) and math.isfinite(value['terminal_exit_deadline'])
        and entries[-1]['observer_entered'] <= value['terminal_accepted'] <= value['terminal_exit_deadline']
        and value['terminal_exit_cap_seconds'] == spec['terminal_seconds']
        and value['terminal_exit_limiting_deadline'] in ('active', 'phase', 'exit_cap'), 'role terminal clock differs')
    require(type(value['construction_seconds']) is float and 0 <= value['construction_seconds'] <= spec['total_seconds']
        and type(value['observation_seconds']) is float and 0 <= value['observation_seconds'] <= spec['total_seconds']
        and value['termination_requested_at'] is None, 'role duration or success termination differs')
    helpers = value['terminal_system_helpers']
    require(type(helpers) is list and len(helpers) <= 1, 'bounded terminal OS helper record required')
    for helper in helpers:
        keys(helper, 'pid creation_filetime image_path observed_at')
        require((helper['pid'], helper['creation_filetime']) in {(m['pid'], m['creation_filetime']) for m in value['quiescence_witness']['member_identities']}
            and helper['pid'] != value['startup']['owner_pid'] and helper['image_path'].lower() == _system_console_path()
            and type(helper['observed_at']) is float and value['root_exit_observed_at'] <= helper['observed_at'] <= value['quiesce_started_at'],
            'terminal OS helper identity/time differs')
    return value


def _publish_role_target(store, role, name, raw, *, hook=None):
    require(type(store) is RoleStore and role == store.writer and name in role_targets(role), 'fixed target writer required')
    parse(raw); require(len(raw) <= role_target_caps()[name], 'role target exceeds reserved bytes')
    store.accounting()
    require(name not in store.target_attempts, 'single role target attempt required')
    attempts = store.target_attempts+(name,)
    object.__setattr__(store, 'target_attempts', attempts); object.__setattr__(store, 'attempt_commit', digest(attempts))
    result = _publish_role_file(store.root/name, raw, hook=hook)
    try:
        store.accounting(); require(read(store.root/name) == raw, 'role publication final bytes differ')
        require(identity(ordinary(store.root/name)) == result['identity'], 'role publication receipt differs')
        receipts = store.receipts+((name, len(raw), sha256(raw).hexdigest(), result['identity']),)
        object.__setattr__(store, 'receipts', receipts); object.__setattr__(store, 'receipt_commit', digest(receipts))
        store.check()
    except BaseException as error:
        raise RolePublicationUnresolved(name, raw, 'store_final_bookend', True, error) from error
    return pin(raw)


def prepare_role_probe_output(raw, expected_sha):
    """Ordinary harness simulates external root/context, then controller setup."""
    context = check_role_probe_context(raw, expected_sha); root = Path(context['output_root'])
    require(not os.path.lexists(root), 'external role root already exists')
    require(len(raw) <= role_target_caps()['context.json'], 'context reserve exceeded')
    root.mkdir(); root_identity = directories(root)
    context_receipt = _publish_role_file(root/'context.json', raw)
    require(directories(root) == root_identity and set(root.iterdir()) == {root/'context.json'}, 'controller requires external context only')
    for name in ('worker', 'worker/fresh', 'worker/fresh_parent', 'parent', 'diagnostics'):
        (root/name).mkdir()
    require(identity(ordinary(root/'context.json')) == context_receipt['identity'], 'external context identity changed')
    store = RoleStore(raw, expected_sha, digest(_role_tree(root)))
    store.accounting(); return store


def _role_child_argv(role, store, channel):
    require(role in ('parent', 'fresh'), 'closed child role required')
    return ordinary_file_argv(role, str(store.root/'context.json'), store.sha, channel.name, channel.nonce,
        tree_sha=digest(store.tree))


def _create_role_owner(role, store, reservation=None):
    store.check()
    if reservation is None: reservation = store.reserve_child(role)
    store.consume_child(role, reservation)
    context = check_role_probe_context(store.raw, store.sha)
    require((store.writer, role) in (('controller', 'parent'), ('parent', 'fresh')), 'fixed nested role owner required')
    descriptor = ordinary_stage_descriptor(role, 'role_graph')
    channel = StageChannel.create(store.sha, descriptor)
    try: return _construct_stage_owner(_role_child_argv(role, store, channel), channel, 'role_graph_'+role, started=reservation[1])
    except BaseException as primary:
        try: channel.close()
        except BaseException as cleanup:
            raise StageChannelConstructionUnresolved(channel, primary, cleanup, 'role_owner_channel_cleanup') from primary
        raise


def _role_fixture_payload(context, role):
    fixture = context['fixture']
    computed = fixture['left']+fixture['right']
    if context['case'] == 'mismatch' and role == 'fresh': computed += 1
    return dict(schema='staged_saved_F_ordinary_algebra_payload_v1', authority='DRAFT_NONAUTHORITATIVE',
        scope=ROLE_PROBE_SCOPE, fixture_sha=digest(fixture), operands=[fixture['left'], fixture['right']], result=computed)


def _disable_saved_effects(adapter):
    import highspy
    import pyomo.environ as pyo
    def denied(*args, **kwargs): raise RuntimeError('saved F read-only role requested a forbidden effect')
    for module, name in ((pyo, 'SolverFactory'), (highspy, 'Highs'), (subprocess, 'Popen'),
            (adapter.prefix.point.backend, 'make_model'), (adapter.prefix.point.backend, 'call_highs'),
            (adapter.codec.EvidenceStore, 'put'), (adapter.codec, 'publish'), (adapter.journal, 'publish')):
        setattr(module, name, denied)
    for name in ('create_session', 'begin_step', 'commit_step', 'finish'): setattr(adapter.journal, name, denied)


def _role_reconstruct(store, role):
    store.check(); context = parse(store.raw)
    if context['schema'] == ROLE_PROBE_SCHEMA:
        if context['case'] == 'fresh_error' and role == 'fresh': raise ValueError('fixed ordinary fresh error')
        return canonical(_role_fixture_payload(context, role)), None
    execution_context(role, store.raw, store.sha)
    from src import staged_rts24_saved_fresh_adoption_v1 as adapter
    _disable_saved_effects(adapter)
    held = adapter.hold(context['source_pins'], canonical(context['caller_core']))
    return canonical(adapter.replay(held, store.sha)), held


def _role_input_bookend(store, stage, held=None):
    require(stage in ('G0', 'G1', 'G2', 'G3'), 'closed input bookend stage required')
    context = _role_context(store.raw, store.sha); store.check()
    if context['schema'] == ROLE_PROBE_SCHEMA:
        if context['case'] == stage.lower()+'_error': raise ValueError('fixed ordinary '+stage+' bookend error')
    else:
        execution_context('supervise' if store.writer == 'controller' else store.writer, store.raw, store.sha)
        from src import staged_rts24_saved_fresh_adoption_v1 as adapter
        if held is None: held = adapter.hold(context['source_pins'], canonical(context['caller_core']))
        else: adapter.bookend(held)
    return held, dict(stage=stage, context_sha=store.sha, source_sha=digest(context['source_pins']),
        observed_at=time.monotonic(), scope=context['scope'])


def _role_compare(store, parent_raw, fresh_raw):
    store.check(); context = parse(store.raw)
    if context['schema'] == ROLE_PROBE_SCHEMA:
        expected = canonical(_role_fixture_payload(dict(context, case='normal'), 'parent'))
        require(parent_raw == fresh_raw == expected, 'independent ordinary payloads differ from external fixture')
        return dict(payload_byte_equality_verified=True, payload_sha=sha256(expected).hexdigest())
    execution_context('parent' if store.writer == 'parent' else 'supervise', store.raw, store.sha)
    from src import staged_rts24_saved_fresh_adoption_v1 as adapter
    return adapter.compare_payloads(parent_raw, fresh_raw, context_sha=store.sha,
        source_sha=digest(context['source_pins']), input_pins_sha=digest(context['input_files']),
        caller_sha=context['caller_sha'], caller_image=canonical(context['caller_core']))


def _check_role_candidates(store, outer, candidate_raw, parent_raw, fresh_raw, inner_raw, inner_observation_raw):
    outer_record = _held_role_process(outer, store)
    _checked_role_process_record(store, outer_record, 'parent')
    require(store.read_after_quiet('worker/launcher.json', outer) == outer.last_image, 'saved outer process differs from live owner')
    inner = _checked_role_process_record(store, parse(inner_raw), 'fresh')
    require(read(store.root/'worker/parent_startup.json') == outer.startup
        and store.read_after_quiet('worker/fresh/startup.json', outer) == canonical(inner['startup']), 'role startup file differs from actual capture')
    outer_members = {(item['pid'], item['creation_filetime']) for item in outer_record['quiescence_witness']['member_identities']}
    inner_members = {(item['pid'], item['creation_filetime']) for item in inner['quiescence_witness']['member_identities']}
    require(inner_members <= outer_members and inner['startup']['creator_pid'] == outer_record['startup']['owner_pid'], 'nested role identities differ')
    candidate, observation, context = parse(candidate_raw), parse(inner_observation_raw), parse(store.raw)
    keys(candidate, 'schema authority scope context_sha parent_payload_pin fresh_payload_pin comparison G1 inner_process_sha '
        'inner_observation_pin F_launch_admitted saved_P1_fresh_process_verified saved_P1_parent_adoption_verified '+' '.join(GATES))
    keys(observation, 'schema authority scope context_sha process_record_sha startup_sha metrics_pin ownership_status execution_status '
        'F_launch_admitted saved_P1_fresh_process_verified saved_P1_parent_adoption_verified '+' '.join(GATES))
    for item in (candidate, observation):
        require(item['authority'] == 'DRAFT_NONAUTHORITATIVE' and item['scope'] == context['scope'] and item['context_sha'] == store.sha
            and all(item[key] is False for key in (*GATES, 'F_launch_admitted', 'saved_P1_fresh_process_verified', 'saved_P1_parent_adoption_verified')),
            'role candidate/observation authority differs')
    require(candidate['schema'] == 'staged_saved_F_role_comparison_candidate_v1'
        and observation['schema'] == 'staged_saved_F_inner_role_observation_v1'
        and candidate['parent_payload_pin'] == pin(parent_raw) and candidate['fresh_payload_pin'] == pin(fresh_raw)
        and candidate['inner_process_sha'] == observation['process_record_sha'] == sha256(inner_raw).hexdigest()
        and candidate['inner_observation_pin'] == pin(inner_observation_raw)
        and observation['startup_sha'] == sha256(canonical(inner['startup'])).hexdigest()
        and observation['metrics_pin'] == pin(fresh_raw) and observation['ownership_status'] == 'quiet_verified'
        and observation['execution_status'] == 'successful_exit', 'role candidate/record pins differ')
    require(canonical(candidate['comparison']) == canonical(_role_compare(store, parent_raw, fresh_raw)), 'complete role comparison differs')
    g1 = candidate['G1']; keys(g1, 'stage context_sha source_sha observed_at scope')
    require(g1['stage'] == 'G1' and g1['context_sha'] == store.sha and g1['source_sha'] == digest(context['source_pins'])
        and g1['scope'] == context['scope'] and type(g1['observed_at']) is float and math.isfinite(g1['observed_at']), 'parent G1 reference differs')


def _role_content_inventory(store, outer, *, include_observation=True):
    process = _held_role_process(outer, store)
    _checked_role_process_record(store, process, 'parent')
    store.accounting(); inventory = {}
    expected_names = set(TARGETS)-{'diagnostics/failure.json'}
    if not include_observation: expected_names.remove('parent/parent_observation.json')
    for name in sorted(expected_names):
        target = store.root/name; before = identity(ordinary(target))
        raw = read(target)
        require(len(raw) <= role_target_caps()[name], 'inventory target byte cap')
        inventory[name] = dict(pin=pin(raw), identity=before)
    store.accounting()
    for name, expected in inventory.items():
        require(identity(ordinary(store.root/name)) == expected['identity'] and pin(read(store.root/name)) == expected['pin'], 'role content inventory bookend differs')
    for name, count, expected_sha, expected_identity in store.receipts:
        if name in inventory:
            require(inventory[name] == dict(pin=dict(bytes=count, sha256=expected_sha), identity=expected_identity), 'saved role receipt bytes differ')
    require(not os.path.lexists(store.root/'diagnostics/failure.json')
        and sum(row['pin']['bytes'] for row in inventory.values()) == store.accounting()['bytes'], 'role success inventory differs')
    require(canonical(_held_role_process(outer, store)) == canonical(process), 'held outer inventory permission changed')
    return inventory


def _role_auxiliary(store, role):
    names = ('worker/events.jsonl', 'worker/parent.stdout.log', 'worker/parent.stderr.log') if role == 'parent' else (
        'worker/fresh/events.jsonl', 'worker/fresh/stdout.log', 'worker/fresh/stderr.log')
    store.accounting()
    for name in names:
        require(store.writer == role and name in role_targets(role), 'fixed application log writer required')
        target = store.root/name
        event = dict(event='application_role_entered', role=role, context_sha=store.sha)
        if _DIRECT_BOOTSTRAP is not None: event['entry_bootstrap'] = _DIRECT_BOOTSTRAP.proof()
        raw = canonical(event)+b'\n' if name.endswith('.jsonl') else b''
        with target.open('xb') as stream: stream.write(raw)
    store.accounting()


def _role_error_event(store, error):
    role = store.writer
    name = 'worker/events.jsonl' if role == 'parent' else 'worker/fresh/events.jsonl'
    require(role in ('parent', 'fresh') and name in role_targets(role), 'role application error writer required')
    store.accounting(); target = store.root/name
    old = read(target) if os.path.lexists(target) else b''
    event = canonical(dict(event='application_role_error', role=role, context_sha=store.sha, error=_stage_error(error)))+b'\n'
    require(len(old)+len(event) <= role_target_caps()[name], 'application event reserve exceeded')
    before = identity(ordinary(target)) if old else None
    with target.open('ab' if os.path.lexists(target) else 'xb') as stream:
        if before is not None: require(identity(os.fstat(stream.fileno())) == before, 'application event changed before append')
        stream.write(event); stream.flush(); os.fsync(stream.fileno())
    require(read(target) == old+event, 'application event changed after append'); store.accounting()


def _inner_observation(store, held, metrics_pin):
    held._entry()
    require(type(held.last_image) is bytes and canonical(held.last_observation) == held.last_image, 'held inner process image required')
    record = parse(held.last_image)
    return dict(schema='staged_saved_F_inner_role_observation_v1', authority='DRAFT_NONAUTHORITATIVE',
        scope=parse(store.raw)['scope'], context_sha=store.sha, process_record_sha=sha256(held.last_image).hexdigest(),
        startup_sha=sha256(held.startup).hexdigest(), metrics_pin=metrics_pin,
        ownership_status='quiet_verified' if record['job_quiet_confirmed'] else 'unknown',
        execution_status='successful_exit' if record['stage_process_observed_successfully'] else 'failed_or_unknown',
        F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)


def _run_fresh_role(store, writer):
    writer.enter('fresh'); _role_auxiliary(store, 'fresh')
    raw, _ = _role_reconstruct(store, 'fresh')
    _publish_role_target(store, 'fresh', 'worker/fresh/metrics.json', raw)
    writer.enter('terminal')


def _run_parent_role(store, writer):
    writer.enter('parent'); _role_auxiliary(store, 'parent')
    parent_raw, parent_input = _role_reconstruct(store, 'parent')
    parent_pin = _publish_role_target(store, 'parent', 'worker/parent_metrics.json', parent_raw)
    # Entering fresh means reservation began, charging capture to its active cap.
    reservation = store.reserve_child('fresh'); writer.enter('fresh')
    fresh = _create_role_owner('fresh', store, reservation)
    try:
        store.publish('parent', 'worker/fresh/startup.json', parse(fresh.startup))
        process = _watch_stage(fresh, absolute_deadline=parse(store.raw)['deadline'], relay=writer)
    except BaseException as primary:
        try: fresh.close()
        except BaseException as cleanup: raise RoleExecutionUnresolved(primary, fresh, cleanup_errors=(('fresh_stage_close', cleanup),)) from primary
        raise
    metrics_pin = None
    if process['job_quiet_confirmed']:
        store.publish('parent', 'worker/fresh/launcher.json', process)
        if process['stage_process_observed_successfully']:
            fresh_raw = store.read_after_quiet('worker/fresh/metrics.json', fresh); metrics_pin = pin(fresh_raw)
    store.publish('parent', 'worker/fresh_parent/parent_observation.json', _inner_observation(store, fresh, metrics_pin))
    require(process['stage_process_observed_successfully'] and metrics_pin is not None, 'fresh role unsuccessful or unknown')
    writer.enter('parent_compare')
    _, g1 = _role_input_bookend(store, 'G1', parent_input)
    comparison = _role_compare(store, parent_raw, fresh_raw)
    candidate = dict(schema='staged_saved_F_role_comparison_candidate_v1', authority='DRAFT_NONAUTHORITATIVE',
        scope=parse(store.raw)['scope'], context_sha=store.sha, parent_payload_pin=parent_pin, fresh_payload_pin=metrics_pin,
        comparison=comparison, G1=g1, inner_process_sha=sha256(fresh.last_image).hexdigest(),
        inner_observation_pin=pin(read(store.root/'worker/fresh_parent/parent_observation.json')),
        F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
    store.publish('parent', 'worker/comparison_candidate.json', candidate)
    writer.enter('terminal')


def _ordinary_role_entry(role, context_path, context_sha, tree_sha, channel_name, channel_nonce):
    require(role in ('parent', 'fresh'), 'closed ordinary role entry required')
    raw = read(context_path); require(sha256(raw).hexdigest() == context_sha, 'held role entry context differs')
    context = parse(raw)
    require(context.get('schema') == ROLE_PROBE_SCHEMA and Path(context_path) == Path(context['output_root'])/'context.json', 'fixed ordinary role context path required')
    context = check_role_probe_context(raw, context_sha)
    expected = ordinary_file_argv(role, context_path, context_sha, channel_name, channel_nonce, tree_sha=tree_sha)
    if role == 'fresh' and context['case'] == 'entry_alias_occupied': sys.modules[ENTRY_MODULE_NAME] = object()
    if role == 'fresh' and context['case'] == 'entry_repo_module':
        unexpected = ModuleType('entry_repo_module'); unexpected.__file__ = str(ROOT/'experiments/entry_fault.py')
        sys.modules['entry_unrelated_name'] = unexpected
    _bind_ordinary_main(role, context_sha, expected, context)
    if role == 'fresh':
        if context['case'] == 'entry_alias_drift': sys.modules[ENTRY_MODULE_NAME] = object()
        elif context['case'] == 'entry_path_drift': sys.path.append(str(EXE.parent/'entry_fault'))
        elif context['case'] == 'entry_orig_argv_drift': sys.orig_argv.append('--entry-fault')
    store = RoleStore(raw, context_sha, tree_sha, role)
    descriptor = ordinary_stage_descriptor(role, 'role_graph')
    writer = StageChannel.attach(channel_name, channel_nonce, context_sha, descriptor)
    try:
        (_run_parent_role if role == 'parent' else _run_fresh_role)(store, writer)
    except BaseException as primary:
        cleanup_errors = []
        if store is not None:
            try: _role_error_event(store, primary)
            except BaseException as error: cleanup_errors.append(('application_event', error))
        try: writer.fail('role_diagnostic_failed' if cleanup_errors else 'role_execution_failed')
        except BaseException as error: cleanup_errors.append(('failure_signal', error))
        try: writer.close()
        except BaseException as error: cleanup_errors.append(('writer_close', error))
        raise RoleExecutionUnresolved(primary, cleanup_errors=cleanup_errors) from primary
    writer.close()


def run_ordinary_role_graph(output, case='normal'):
    raw = make_role_probe_context(output, case); context_sha = sha256(raw).hexdigest()
    store = prepare_role_probe_output(raw, context_sha)
    return _run_role_controller(store)


def _run_role_controller(store, writer=None, *, invocation_case='normal'):
    held_input = None; marks = []; outer = None; observation_pin = None
    try:
        held_input, g0 = _role_input_bookend(store, 'G0'); marks.append(g0)
        if writer is not None: writer.enter('parent')
        outer = _create_role_owner('parent', store)
        try:
            store.publish('controller', 'worker/parent_startup.json', parse(outer.startup))
            process = _watch_stage(outer, absolute_deadline=parse(store.raw)['deadline'], relay=writer)
        except BaseException as primary:
            try: outer.close()
            except BaseException as cleanup: raise RoleExecutionUnresolved(primary, outer, cleanup_errors=(('outer_stage_close', cleanup),)) from primary
            raise
        store.publish('controller', 'worker/launcher.json', process)
        require(process['stage_process_observed_successfully'], 'parent role unsuccessful or unknown')
        if writer is not None: writer.enter('final_check')
        candidate_raw = store.read_after_quiet('worker/comparison_candidate.json', outer)
        parent_raw = store.read_after_quiet('worker/parent_metrics.json', outer)
        fresh_raw = store.read_after_quiet('worker/fresh/metrics.json', outer)
        inner_raw = store.read_after_quiet('worker/fresh/launcher.json', outer)
        inner_observation_raw = store.read_after_quiet('worker/fresh_parent/parent_observation.json', outer)
        _check_role_candidates(store, outer, candidate_raw, parent_raw, fresh_raw, inner_raw, inner_observation_raw)
        core_inventory = _role_content_inventory(store, outer, include_observation=False)
        held_input, g2 = _role_input_bookend(store, 'G2', held_input); marks.append(g2)
        observation = dict(schema='staged_saved_F_final_role_observation_v1', authority='DRAFT_NONAUTHORITATIVE',
            scope=parse(store.raw)['scope'], context_sha=store.sha, candidate_pin=pin(candidate_raw),
            outer_process_sha=sha256(outer.last_image).hexdigest(), inner_process_pin=pin(inner_raw),
            inner_observation_pin=pin(inner_observation_raw), core_output_inventory_sha=digest(core_inventory),
            input_bookends_before_publication=marks,
            F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
        if writer is not None: writer.enter('final_publish')
        if invocation_case == 'publication_wait':
            observation_pin = _publish_role_target(store, 'controller', 'parent/parent_observation.json',
                canonical(observation), hook=_invocation_publication_wait)
        else: observation_pin = store.publish('controller', 'parent/parent_observation.json', observation)
        _, g3 = _role_input_bookend(store, 'G3', held_input); marks.append(g3)
        output_inventory = _role_content_inventory(store, outer)
        require(all(output_inventory.get(name) == expected for name, expected in core_inventory.items()), 'validated role core changed after final publication')
        _role_context(store.raw, store.sha)
        require(pin(read(store.root/'parent/parent_observation.json')) == observation_pin, 'final role observation changed')
        return dict(authority='DRAFT_NONAUTHORITATIVE', scope=parse(store.raw)['scope'], ordinary_graph_completed=True,
            observation_pin=observation_pin, input_bookends=marks, output_inventory=output_inventory, output_root=str(store.root),
            F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
    except BaseException as error:
        application_reports = []
        if outer is not None and type(outer.last_image) is bytes and outer.last_observation['job_quiet_confirmed']:
            for name in ('worker/events.jsonl', 'worker/fresh/events.jsonl'):
                if not os.path.lexists(store.root/name): continue
                try:
                    reported = store.read_diagnostic_after_quiet(name, outer)
                    events = [parse(line) for line in reported.splitlines()]
                    application_reports.append(dict(path=name, pin=pin(reported), report_scope='application_reported_only',
                        event_count=len(events), last_error=_bounded_stage_error_image(events[-1].get('error'), 3)
                            if events and type(events[-1]) is dict else None))
                except BaseException as diagnostic_error:
                    application_reports.append(dict(path=name, report_scope='unavailable', error=_stage_error(diagnostic_error)))
        diagnostic = dict(schema='staged_saved_F_role_failure_v1', authority='DRAFT_NONAUTHORITATIVE',
            scope=parse(store.raw)['scope'], context_sha=store.sha, error=_stage_error(error), input_bookends=marks,
            application_reports=application_reports,
            outer_process_sha=sha256(outer.last_image).hexdigest() if outer is not None and type(outer.last_image) is bytes else None,
            observation_pin=observation_pin, F_launch_admitted=False, saved_P1_fresh_process_verified=False,
            saved_P1_parent_adoption_verified=False, **GATES)
        try: failure_pin = store.publish('controller', 'diagnostics/failure.json', diagnostic)
        except BaseException as publication_error:
            raise RoleExecutionUnresolved(error, outer, diagnostic, (('diagnostic_publication', publication_error),)) from error
        if _role_error_holds_capability(error) or _role_stage_still_open(outer):
            raise RoleExecutionUnresolved(error, outer, dict(diagnostic, failure_pin=failure_pin)) from error
        return dict(diagnostic, ordinary_graph_completed=False, failure_pin=failure_pin, output_root=str(store.root))


INVOCATION_SCHEMA = 'staged_saved_F_ordinary_external_invocation_v1'
INVOCATION_PREFIX = 'Local\\electricity_grid_saved_invocation_'
INVOCATION_CASES = ('normal', 'prepare_wait', 'constructor_wait', 'publication_wait')
INVOCATION_SLOTS = (('header', 4096), ('request', 32768), ('ready', 4096), ('start', 4096),
    ('context', 2*1024**2+16384+44), ('ack', 4096), ('binding', 32768),
    ('constructor_probe', 4096),
    ('controller_return', 131072+44), ('broker_return', 131072+44))
INVOCATION_DIRECTIONS = dict(host=('request', 'start', 'ack'), broker=('ready', 'context', 'binding'),
    controller=('controller_return',), broker_terminal=('broker_return',), broker_probe=('constructor_probe',))


def _hex64(value):
    return type(value) is str and len(value) == 64 and all(c in '0123456789abcdef' for c in value)


def _invocation_request(output, case):
    output = Path(output).absolute()
    require(case in INVOCATION_CASES and output_mode(output) == 'ordinary_pytest_fixture'
        and not os.path.lexists(output), 'closed ordinary external invocation required')
    require(Path(sys.executable).absolute() == EXE and Path.cwd().absolute() == ROOT, 'bound invocation runtime required')
    return canonical(dict(schema=INVOCATION_SCHEMA, authority='DRAFT_NONAUTHORITATIVE', case=case,
        scope=ROLE_PROBE_SCOPE, repo_root=str(ROOT), output_root=str(output),
        output_parent_directories=directories(output.parent), source_pins=source_pins(),
        executable=dict(path=str(EXE), pin=pin(read(EXE, allow_links=True)), python=sys.version), environment=environment(),
        fixture=dict(left=2, right=3, expected=5), nonce=secrets.token_hex(32),
        ready_seconds=2., standby_seconds=1.5, invocation_descriptor=parse(ordinary_stage_descriptor('controller', 'invocation')),
        combined_sampled_rss_bytes=1024**3, combined_conservative_commit_bytes=2*1024**3,
        F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES))


def _check_invocation_request(raw):
    value = parse(raw)
    keys(value, 'schema authority case scope repo_root output_root output_parent_directories source_pins executable environment '
        'fixture nonce ready_seconds standby_seconds invocation_descriptor combined_sampled_rss_bytes '
        'combined_conservative_commit_bytes F_launch_admitted saved_P1_fresh_process_verified saved_P1_parent_adoption_verified '+' '.join(GATES))
    require(len(raw) < 30000 and value['schema'] == INVOCATION_SCHEMA and value['authority'] == 'DRAFT_NONAUTHORITATIVE'
        and value['scope'] == ROLE_PROBE_SCOPE and value['case'] in INVOCATION_CASES and _hex64(value['nonce'])
        and all(value[name] is False for name in (*GATES, 'F_launch_admitted', 'saved_P1_fresh_process_verified', 'saved_P1_parent_adoption_verified')),
        'ordinary invocation request domain')
    require(value['ready_seconds'] == 2. and value['standby_seconds'] == 1.5
        and canonical(value['invocation_descriptor']) == ordinary_stage_descriptor('controller', 'invocation')
        and value['combined_sampled_rss_bytes'] == 1024**3 and value['combined_conservative_commit_bytes'] == 2*1024**3,
        'fixed ordinary invocation budget differs')
    output = Path(value['output_root'])
    require(output_mode(output) == 'ordinary_pytest_fixture' and not os.path.lexists(output)
        and str(output.absolute()) == str(output) and '..' not in output.parts
        and value['output_parent_directories'] == [list(row) for row in directories(output.parent)], 'invocation output changed')
    require(value['repo_root'] == str(ROOT) and value['source_pins'] == source_pins() and value['environment'] == environment()
        and value['executable'] == dict(path=str(EXE), pin=pin(read(EXE, allow_links=True)), python=sys.version)
        and value['fixture'] == dict(left=2, right=3, expected=5)
        and canonical(value['fixture']) == b'{"expected":5,"left":2,"right":3}', 'independent invocation input differs')
    return value


def _invocation_slot(raw, size):
    require(type(raw) is bytes and 0 < len(raw) <= size-44, 'invocation slot cap')
    return struct.pack('<I', len(raw))+raw+b'\0'*(size-44-len(raw))+sha256(raw).digest()+STAGE_COMMIT


def _invocation_decode(slot):
    if slot[-8:] != STAGE_COMMIT: return None
    length = struct.unpack('<I', slot[:4])[0]
    if not 0 < length <= len(slot)-44: return None
    raw = slot[4:4+length]
    if slot[4+length:-40] != b'\0'*(len(slot)-44-length) or sha256(raw).digest() != slot[-40:-8]: return None
    return raw


class InvocationMailbox:
    """One fixed slot per transfer; actual process identities bound before release."""
    _locked = StageChannel._locked
    close = StageChannel.close

    def __init__(self): raise TypeError('use create or attach')

    @classmethod
    def _open(cls, name, request_sha, create, endpoint):
        require(type(name) is str and name.startswith(INVOCATION_PREFIX) and _hex64(name[len(INVOCATION_PREFIX):])
            and _hex64(request_sha) and endpoint in INVOCATION_DIRECTIONS, 'closed invocation mailbox name/domain')
        obj = object.__new__(cls)
        obj._api = _stage_api(); obj._map = obj._mutex = obj._view = None
        obj._creator = os.getpid(), get_ident(); obj._in_lock = False; obj._poison = None
        obj.name, obj.request_sha, obj.endpoint = name, request_sha, endpoint
        obj._inputs = name, request_sha, endpoint
        obj._header = None; obj._accepted = {}; obj._controller_identity = None
        obj._read_busy = False
        obj._layout = {}; position = 0
        for kind, size in INVOCATION_SLOTS:
            obj._layout[kind] = (position, size); position += size
        obj._size = position
        try:
            if create:
                C.set_last_error(0)
                obj._map = _native(obj._api.CreateFileMappingW(C.c_void_p(-1), None, 4, 0, position, name))
                require(C.get_last_error() != 183, 'invocation mapping collision')
                C.set_last_error(0)
                obj._mutex = _native(obj._api.CreateMutexW(None, False, name+'_mutex'))
                require(C.get_last_error() != 183, 'invocation mutex collision')
            else:
                obj._map = _native(obj._api.OpenFileMappingW(6, False, name))
                obj._mutex = _native(obj._api.OpenMutexW(0x100001, False, name+'_mutex'))
            for handle in (obj._map, obj._mutex):
                flags = W.DWORD(); _native(obj._api.GetHandleInformation(handle, C.byref(flags)))
                require(not flags.value&1, 'invocation handles must not be inherited')
            obj._view = _native(obj._api.MapViewOfFile(obj._map, 6, 0, 0, position))
            if create: require(C.string_at(obj._view, position) == b'\0'*position, 'invocation mapping not new')
            return obj
        except BaseException as primary:
            try: obj.close()
            except BaseException as cleanup: raise StageChannelConstructionUnresolved(obj, primary, cleanup, 'invocation_map_cleanup') from primary
            raise

    @classmethod
    def create(cls, request_sha, *, name=None):
        return cls._open(name or INVOCATION_PREFIX+secrets.token_hex(32), request_sha, True, 'host')

    @classmethod
    def attach(cls, name, request_sha, endpoint):
        require(endpoint in ('broker', 'controller'), 'fixed invocation child endpoint required')
        obj = cls._open(name, request_sha, False, endpoint)
        try:
            with obj._locked(100) as acquired:
                require(acquired, 'invocation attach busy')
                obj._header = C.string_at(obj._view, obj._layout['header'][1])
            header = parse(_invocation_decode(obj._header))
            obj._check_header(header)
            if endpoint == 'broker': expected = tuple(header['broker_identity'])
            else:
                binding = obj.read_packet('binding', bookend=True, _wait=100)
                require(binding is not None, 'controller binding unavailable')
                expected = binding['startup']['owner_pid'], binding['startup']['owner_creation_filetime']
                obj._controller_identity = expected
            require(expected == _own_process_identity(obj._api), 'wrong invocation endpoint process')
            return obj
        except BaseException as primary:
            try: obj.close()
            except BaseException as cleanup: raise StageChannelConstructionUnresolved(obj, primary, cleanup, 'invocation_attach_cleanup') from primary
            raise

    def _live(self, *, poisoned=False):
        require(self._creator == (os.getpid(), get_ident()) and (self.name, self.request_sha, self.endpoint) == self._inputs,
            'creating invocation endpoint required')
        require(all(getattr(self, name) is not None for name in ('_view', '_map', '_mutex')), 'closed invocation mailbox')
        if self._poison is not None and not poisoned: raise StageChannelError(self._poison, 'invocation mailbox remains unresolved')

    def _check_header(self, header):
        keys(header, 'schema name request_sha host_identity broker_identity direction_nonces layout_sha')
        require(header['schema'] == INVOCATION_SCHEMA and header['name'] == self.name and header['request_sha'] == self.request_sha
            and header['layout_sha'] == digest(INVOCATION_SLOTS) and set(header['direction_nonces']) == set(INVOCATION_DIRECTIONS)
            and all(_hex64(v) for v in header['direction_nonces'].values()), 'invocation header binding differs')
        for name in ('host_identity', 'broker_identity'):
            value = header[name]
            require(type(value) is list and len(value) == 2 and all(type(v) is int and v > 0 for v in value)
                and value[0] < 2**32 and value[1] < 2**64, 'invocation process identity domain')

    def bind(self, stage, request):
        self._live(); stage._entry()
        require(self.endpoint == 'host' and self._header is None and not stage.owner._released
            and stage.real_owner and sha256(request).hexdigest() == self.request_sha, 'new suspended invocation broker required')
        value = dict(schema=INVOCATION_SCHEMA, name=self.name, request_sha=self.request_sha,
            host_identity=_own_process_identity(self._api), broker_identity=(stage.owner.pid, stage.owner.creation_filetime),
            direction_nonces={key: secrets.token_hex(32) for key in INVOCATION_DIRECTIONS}, layout_sha=digest(INVOCATION_SLOTS))
        self._check_header(parse(canonical(value)))
        header = _invocation_slot(canonical(value), self._layout['header'][1])
        with self._locked(0) as acquired:
            require(acquired and C.string_at(self._view, self._size) == b'\0'*self._size, 'invocation map changed before bind')
            C.memmove(self._view, header[:-8], len(header)-8); C.memmove(self._view+len(header)-8, STAGE_COMMIT, 8)
        self._header = header
        self.write_packet('request', parse(request))

    def _direction(self, kind):
        return next(key for key, names in INVOCATION_DIRECTIONS.items() if kind in names)

    def _packet_binding(self, kind):
        header = parse(_invocation_decode(self._header)); direction = self._direction(kind)
        names = INVOCATION_DIRECTIONS[direction]; index = names.index(kind)
        previous = '0'*64
        for prior in names[:index]:
            raw = self._accepted.get(prior)
            require(raw is not None, 'prior invocation transfer unavailable')
            previous = sha256(_invocation_decode(raw)).hexdigest()
        if direction == 'controller':
            require(self._controller_identity is not None, 'actual controller binding required')
            producer = self._controller_identity
        else: producer = tuple(header[('broker' if direction in ('broker_terminal', 'broker_probe') else direction)+'_identity'])
        return dict(kind=kind, sequence=index, previous_sha=previous, producer_identity=list(producer),
            direction_nonce=header['direction_nonces'][direction], binding_sha=sha256(self._header).hexdigest())

    def read_packet(self, kind, *, bookend=False, _wait=0):
        require(type(_wait) is int and _wait in (0, 100), 'fixed invocation mutex observation bound')
        self._read_busy = False
        try: return self._read_packet(kind, bookend=bookend, _wait=_wait)
        except BaseException:
            if self._poison is None: self._poison = 'invocation_protocol'
            raise

    def _read_packet(self, kind, *, bookend=False, _wait=0):
        require(kind in self._layout and kind != 'header', 'closed invocation transfer required')
        direction = self._direction(kind)
        for prior in INVOCATION_DIRECTIONS[direction][:INVOCATION_DIRECTIONS[direction].index(kind)]:
            if self.read_packet(prior, bookend=bookend, _wait=_wait) is None: return None
        progress = self._progress_snapshot(_wait=_wait) if kind == 'broker_return' else None
        if kind == 'broker_return' and progress is None: return None
        if kind == 'controller_return' and self._controller_identity is None:
            binding = self.read_packet('binding', bookend=bookend, _wait=_wait)
            if binding is None: return None
            self._controller_identity = binding['startup']['owner_pid'], binding['startup']['owner_creation_filetime']
        with self._locked(_wait) as acquired:
            if not acquired:
                self._read_busy = True; return None
            require(C.string_at(self._view, len(self._header)) == self._header, 'invocation header changed')
            offset, size = self._layout[kind]
            marker = C.string_at(self._view+offset+size-8, 8)
            if kind in self._accepted and not bookend:
                require(marker == STAGE_COMMIT, 'accepted invocation commit changed')
                slot = self._accepted[kind]
            else:
                slot = C.string_at(self._view+offset, size)
                require(slot == C.string_at(self._view+offset, size), 'invocation transfer changed under mutex')
                if kind in self._accepted: require(slot == self._accepted[kind], 'accepted invocation transfer changed')
            raw = _invocation_decode(slot)
            if raw is None:
                require(slot == b'\0'*size, 'incomplete or corrupt invocation slot under acquired mutex')
                return None
            value = parse(raw); keys(value, 'kind sequence previous_sha producer_identity direction_nonce binding_sha payload')
            require({k: v for k, v in value.items() if k != 'payload'} == self._packet_binding(kind), 'invocation transfer binding differs')
            if kind == 'request': require(digest(value['payload']) == self.request_sha, 'invocation request SHA differs')
            self._accepted[kind] = slot
            if kind == 'broker_return':
                terminal = value['payload']; keys(terminal, 'status progress value')
                expected_status = 'failure' if terminal['value'].get('kind') == 'failure' else 'success'
                require(terminal['status'] == expected_status and terminal['progress'] == progress
                    and (expected_status != 'success' or len(progress['prefix']) == 3), 'broker terminal progress binding differs')
                return terminal['value']
            return value['payload']

    def write_packet(self, kind, payload):
        try: return self._write_packet(kind, payload)
        except BaseException:
            if self._poison is None: self._poison = 'invocation_protocol'
            raise

    def _write_packet(self, kind, payload):
        self._live(); require(kind in INVOCATION_DIRECTIONS[self.endpoint]
            or self.endpoint == 'broker' and kind in ('broker_return', 'constructor_probe'), 'wrong invocation transfer writer')
        direction = self._direction(kind)
        for prior in INVOCATION_DIRECTIONS[direction][:INVOCATION_DIRECTIONS[direction].index(kind)]:
            require(self.read_packet(prior, bookend=True, _wait=100) is not None, 'writer prior transfer unavailable')
        existing = self.read_packet(kind, bookend=True, _wait=100)
        require(not self._read_busy and existing is None, 'invocation slot already consumed or writer observation busy')
        require(tuple(self._packet_binding(kind)['producer_identity']) == _own_process_identity(self._api), 'actual invocation writer required')
        if kind == 'broker_return':
            progress = self._progress_snapshot(_wait=100); status = 'failure' if payload.get('kind') == 'failure' else 'success'
            require(progress is not None and 1 <= len(progress['prefix']) <= 3
                and (status != 'success' or len(progress['prefix']) == 3), 'terminal broker progress unavailable')
            payload = dict(status=status, progress=progress, value=payload)
        raw = canonical(dict(self._packet_binding(kind), payload=payload)); offset, size = self._layout[kind]
        slot = _invocation_slot(raw, size)
        with self._locked(100) as acquired:
            require(acquired and C.string_at(self._view, len(self._header)) == self._header, 'invocation write/header unavailable')
            require(C.string_at(self._view+offset, size) == b'\0'*size, 'invocation slot already used or partial')
            C.memmove(self._view+offset, slot[:-8], size-8); C.memmove(self._view+offset+size-8, STAGE_COMMIT, 8)
        self._accepted[kind] = slot
        return pin(raw)

    def _progress_snapshot(self, *, _wait=0):
        prefix = []; transcript = []; tail = False
        for kind in INVOCATION_DIRECTIONS['broker']:
            value = self.read_packet(kind, bookend=True, _wait=_wait)
            if self._read_busy: return None
            if value is None: tail = True
            if tail:
                offset, size = self._layout[kind]
                with self._locked(_wait) as acquired:
                    if not acquired:
                        self._read_busy = True; return None
                    require(C.string_at(self._view+offset, size) == b'\0'*size, 'noncontiguous or partial terminal broker progress')
            else:
                slot = self._accepted[kind]; transcript.append(slot)
                prefix.append(dict(kind=kind, pin=pin(_invocation_decode(slot))))
        return dict(prefix=prefix, transcript_sha=sha256(b''.join(transcript)).hexdigest())

    def bookend(self, *, _wait=0):
        for kind in tuple(self._accepted):
            require(self.read_packet(kind, bookend=True, _wait=_wait) is not None, 'invocation final bookend unavailable')

    def __reduce__(self): raise TypeError('live invocation mailbox cannot be serialized')


class InvocationUnresolved(RuntimeError):
    def __init__(self, capability, primary, cleanup=()):
        self.capability, self.primary, self.cleanup_errors = capability, primary, tuple(cleanup)
        super().__init__('ordinary external invocation unresolved: '+str(_stage_error(primary)))

    def __reduce__(self): raise TypeError('live invocation cleanup capability cannot be serialized')


@dataclass(frozen=True, init=False)
class ArmedInvocation:
    def __init__(self, request, mailbox, stage, armed_at, ready_at, standby_deadline, members):
        values = dict(request=request, mailbox=mailbox, stage=stage, armed_at=armed_at, ready_at=ready_at,
            standby_deadline=standby_deadline, ready_members=members, creator=(os.getpid(), get_ident()),
            consumed=False, started=None, held_context=None, ack_raw=None, controller_binding=None,
            construction_probe=None,
            active_error=None,
            resource_samples=0, sampled_combined_peak_rss_bytes=0, conservative_combined_peak_commit_bytes=0,
            host_peak_pagefile_bytes=0, result_raw=None)
        values['binding'] = sha256(request).hexdigest(), id(mailbox), id(stage), armed_at, ready_at, standby_deadline, members
        for name, value in values.items(): object.__setattr__(self, name, value)
        self._commit()

    def _state_sha(self):
        return digest([self.consumed, self.started, self.held_context, self.ack_raw,
            self.controller_binding, self.construction_probe, id(self.active_error), self.resource_samples, self.sampled_combined_peak_rss_bytes,
            self.conservative_combined_peak_commit_bytes, self.host_peak_pagefile_bytes, self.result_raw])

    def _commit(self): object.__setattr__(self, 'state_sha', self._state_sha())

    def check(self, *, active=False):
        require(self.creator == (os.getpid(), get_ident()) and (sha256(self.request).hexdigest(), id(self.mailbox), id(self.stage),
            self.armed_at, self.ready_at, self.standby_deadline, self.ready_members) == self.binding, 'creating armed invocation required')
        require(self._state_sha() == self.state_sha, 'held invocation state changed')
        self.stage._entry()
        require(type(self.consumed) is bool and (not active or self.consumed and type(self.started) is float), 'active one-shot invocation required')

    def close(self):
        self.check(); errors = []
        owner = self.stage.owner
        if getattr(owner, '_job', None) is not None:
            try: _stop_owned_job(owner)
            except BaseException as error: errors.append(('termination', error))
            try: owner.quiesce(max_seconds=1.)
            except BaseException as error: errors.append(('quiesce', error))
        try: self.stage.close()
        except BaseException as error: errors.append(('stage_close', error))
        try: self.mailbox.close()
        except BaseException as error: errors.append(('mailbox_close', error))
        if errors: raise InvocationUnresolved(self, errors[0][1], errors[1:])

    def __enter__(self): self.check(); return self
    def __exit__(self, *unused): self.close()
    def __reduce__(self): raise TypeError('armed invocation cannot be serialized')


def _invocation_broker_argv(mailbox, channel):
    code = ('from experiments import staged_rts24_saved_fresh_adoption_v1 as e; '
        f'e._ordinary_invocation_broker({mailbox.name!r},{mailbox.request_sha!r},{channel.name!r},{channel.nonce!r})')
    return [str(EXE), '-B', '-s', '-c', code]


def _check_broker_capture(request, mailbox, stage):
    stage._entry(); startup = parse(stage.startup); header = parse(_invocation_decode(mailbox._header))
    keys(startup, 'schema authority scope probe_id creator_pid argv command_line cwd environment_sha context_sha descriptor_sha '
        'channel_name owner_pid owner_creation_filetime actual_os_commandline_independently_verified')
    require(startup['schema'] == 'staged_saved_F_probe_CreateProcess_inputs_v1'
        and startup['authority'] == 'DRAFT_NONAUTHORITATIVE' and startup['scope'] == 'ordinary_owner_probe_only'
        and startup['probe_id'] == 'invocation_broker' and startup['creator_pid'] == header['host_identity'][0]
        and startup['argv'] == _invocation_broker_argv(mailbox, stage.channel)
        and startup['command_line'] == subprocess.list2cmdline(startup['argv']) and startup['cwd'] == request['repo_root']
        and startup['environment_sha'] == digest(request['environment']) and startup['context_sha'] == mailbox.request_sha
        and stage.channel.context_sha == mailbox.request_sha and stage.channel.descriptor == ordinary_stage_descriptor('controller', 'invocation')
        and startup['descriptor_sha'] == sha256(stage.channel.descriptor).hexdigest() and startup['channel_name'] == stage.channel.name
        and (startup['owner_pid'], startup['owner_creation_filetime']) == (stage.owner.pid, stage.owner.creation_filetime)
        == tuple(header['broker_identity']) and startup['actual_os_commandline_independently_verified'] is False,
        'exact broker capture binding differs')


def _invocation_ready_members(owner, request):
    """Bind retained identities; the owner's hidden console may have one conhost."""
    sample = owner.sample(); members = tuple(sorted(key for key in owner._members if key[0] in sample['pids']))
    require(len(members) == len(sample['pids']) and (owner.pid, owner.creation_filetime) in members and 1 <= len(members) <= 2,
        'broker ready membership differs')
    api = owner._k
    api.QueryFullProcessImageNameW.argtypes = [W.HANDLE, W.DWORD, W.LPWSTR, C.POINTER(W.DWORD)]
    api.QueryFullProcessImageNameW.restype = W.BOOL
    console = _system_console_path(api); captured = []
    for member in members:
        buffer = C.create_unicode_buffer(32768); count = W.DWORD(len(buffer))
        _native(api.QueryFullProcessImageNameW(owner._members[member], 0, buffer, C.byref(count)))
        expected = str(EXE).lower() if member == (owner.pid, owner.creation_filetime) else console
        require(buffer.value.lower() == expected, 'unexpected broker descendant before START')
        captured.append((*member, buffer.value))
    require(set(owner.job_pids()) == {row[0] for row in members}, 'ready membership changed during capture')
    return tuple(captured)


def _system_console_path(api=None):
    api = api or _stage_api()
    api.GetSystemDirectoryW.argtypes = [W.LPWSTR, W.UINT]; api.GetSystemDirectoryW.restype = W.UINT
    buffer = C.create_unicode_buffer(32768); count = api.GetSystemDirectoryW(buffer, len(buffer))
    require(0 < count < len(buffer), 'kernel system directory unavailable')
    return str(Path(buffer.value)/'conhost.exe').lower()


def _terminal_console_helpers(owner, pids):
    """Ordinary graph only; this classification never substitutes for quiet."""
    if len(pids) != 1: return None
    cache = getattr(owner, '_ordinary_console_cache', None)
    if type(cache) is ConsoleImageCache: return cache.classify(owner, pids)
    try:
        pid = next(iter(pids)); matches = [(key, handle) for key, handle in owner._members.items() if key[0] == pid]
        if len(matches) != 1: return None
        (member_pid, creation), handle = matches[0]; api = owner._k
        api.QueryFullProcessImageNameW.argtypes = [W.HANDLE, W.DWORD, W.LPWSTR, C.POINTER(W.DWORD)]
        api.QueryFullProcessImageNameW.restype = W.BOOL
        buffer = C.create_unicode_buffer(32768); count = W.DWORD(len(buffer))
        _native(api.QueryFullProcessImageNameW(handle, 0, buffer, C.byref(count)))
        if buffer.value.lower() != _system_console_path(api): return None
        return [dict(pid=member_pid, creation_filetime=creation, image_path=buffer.value, observed_at=time.monotonic())]
    except Exception: return None


def _console_image(owner, handle):
    api = owner._k
    api.QueryFullProcessImageNameW.argtypes = [W.HANDLE, W.DWORD, W.LPWSTR, C.POINTER(W.DWORD)]
    api.QueryFullProcessImageNameW.restype = W.BOOL
    buffer = C.create_unicode_buffer(32768); count = W.DWORD(len(buffer))
    _native(api.QueryFullProcessImageNameW(handle, 0, buffer, C.byref(count)))
    return buffer.value


class ConsoleImageCache:
    """One live query per retained identity; no new HANDLE or run authority."""
    def __init__(self, owner):
        self._owner_id = id(owner); self._creator = os.getpid(), get_ident()
        self._entries = {}; self._system_path = None; self._commit = digest(self._image())

    def _image(self):
        return dict(system_path=self._system_path, entries=[[list(key), *value] for key, value in sorted(self._entries.items())])

    def check(self, owner):
        require(self._creator == (os.getpid(), get_ident()) and self._owner_id == id(owner)
            and digest(self._image()) == self._commit, 'creating retained console cache required')

    def observe(self, owner, sample):
        self.check(owner)
        for key, handle in tuple(owner._members.items()):
            if key[0] == owner.pid or key[0] not in sample['pids'] or key in self._entries: continue
            status, stamp = 'unresolved', None
            try:
                if owner._k.WaitForSingleObject(handle, 0) == 258:
                    image = _console_image(owner, handle); stamp = time.monotonic()
                    if self._system_path is None:
                        system_path = _system_console_path(owner._k)
                        require(len(system_path) <= 4096, 'bounded console system path required')
                        self._system_path = system_path
                    status = 'positive' if image.lower() == self._system_path else 'negative'
            except Exception: pass
            self._entries[key] = handle, status, stamp
        self._commit = digest(self._image())

    def classify(self, owner, pids):
        try:
            self.check(owner)
            if len(pids) != 1: return None
            pid = next(iter(pids)); matches = [(key, handle) for key, handle in owner._members.items() if key[0] == pid]
            if len(matches) != 1: return None
            key, handle = matches[0]; entry = self._entries.get(key)
            if entry is None or entry[0] != handle or entry[1] != 'positive': return None
            expected = _system_console_path(owner._k)
            if self._system_path != expected or entry[2] is None or owner._k.WaitForSingleObject(handle, 0) not in (0, 258): return None
            try:
                current = _console_image(owner, handle)
                if current.lower() != expected:
                    self._entries[key] = handle, 'unresolved', entry[2]; self._commit = digest(self._image()); return None
            except OSError:
                # A signaled console process can no longer expose its image.
                # The still-retained identity/HANDLE binds the earlier query.
                pass
            return [dict(pid=key[0], creation_filetime=key[1], image_path=expected, observed_at=time.monotonic())]
        except Exception: return None

    def __reduce__(self): raise TypeError('retained console image cache cannot be serialized')


def _console_observed_factory(base):
    class ConsoleObservedChild(base):
        def __init__(self, *args, **kwargs):
            self._ordinary_console_cache = ConsoleImageCache(self)
            super().__init__(*args, **kwargs)

        def sample(self):
            value = super().sample()
            self._ordinary_console_cache.observe(self, value)
            return value
    return ConsoleObservedChild


def _stage_owner_factory(base, injected, label):
    if injected is not None: return injected
    if label in ('role_graph_parent', 'role_graph_fresh', 'invocation_broker', 'invocation_controller'):
        return _console_observed_factory(base)
    return base


def arm_ordinary_invocation(output, case='normal'):
    request = _invocation_request(output, case); value = _check_invocation_request(request)
    mailbox = channel = stage = None; started = time.monotonic()
    try:
        mailbox = InvocationMailbox.create(sha256(request).hexdigest())
        channel = StageChannel.create(mailbox.request_sha, ordinary_stage_descriptor('controller', 'invocation'))
        stage = _construct_stage_owner(_invocation_broker_argv(mailbox, channel), channel, 'invocation_broker', started=started)
        mailbox.bind(stage, request); _check_broker_capture(value, mailbox, stage); stage.owner.release()
        deadline = time.monotonic()+value['ready_seconds']
        while time.monotonic() < deadline:
            require(stage.owner.poll() is None, 'broker exited before ready')
            sample = stage.owner.sample()
            require(sample['rss_bytes'] <= channel.spec['rss_bytes'] and sample['peak_job_commit_bytes'] <= channel.spec['job_commit_bytes'], 'arming resource limit')
            ready = mailbox.read_packet('ready')
            if ready is not None:
                keys(ready, 'request_sha ready_at standby_deadline context_created')
                require(ready['request_sha'] == mailbox.request_sha and ready['context_created'] is False
                    and type(ready['ready_at']) is float and type(ready['standby_deadline']) is float
                    and math.isfinite(ready['ready_at']) and started <= ready['ready_at'] <= time.monotonic()
                    and ready['standby_deadline'] == ready['ready_at']+value['standby_seconds']
                    and time.monotonic() < ready['standby_deadline'], 'bounded broker ready differs')
                require(channel.read_available() == [] and not os.path.lexists(output), 'broker created context or progressed before START')
                members = _invocation_ready_members(stage.owner, value)
                return ArmedInvocation(request, mailbox, stage, started, time.monotonic(), ready['standby_deadline'], members)
            time.sleep(.005)
        raise TimeoutError('ordinary broker ready limit')
    except BaseException as primary:
        errors = []
        owner = stage.owner if stage is not None else getattr(primary, 'owner', None)
        if owner is not None and getattr(owner, '_job', None) is not None:
            try: _stop_owned_job(owner); owner.quiesce(max_seconds=1.)
            except BaseException as error: errors.append(('arming_quiesce', error))
        for label, item in (('stage', stage), ('channel', channel if stage is None else None), ('mailbox', mailbox)):
            if item is not None:
                try: item.close()
                except BaseException as error: errors.append((label, error))
        if owner is not None and stage is None:
            try: owner.close()
            except BaseException as error: errors.append(('partial_owner', error))
        raise InvocationUnresolved((stage, channel, mailbox, primary), primary, errors) from primary


def _host_memory(api):
    from src.staged_rts24_process_guard_v1 import _Memory
    api.K32GetProcessMemoryInfo.argtypes = [W.HANDLE, C.c_void_p, W.DWORD]
    api.K32GetProcessMemoryInfo.restype = W.BOOL
    memory = _Memory(); memory.cb = C.sizeof(memory)
    _native(api.K32GetProcessMemoryInfo(api.GetCurrentProcess(), C.byref(memory), C.sizeof(memory)))
    return dict(rss_bytes=memory.working_set, peak_pagefile_bytes=memory.peak_pagefile)


def _held_context_offer(request, started, offer, broker_identity):
    """Pure RAM comparison against independently held inputs, before ACK/spawn."""
    keys(offer, 'context context_sha context_receipt root_directories broker_identity')
    context = offer['context']; raw = canonical(context)
    require(len(raw) <= 2*1024**2 and sha256(raw).hexdigest() == offer['context_sha'], 'offered context raw SHA/cap differs')
    expected = dict(schema=ROLE_PROBE_SCHEMA, authority='DRAFT_NONAUTHORITATIVE', scope=ROLE_PROBE_SCOPE,
        repo_root=request['repo_root'], output_root=request['output_root'], output_parent_directories=request['output_parent_directories'],
        source_pins=request['source_pins'], executable=request['executable'], environment=request['environment'], fixture=request['fixture'],
        case='normal', started=started, deadline=started+8., nonce=context.get('nonce'),
        F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
    require(_hex64(context.get('nonce')) and canonical(context) == canonical(expected), 'offered context differs from independent held request')
    receipt = offer['context_receipt']; keys(receipt, 'bytes sha256 identity')
    require({key: receipt[key] for key in ('bytes', 'sha256')} == pin(raw)
        and type(receipt['identity']) is list and len(receipt['identity']) == 4
        and all(type(v) is int and v >= 0 for v in receipt['identity']) and receipt['identity'][2] == len(raw), 'offered context publication receipt differs')
    rows = offer['root_directories']
    require(type(rows) is list and rows[:-1] == request['output_parent_directories'] and len(rows[-1]) == 3
        and rows[-1][0] == request['output_root'] and all(type(v) is int and v > 0 for v in rows[-1][1:])
        and offer['broker_identity'] == list(broker_identity), 'offered output/broker identity differs')
    return raw


def _invocation_ack(mailbox, offer, started):
    header = parse(_invocation_decode(mailbox._header))
    return dict(schema=INVOCATION_SCHEMA, request_sha=mailbox.request_sha, offer_sha=digest(offer), context_sha=offer['context_sha'],
        receipt_sha=digest(offer['context_receipt']), root_directories_sha=digest(offer['root_directories']),
        broker_identity=header['broker_identity'], host_identity=header['host_identity'], started=started,
        nonce=header['direction_nonces']['host'])


def _invocation_descriptor(ack_sha):
    value = parse(ordinary_stage_descriptor('controller', 'invocation')); value['invocation_ack_sha'] = ack_sha
    return canonical(value)


def _invocation_controller_argv(mailbox, context_sha, ack_sha, channel):
    context_path = str(Path(_held_mailbox_request(mailbox)['output_root'])/'context.json')
    return ordinary_file_argv('supervise', context_path, context_sha, channel.name, channel.nonce,
        mailbox_name=mailbox.name, request_sha=mailbox.request_sha, ack_sha=ack_sha)


def _check_controller_binding(mailbox, context_sha, ack_sha, binding):
    keys(binding, 'request_sha context_sha ack_sha startup stage_nonce')
    startup = binding['startup']
    require(binding['request_sha'] == mailbox.request_sha and binding['context_sha'] == context_sha and binding['ack_sha'] == ack_sha
        and _hex64(binding['stage_nonce']) and startup['context_sha'] == context_sha
        and startup['descriptor_sha'] == sha256(_invocation_descriptor(ack_sha)).hexdigest()
        and startup['probe_id'] == 'invocation_controller'
        and startup['creator_pid'] == parse(_invocation_decode(mailbox._header))['broker_identity'][0], 'controller capture binding differs')
    class ChannelInputs:
        name, nonce = startup['channel_name'], binding['stage_nonce']
    require(startup['argv'] == _invocation_controller_argv(mailbox, context_sha, ack_sha, ChannelInputs)
        and startup['command_line'] == subprocess.list2cmdline(startup['argv']) and startup['cwd'] == str(ROOT)
        and startup['environment_sha'] == digest(_held_mailbox_request(mailbox)['environment'])
        and type(startup['owner_pid']) is int and 0 < startup['owner_pid'] < 2**32
        and type(startup['owner_creation_filetime']) is int and startup['owner_creation_filetime'] > 0,
        'controller exact startup inputs differ')
    return binding


def _held_mailbox_request(mailbox):
    raw = mailbox._accepted.get('request')
    require(raw is not None, 'already validated held mailbox request required')
    value = parse(_invocation_decode(raw))['payload']
    require(digest(value) == mailbox.request_sha, 'held mailbox request changed')
    return value


def _invocation_resources(armed, job_sample):
    armed.check(active=True); request = parse(armed.request); mailbox = armed.mailbox
    host = _host_memory(mailbox._api)
    rss = host['rss_bytes']+job_sample['rss_bytes']; commit = host['peak_pagefile_bytes']+job_sample['peak_job_commit_bytes']
    for name, value in dict(resource_samples=armed.resource_samples+1,
            sampled_combined_peak_rss_bytes=max(armed.sampled_combined_peak_rss_bytes, rss),
            conservative_combined_peak_commit_bytes=max(armed.conservative_combined_peak_commit_bytes, commit),
            host_peak_pagefile_bytes=max(armed.host_peak_pagefile_bytes, host['peak_pagefile_bytes'])).items(): object.__setattr__(armed, name, value)
    armed._commit()
    require(rss <= request['combined_sampled_rss_bytes'] and commit <= request['combined_conservative_commit_bytes'], 'combined host and owned Job resource limit')
    return dict(host=host, combined_rss_bytes=rss, conservative_combined_commit_bytes=commit, observed_at=time.monotonic())


def _invocation_poll(armed, job_sample):
    _invocation_resources(armed, job_sample)
    request = parse(armed.request); mailbox = armed.mailbox
    if armed.ack_raw is None:
        offer = mailbox.read_packet('context')
        if offer is not None:
            header = parse(_invocation_decode(mailbox._header))
            raw = _held_context_offer(request, armed.started, offer, header['broker_identity'])
            before_ack = mailbox.read_packet('binding')
            if mailbox._read_busy: return
            require(before_ack is None, 'controller constructed before host ACK')
            ack = _invocation_ack(mailbox, offer, armed.started); ack_raw = canonical(ack)
            object.__setattr__(armed, 'held_context', raw.hex()); object.__setattr__(armed, 'ack_raw', ack_raw.hex()); armed._commit()
            mailbox.write_packet('ack', ack)
    if armed.ack_raw is not None:
        probe = mailbox.read_packet('constructor_probe')
        if probe is not None:
            _accept_constructor_probe(armed, probe)
        binding = mailbox.read_packet('binding')
        if binding is not None:
            context_sha = sha256(bytes.fromhex(armed.held_context)).hexdigest(); ack_sha = sha256(bytes.fromhex(armed.ack_raw)).hexdigest()
            _check_controller_binding(mailbox, context_sha, ack_sha, binding)
            if armed.controller_binding is not None: require(canonical(binding) == bytes.fromhex(armed.controller_binding), 'held controller capture changed')
            object.__setattr__(armed, 'controller_binding', canonical(binding).hex()); armed._commit()


def _constructor_probe_value(request, request_sha, context_sha, ack_sha, started, probe):
    keys(probe, 'request_sha context_sha ack_sha phase stamp')
    require(request['case'] == 'constructor_wait' and probe['request_sha'] == request_sha
        and probe['context_sha'] == context_sha and probe['ack_sha'] == ack_sha
        and probe['phase'] == 'controller_constructor_native_wait'
        and type(probe['stamp']) is float and math.isfinite(probe['stamp']) and started <= probe['stamp'] <= time.monotonic(),
        'closed constructor native wait marker differs')
    return canonical(probe)


def _accept_constructor_probe(armed, probe):
    require(armed.held_context is not None and armed.ack_raw is not None, 'host context/ACK required before constructor marker')
    raw = _constructor_probe_value(parse(armed.request), armed.mailbox.request_sha,
        sha256(bytes.fromhex(armed.held_context)).hexdigest(), sha256(bytes.fromhex(armed.ack_raw)).hexdigest(), armed.started, probe)
    require(armed.construction_probe is None or bytes.fromhex(armed.construction_probe) == raw, 'held constructor marker changed')
    object.__setattr__(armed, 'construction_probe', raw.hex()); armed._commit()


def _final_constructor_probe(armed):
    # Caller has already established complete all-Job quiet and closed owners.
    _closed_invocation_stage(armed.stage, successful=False)
    probe = armed.mailbox.read_packet('constructor_probe', bookend=True, _wait=100)
    require(not armed.mailbox._read_busy, 'final constructor marker observation busy')
    if probe is not None: _accept_constructor_probe(armed, probe)
    elif (parse(armed.request)['case'] == 'constructor_wait' and armed.stage.last_observation['primary_stop_reason'] == 'phase_limit'
            and armed.held_context is not None and armed.ack_raw is not None):
        require(False, 'constructor wait marker absent after quiet')


def _closed_invocation_stage(stage, *, successful):
    require(type(stage) is OwnedStage, 'actual retained invocation stage required'); stage._entry()
    require(stage.real_owner and stage._attempted and type(stage.last_image) is bytes and not _role_stage_still_open(stage)
        and canonical(stage.last_observation) == stage.last_image, 'closed invocation process observation required')
    value = parse(stage.last_image)
    require(value['job_quiet_confirmed'] is True and value['owner_evidence'] == 'direct_owned_child'
        and _stage_complete_witness(stage.owner.quiescence_witness, stage.owner.pid, stage.owner.creation_filetime)
        and canonical(value['quiescence_witness']) == canonical(stage.owner.quiescence_witness), 'actual invocation all-Job quiet required')
    if successful: require(value['stage_process_observed_successfully'] is True and value['exit_code'] == 0, 'successful actual invocation process required')
    return value


def invoke_ordinary(armed):
    require(type(armed) is ArmedInvocation, 'actual armed invocation capability required')
    armed.check(); require(not armed.consumed, 'ordinary external invocation already consumed')
    object.__setattr__(armed, 'consumed', True); armed._commit()
    try:
        require(time.monotonic() < armed.standby_deadline and armed.stage.owner.poll() is None, 'armed broker standby expired')
        context_before_start = armed.mailbox.read_packet('context', bookend=True, _wait=100)
        require(not armed.mailbox._read_busy and context_before_start is None, 'pre-START context absence unknown')
        require(_invocation_ready_members(armed.stage.owner, parse(armed.request)) == armed.ready_members
            and armed.stage.channel.read_available() == [], 'armed broker progressed before invocation')
        started = time.monotonic(); object.__setattr__(armed, 'started', started); armed._commit()
        require(started < armed.standby_deadline, 'armed broker standby expired during preflight')
        armed.mailbox.write_packet('start', dict(request_sha=armed.mailbox.request_sha, started=started, context_deadline=started+8.))
        process = _watch_stage(armed.stage, absolute_deadline=started+15.3, invocation=armed)
        # A known active monitor failure owns the primary exception. Do not read
        # protocol state or issue late ACKs after the Job has been stopped.
        if armed.active_error is not None: raise armed.active_error
        _closed_invocation_stage(armed.stage, successful=False)
        _check_broker_capture(parse(armed.request), armed.mailbox, armed.stage)
        _final_constructor_probe(armed)
        value = None
        diagnostic = None
        if process['stage_process_observed_successfully']:
            require(armed.held_context is not None and armed.ack_raw is not None and armed.controller_binding is not None, 'host held context/ACK/capture missing')
            armed.mailbox.bookend()
            value = armed.mailbox.read_packet('broker_return', bookend=True)
            require(value is not None, 'broker return unavailable after actual quiet')
            _check_invocation_return(armed, value)
        elif process['primary_stop_reason'] in ('child_reported_error', 'child_exit_nonzero'):
            failure = armed.mailbox.read_packet('broker_return', bookend=True)
            if failure is not None:
                if failure.get('kind') == 'failure':
                    keys(failure, 'schema kind request_sha case phase primary cleanup F_launch_admitted '+' '.join(GATES))
                    require(failure['schema'] == INVOCATION_SCHEMA and failure['request_sha'] == armed.mailbox.request_sha
                        and failure['case'] == parse(armed.request)['case'] and failure['F_launch_admitted'] is False
                        and all(failure[k] is False for k in GATES), 'external broker diagnostic binding differs')
                    diagnostic = failure
                else: diagnostic = dict(kind='unconsumed_success_return', pin=pin(canonical(failure)))
        result = dict(schema=INVOCATION_SCHEMA, authority='DRAFT_NONAUTHORITATIVE', scope=ROLE_PROBE_SCOPE,
            ordinary_external_invocation_completed=value is not None, request_sha=armed.mailbox.request_sha,
            held_context_pin=pin(bytes.fromhex(armed.held_context)) if armed.held_context is not None else None,
            ack_sha=sha256(bytes.fromhex(armed.ack_raw)).hexdigest() if armed.ack_raw is not None else None,
            controller_binding_pin=pin(bytes.fromhex(armed.controller_binding)) if armed.controller_binding is not None else None,
            constructor_probe=parse(bytes.fromhex(armed.construction_probe)) if armed.construction_probe is not None else None,
            broker_process=process, broker_return=value, broker_diagnostic=diagnostic, armed_seconds=armed.ready_at-armed.armed_at,
            standby_seconds=started-armed.ready_at, invocation_started=started,
            resource_samples=armed.resource_samples, sampled_combined_peak_rss_bytes=armed.sampled_combined_peak_rss_bytes,
            conservative_combined_peak_commit_bytes=armed.conservative_combined_peak_commit_bytes,
            host_lifetime_peak_pagefile_bytes=armed.host_peak_pagefile_bytes, broker_job_counted_once=True,
            host_hard_resource_enforcement_proved=False, arming_interrupt_bound_proved=False, whole_F_180_seconds_proved=False,
            F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
        armed.mailbox.bookend()
        armed.mailbox.close()
        # Encode the complete payload before the resource-only final observation.
        require(len(canonical(result)) <= 131072, 'external invocation result cap')
        final_resource = _invocation_resources(armed, dict(rss_bytes=0, peak_job_commit_bytes=process['peak_job_commit_bytes']))
        result.update(resource_samples=armed.resource_samples, sampled_combined_peak_rss_bytes=armed.sampled_combined_peak_rss_bytes,
            conservative_combined_peak_commit_bytes=armed.conservative_combined_peak_commit_bytes,
            host_lifetime_peak_pagefile_bytes=armed.host_peak_pagefile_bytes,
            final_host_observation=dict(final_resource, after_payload_encoding=True, after_mailbox_close=True,
                protocol_progress_permitted=False, final_envelope_allocation_interrupt_bound_proved=False))
        require(len(canonical(result)) <= 131072, 'external invocation result cap')
        object.__setattr__(armed, 'result_raw', canonical(result).hex()); armed._commit()
        # The final envelope's encoding/storage is included in the deadline check;
        # its hard interrupt/instantaneous-memory bound remains explicitly open.
        require(time.monotonic() <= started+15.3, 'external final processing deadline')
        return result
    except BaseException as primary:
        try: armed.close()
        except BaseException as cleanup: raise InvocationUnresolved(armed, primary, (('external_close', cleanup),)) from primary
        raise InvocationUnresolved(armed, primary) from primary


def run_ordinary_invocation(output, case='normal'):
    return invoke_ordinary(arm_ordinary_invocation(output, case))


@dataclass(frozen=True, init=False)
class InvocationRelay:
    """Closed bridge between host-ACKed context and the external request channel."""
    def __init__(self, stage, upstream, mailbox, ack_sha):
        values = dict(stage=stage, upstream=upstream, mailbox=mailbox, ack_sha=ack_sha, creator=(os.getpid(), get_ident()))
        values['binding'] = id(stage), id(upstream), id(mailbox), ack_sha, stage.channel._binding_inputs, upstream._binding_inputs
        for name, value in values.items(): object.__setattr__(self, name, value)
        self.check(stage)

    def check(self, stage):
        require(self.creator == (os.getpid(), get_ident()) and self.stage is stage
            and (id(stage), id(self.upstream), id(self.mailbox), self.ack_sha, stage.channel._binding_inputs,
                self.upstream._binding_inputs) == self.binding, 'creating invocation bridge required')
        stage._entry(); self.upstream._live(); self.mailbox._live()
        ack = self.mailbox.read_packet('ack', bookend=True, _wait=100); binding = self.mailbox.read_packet('binding', bookend=True, _wait=100)
        require(ack is not None and digest(ack) == self.ack_sha and binding is not None
            and stage.channel.descriptor == _invocation_descriptor(self.ack_sha)
            and self.upstream.descriptor == ordinary_stage_descriptor('controller', 'invocation')
            and self.upstream.context_sha == self.mailbox.request_sha and not self.upstream._reader
            and stage.channel.context_sha == ack['context_sha'] and canonical(binding['startup']) == stage.startup,
            'host ACK and actual controller bridge binding differs')

    def enter(self, phase):
        require(phase in STAGE_PHASES['controller'][1:], 'closed invocation bridge phase required')
        self.upstream.enter(phase)

    def __reduce__(self): raise TypeError('live invocation relay cannot be serialized')


def _ordinary_native_wait():
    api = _stage_api(); api.Sleep.argtypes = [W.DWORD]; api.Sleep.restype = None
    api.Sleep(20000)


def _invocation_publication_wait(phase, target):
    require(Path(target).name == 'parent_observation.json', 'fixed invocation publication fault target')
    if phase == 'after_write': _ordinary_native_wait()


def _ordinary_invocation_broker(name, request_sha, stage_name, stage_nonce):
    mailbox = writer = controller = channel = None
    phase = 'bootstrap'
    try:
        mailbox = InvocationMailbox.attach(name, request_sha, 'broker')
        request = mailbox.read_packet('request', bookend=True, _wait=100); require(request is not None, 'held invocation request unavailable')
        request_raw = canonical(request); _check_invocation_request(request_raw)
        writer = StageChannel.attach(stage_name, stage_nonce, request_sha, ordinary_stage_descriptor('controller', 'invocation'))
        ready_at = time.monotonic(); standby = ready_at+request['standby_seconds']
        mailbox.write_packet('ready', dict(request_sha=request_sha, ready_at=ready_at, standby_deadline=standby, context_created=False))
        phase = 'ready'
        start = None
        while time.monotonic() < standby:
            start = mailbox.read_packet('start')
            if start is not None: break
            time.sleep(.005)
        require(start is not None, 'broker standby expired without START')
        keys(start, 'request_sha started context_deadline')
        started = start['started']
        require(start['request_sha'] == request_sha and type(started) is float and math.isfinite(started)
            and ready_at <= started <= time.monotonic() < standby and start['context_deadline'] == started+8., 'host absolute invocation start differs')
        writer.enter('prepare')
        phase = 'prepare'
        if request['case'] == 'prepare_wait': _ordinary_native_wait()
        _check_invocation_request(request_raw)
        raw = make_role_probe_context(request['output_root'], started=started); context_sha = sha256(raw).hexdigest()
        root = Path(request['output_root']); root.mkdir()
        root_directories = directories(root); receipt = _publish_role_file(root/'context.json', raw)
        phase = 'context'
        require(directories(root) == root_directories and set(root.iterdir()) == {root/'context.json'}, 'external broker context-only publication differs')
        offer = dict(context=parse(raw), context_sha=context_sha, context_receipt=receipt, root_directories=root_directories,
            broker_identity=_own_process_identity(mailbox._api))
        # The host performs this comparison independently using its own request bytes.
        _held_context_offer(request, started, parse(canonical(offer)), _own_process_identity(mailbox._api))
        mailbox.write_packet('context', offer)
        phase = 'ack'
        ack = None
        while time.monotonic() < started+3.:
            ack = mailbox.read_packet('ack')
            if ack is not None: break
            time.sleep(.005)
        require(time.monotonic() < started+3., 'host context ACK exceeded prepare deadline')
        require(ack is not None and canonical(ack) == canonical(_invocation_ack(mailbox, offer, started)), 'host exact context ACK missing or differs')
        ack_sha = digest(ack)
        phase = 'controller_constructor'
        # Construction, capture, and release all follow the committed host ACK.
        channel = StageChannel.create(context_sha, _invocation_descriptor(ack_sha))
        factory = None
        if request['case'] == 'constructor_wait':
            from src.staged_rts24_process_guard_v1 import OwnedChild
            class WaitingConstructor(OwnedChild):
                def __init__(self, *args, **kwargs):
                    mailbox.write_packet('constructor_probe', dict(request_sha=request_sha, context_sha=context_sha,
                        ack_sha=ack_sha, phase='controller_constructor_native_wait', stamp=time.monotonic()))
                    _ordinary_native_wait(); super().__init__(*args, **kwargs)
            factory = WaitingConstructor
        require(time.monotonic() < started+3., 'controller construction exceeded prepare deadline')
        controller = _construct_stage_owner(_invocation_controller_argv(mailbox, context_sha, ack_sha, channel),
            channel, 'invocation_controller', owner_factory=factory)
        binding = dict(request_sha=request_sha, context_sha=context_sha, ack_sha=ack_sha, startup=parse(controller.startup), stage_nonce=channel.nonce)
        mailbox.write_packet('binding', binding)
        relay = InvocationRelay(controller, writer, mailbox, ack_sha)
        phase = 'controller_watch'
        process = _watch_stage(controller, absolute_deadline=started+8., relay=relay, initial_phase_deadline=started+3.)
        _closed_invocation_stage(controller, successful=True)
        returned = mailbox.read_packet('controller_return', bookend=True, _wait=100)
        phase = 'controller_return'
        require(returned is not None, 'controller return unavailable after actual quiet')
        _check_controller_return(mailbox, returned, binding)
        mailbox.bookend(_wait=100)
        mailbox.write_packet('broker_return', dict(schema=INVOCATION_SCHEMA, request_sha=request_sha,
            context_sha=context_sha, ack_sha=ack_sha, binding_sha=digest(binding), controller_process=process, controller_return=returned))
        writer.enter('terminal')
        mailbox.close(); writer.close()
    except BaseException as primary:
        errors = []
        if controller is not None and _role_stage_still_open(controller):
            if getattr(controller.owner, '_job', None) is not None:
                try: _stop_owned_job(controller.owner); controller.owner.quiesce(max_seconds=1.)
                except BaseException as error: errors.append(('controller_quiesce', error))
            try: controller.close()
            except BaseException as error: errors.append(('controller_close', error))
        if channel is not None and controller is None:
            try: channel.close()
            except BaseException as error: errors.append(('controller_channel', error))
        if mailbox is not None and mailbox._view is not None and mailbox._poison is None and 'request' in locals():
            try:
                mailbox.write_packet('broker_return', dict(schema=INVOCATION_SCHEMA, kind='failure', request_sha=request_sha,
                    case=request['case'], phase=phase, primary=_stage_error(primary),
                    cleanup=[dict(layer=label, error=_stage_error(error)) for label, error in errors[:4]], F_launch_admitted=False, **GATES))
            except BaseException as error: errors.append(('broker_diagnostic', error))
        if writer is not None:
            if not writer._terminal:
                try: writer.fail('external_broker_failed')
                except BaseException as error: errors.append(('broker_signal', error))
            try: writer.close()
            except BaseException as error: errors.append(('broker_writer', error))
        if mailbox is not None:
            try: mailbox.close()
            except BaseException as error: errors.append(('broker_mailbox', error))
        raise InvocationUnresolved((mailbox, writer, controller, channel, primary), primary, errors) from primary


def _ordinary_invocation_controller(name, request_sha, context_sha, ack_sha, stage_name, stage_nonce, context_path):
    mailbox = writer = None
    try:
        mailbox = InvocationMailbox.attach(name, request_sha, 'controller')
        binding = mailbox.read_packet('binding', bookend=True, _wait=100)
        request = mailbox.read_packet('request', bookend=True, _wait=100)
        _check_controller_binding(mailbox, context_sha, ack_sha, binding)
        offer = mailbox.read_packet('context', bookend=True, _wait=100)
        start = mailbox.read_packet('start', bookend=True, _wait=100); ack = mailbox.read_packet('ack', bookend=True, _wait=100)
        require(all(value is not None for value in (request, offer, start, ack)) and digest(ack) == ack_sha
            and canonical(ack) == canonical(_invocation_ack(mailbox, offer, start['started'])), 'controller host ACK differs')
        raw = _held_context_offer(request, start['started'], offer, parse(_invocation_decode(mailbox._header))['broker_identity'])
        require(sha256(raw).hexdigest() == context_sha, 'controller held context differs')
        require(context_path == str(Path(request['output_root'])/'context.json'), 'controller fixed context path differs')
        class Inputs:
            name, nonce = stage_name, stage_nonce
        _bind_ordinary_main('supervise', context_sha, _invocation_controller_argv(mailbox, context_sha, ack_sha, Inputs), request)
        writer = StageChannel.attach(stage_name, stage_nonce, context_sha, _invocation_descriptor(ack_sha))
        writer.enter('prepare')
        context = check_role_probe_context(raw, context_sha); root = Path(context['output_root'])
        require(read(root/'context.json') == raw and list(identity(ordinary(root/'context.json'))) == offer['context_receipt']['identity']
            and [list(row) for row in directories(root)] == offer['root_directories']
            and set(root.iterdir()) == {root/'context.json'}, 'controller external context publication identity differs')
        for target in ('worker', 'worker/fresh', 'worker/fresh_parent', 'parent', 'diagnostics'): (root/target).mkdir()
        store = RoleStore(raw, context_sha, digest(_role_tree(root)), 'controller')
        result = _run_role_controller(store, writer, invocation_case=request['case'])
        require(result['ordinary_graph_completed'] is True, 'controller ordinary graph failed')
        mailbox.write_packet('controller_return', dict(schema=INVOCATION_SCHEMA, request_sha=request_sha, context_sha=context_sha,
            ack_sha=ack_sha, binding_sha=digest(binding), entry_bootstrap=_DIRECT_BOOTSTRAP.proof(), result=result))
        writer.enter('terminal'); mailbox.close(); writer.close()
    except BaseException as primary:
        errors = []
        if writer is not None:
            if not writer._terminal:
                try: writer.fail('external_controller_failed')
                except BaseException as error: errors.append(('controller_signal', error))
            try: writer.close()
            except BaseException as error: errors.append(('controller_writer', error))
        if mailbox is not None:
            try: mailbox.close()
            except BaseException as error: errors.append(('controller_mailbox', error))
        raise InvocationUnresolved((mailbox, writer, primary), primary, errors) from primary


def _check_controller_return(mailbox, value, binding):
    keys(value, 'schema request_sha context_sha ack_sha binding_sha entry_bootstrap result')
    require(value['schema'] == INVOCATION_SCHEMA and value['request_sha'] == mailbox.request_sha
        and all(value[name] == binding[name] for name in ('context_sha', 'ack_sha')) and value['binding_sha'] == digest(binding),
        'controller return capture differs')
    result = value['result']; keys(result, 'authority scope ordinary_graph_completed observation_pin input_bookends output_inventory output_root '
        'F_launch_admitted saved_P1_fresh_process_verified saved_P1_parent_adoption_verified '+' '.join(GATES))
    request = _held_mailbox_request(mailbox)
    checked_ordinary_bootstrap(value['entry_bootstrap'], 'supervise', binding['context_sha'], binding['startup']['argv'], request)
    require(result['authority'] == 'DRAFT_NONAUTHORITATIVE' and result['scope'] == ROLE_PROBE_SCOPE
        and result['ordinary_graph_completed'] is True and result['output_root'] == request['output_root']
        and all(result[name] is False for name in (*GATES, 'F_launch_admitted', 'saved_P1_fresh_process_verified', 'saved_P1_parent_adoption_verified'))
        and set(result['output_inventory']) == set(TARGETS)-{'diagnostics/failure.json'}
        and [row['stage'] for row in result['input_bookends']] == ['G0', 'G2', 'G3']
        and all(row['context_sha'] == binding['context_sha'] and row['source_sha'] == digest(request['source_pins']) for row in result['input_bookends']),
        'controller complete ordinary return differs')
    require(result['observation_pin'] == result['output_inventory']['parent/parent_observation.json']['pin'], 'controller final observation pin differs')
    return value


def _check_invocation_return(armed, value):
    keys(value, 'schema request_sha context_sha ack_sha binding_sha controller_process controller_return')
    binding = parse(bytes.fromhex(armed.controller_binding)); context_sha = sha256(bytes.fromhex(armed.held_context)).hexdigest()
    ack_sha = sha256(bytes.fromhex(armed.ack_raw)).hexdigest()
    _check_controller_binding(armed.mailbox, context_sha, ack_sha, binding)
    require(value['schema'] == INVOCATION_SCHEMA and value['request_sha'] == armed.mailbox.request_sha
        and value['context_sha'] == context_sha and value['ack_sha'] == ack_sha and value['binding_sha'] == digest(binding), 'broker return context/capture differs')
    _check_controller_return(armed.mailbox, value['controller_return'], binding)
    direct = armed.mailbox.read_packet('controller_return', bookend=True)
    require(direct is not None and canonical(direct) == canonical(value['controller_return']), 'broker copied controller return differs')
    record = value['controller_process']; outer = _closed_invocation_stage(armed.stage, successful=True)
    require(set(record) == set(outer) and canonical(record['startup']) == canonical(binding['startup'])
        and canonical(record['descriptor']) == _invocation_descriptor(ack_sha)
        and all(record[name] is True for name in ('job_quiet_confirmed', 'stage_process_observed_successfully', 'logic_path_completed',
            'quiet_witness_consistent', 'stage_transcript_complete', 'release_attempted')) and record['exit_code'] == 0
        and all(record[name] is None for name in ('primary_stop_reason', 'monitor_error', 'termination_error', 'quiesce_error',
            'close_error', 'channel_error', 'final_bookend_error', 'channel_close_error', 'relay_error')),
        'successful controller observation differs')
    startup = binding['startup']; witness = record['quiescence_witness']
    require(_stage_complete_witness(witness, startup['owner_pid'], startup['owner_creation_filetime']), 'complete controller witness required')
    identities = lambda w: {(row['pid'], row['creation_filetime']) for row in w['member_identities']}
    require(identities(witness) <= identities(outer['quiescence_witness']), 'controller members absent from external all-Job witness')
    header = record['stage_header']; expected_header = dict(schema='staged_saved_F_memory_header_v1', context_sha=context_sha,
        nonce=binding['stage_nonce'], descriptor=parse(_invocation_descriptor(ack_sha)), owner_pid=startup['owner_pid'],
        owner_creation_filetime=startup['owner_creation_filetime'], slots=STAGE_SLOTS, slot_bytes=STAGE_SLOT_BYTES)
    require(canonical(header) == canonical(expected_header), 'controller transcript header differs')
    frames = record['transcript_frames']; phases = [*STAGE_PHASES['controller'], 'terminal']; history = []
    require(type(frames) is list and len(frames) == record['frames_observed'] == len(phases), 'controller transcript count differs')
    for index, (frame, phase) in enumerate(zip(frames, phases)):
        keys(frame, 'schema sequence phase binding_sha previous_sha producer_pid producer_creation_filetime stamp error_code')
        require(frame['schema'] == 'staged_saved_F_memory_frame_v1' and type(frame['sequence']) is int and frame['sequence'] == index
            and frame['phase'] == phase and frame['error_code'] is None
            and frame['binding_sha'] == sha256(_stage_slot(canonical(header), STAGE_HEADER_COMMIT)).hexdigest()
            and frame['previous_sha'] == (sha256(canonical(frames[index-1])).hexdigest() if index else '0'*64)
            and (frame['producer_pid'], frame['producer_creation_filetime']) == (startup['owner_pid'], startup['owner_creation_filetime'])
            and type(frame['stamp']) is float and math.isfinite(frame['stamp']) and armed.started <= frame['stamp'] <= armed.started+8.,
            'controller transcript binding differs')
        history.append(_stage_slot(canonical(frame), STAGE_COMMIT))
    require(record['transcript_sha'] == sha256(b''.join(history)).hexdigest()
        and type(record['samples']) is int and record['samples'] > 0
        and record['sampled_tree_peak_rss_bytes'] <= record['descriptor']['rss_bytes']
        and record['peak_job_commit_bytes'] <= record['descriptor']['job_commit_bytes']
        and record['total_deadline'] <= armed.started+8. and record['observation_finished_at'] <= record['total_deadline']
        and record['active_io_scope'] == 'kernel_and_fixed_shared_memory_only' and record['artifact_contents_read'] is False
        and all(record[name] is False for name in (*GATES, 'F_launch_admitted', 'saved_P1_fresh_process_verified',
            'saved_P1_parent_adoption_verified', 'external_constructor_and_monitor_interrupt_bound_proved', 'terminal_publication_bound_proved')),
        'controller resource/time/authority record differs')
    return value


ORDINARY_ENTRY_SCHEMA = 'staged_saved_F_ordinary_file_bootstrap_v1'
ENTRY_MODULE_NAME = 'experiments.staged_rts24_saved_fresh_adoption_v1'


def ordinary_file_argv(role, context_path, context_sha, channel_name, channel_nonce, *,
        tree_sha=None, mailbox_name=None, request_sha=None, ack_sha=None):
    """Closed pure-RAM argv builder; no filesystem lookup or user code."""
    require(role in ('parent', 'fresh', 'supervise'), 'closed ordinary file role required')
    require(type(context_path) is str and 0 < len(context_path) <= 4096 and '\0' not in context_path,
        'bounded ordinary context path required')
    path = Path(context_path)
    require(path.is_absolute() and '..' not in path.parts and path.name == 'context.json'
        and str(path.absolute()) == context_path, 'canonical absolute context path required')
    require(_hex64(context_sha) and _hex64(channel_nonce) and type(channel_name) is str
        and channel_name.startswith(STAGE_PREFIX) and _hex64(channel_name[len(STAGE_PREFIX):]), 'closed stage transport binding required')
    fields = [('context', context_path), ('context-sha', context_sha)]
    if role == 'supervise':
        require(tree_sha is None and type(mailbox_name) is str and mailbox_name.startswith(INVOCATION_PREFIX)
            and _hex64(mailbox_name[len(INVOCATION_PREFIX):]) and _hex64(request_sha) and _hex64(ack_sha), 'closed controller transport required')
        fields += [('mailbox', mailbox_name), ('request-sha', request_sha), ('ack-sha', ack_sha)]
    else:
        require(_hex64(tree_sha) and mailbox_name is request_sha is ack_sha is None, 'closed child tree binding required')
        fields += [('tree-sha', tree_sha)]
    fields += [('channel', channel_name), ('nonce', channel_nonce)]
    return [str(EXE), '-B', '-s', str(ROOT/NEW_SOURCES[1]), '--ordinary-entry', '--'+role,
        *(token for key, value in fields for token in ('--'+key, value))]


def ordinary_file_arguments(argv):
    require(type(argv) is list and all(type(v) is str and '\0' not in v for v in argv)
        and len(argv) >= 2 and argv[0] == '--ordinary-entry', 'closed ordinary file arguments required')
    roles = {'--parent': 'parent', '--fresh': 'fresh', '--supervise': 'supervise'}
    require(argv[1] in roles, 'closed ordinary file role flag required')
    role = roles[argv[1]]
    names = ['context', 'context-sha']+(['mailbox', 'request-sha', 'ack-sha'] if role == 'supervise' else ['tree-sha'])+['channel', 'nonce']
    require(len(argv) == 2+2*len(names) and argv[2::2] == ['--'+n for n in names], 'ordinary file argument order/count differs')
    values = dict(zip(names, argv[3::2]))
    result = dict(role=role, context_path=values['context'], context_sha=values['context-sha'],
        channel_name=values['channel'], channel_nonce=values['nonce'], tree_sha=values.get('tree-sha'),
        mailbox_name=values.get('mailbox'), request_sha=values.get('request-sha'), ack_sha=values.get('ack-sha'))
    require(ordinary_file_argv(**result)[4:] == argv, 'canonical ordinary file arguments differ')
    return result


def _direct_main_shape(expected):
    main = sys.modules.get('__main__')
    require(main is not None and main is sys.modules.get(__name__) and main.__name__ == '__main__'
        and getattr(main, '__spec__', None) is None and type(getattr(main, '__file__', None)) is str
        and Path(main.__file__).absolute() == ROOT/NEW_SOURCES[1], 'direct ordinary main module required')
    require(sys.argv == expected[3:] and list(sys.orig_argv) == expected
        and Path(sys.executable).absolute() == EXE and Path.cwd().absolute() == ROOT,
        'direct ordinary argv/orig_argv/executable/cwd differs')
    require(sys.flags.dont_write_bytecode == sys.flags.no_user_site == 1 and sys.flags.hash_randomization == 0,
        'controlled ordinary interpreter flags required')
    return main


def _checked_entry_paths(paths, *, installed):
    require(type(paths) in (list, tuple) and 1 <= len(paths) <= 32
        and all(type(p) is str and 0 < len(p) <= 4096 and Path(p).is_absolute() and '..' not in Path(p).parts
            and str(Path(p).absolute()) == p for p in paths), 'absolute bounded entry search paths required')
    require(len({p.lower() for p in paths}) == len(paths), 'duplicate entry search path')
    if installed:
        require(paths[0] == str(ROOT) and all(Path(p).is_relative_to(EXE.parent) for p in paths[1:]), 'fixed ROOT-first search path required')
    else:
        require(paths[0] == str(ROOT/'experiments') and all(Path(p).is_relative_to(EXE.parent) for p in paths[1:]),
            'fixed direct-file initial search path required')
    return tuple(paths)


@dataclass(frozen=True, init=False)
class OrdinaryFileBootstrap:
    raw: bytes
    creator: tuple
    main: object
    argv: tuple
    paths: tuple
    binding: tuple

    def __init__(self, raw, main, argv, paths):
        values = dict(raw=raw, main=main, argv=tuple(argv), paths=tuple(paths), creator=(os.getpid(), get_ident()))
        values['binding'] = sha256(raw).hexdigest(), id(main), tuple(argv), tuple(paths)
        for name, value in values.items(): object.__setattr__(self, name, value)
        self.check()

    def check(self):
        require(self.creator == (os.getpid(), get_ident()) and type(self.raw) is bytes
            and (sha256(self.raw).hexdigest(), id(self.main), self.argv, self.paths) == self.binding,
            'creating ordinary bootstrap binding required')
        require(_direct_main_shape(list(self.argv)) is self.main and sys.modules.get(ENTRY_MODULE_NAME) is self.main
            and tuple(sys.path) == self.paths, 'ordinary main alias/search path/argv drift')

    def proof(self): self.check(); return parse(self.raw)
    def __reduce__(self): raise TypeError('live ordinary file bootstrap cannot be serialized')


def _bind_ordinary_main(role, context_sha, expected, context):
    global _DIRECT_BOOTSTRAP
    _ordinary_bootstrap_context(role, context)
    require(_DIRECT_BOOTSTRAP is _SAVED_BOOTSTRAP is None, 'single ordinary bootstrap required')
    main = _direct_main_shape(expected)
    existing = sys.modules.get(ENTRY_MODULE_NAME)
    require(existing is None or existing is main, 'canonical ENTRY module already occupied')
    preimports = _ordinary_preimports(main)
    require(preimports == [], 'project/science module preceded ordinary file bootstrap')
    require(all(os.environ.get(k) == context['environment'][k] for k in
        ('PYTHONDONTWRITEBYTECODE', 'PYTHONNOUSERSITE', 'PYTHONHASHSEED'))
        and not any(k in os.environ for k in ('PYTHONPATH', 'PYTHONHOME', 'PYTHONSTARTUP')), 'uncontrolled ordinary Python environment')
    require(pin(read(main.__file__)) == context['source_pins'][NEW_SOURCES[1]]
        and context['executable'] == dict(path=str(EXE), pin=pin(read(EXE, allow_links=True)), python=sys.version)
        and environment() == context['environment'], 'ordinary file source/executable/environment differs')
    initial = _checked_entry_paths(tuple(sys.path), installed=False)
    paths = _checked_entry_paths((str(ROOT), *initial[1:]), installed=True)
    # The script directory is replaced by ROOT; no project module is imported here.
    sys.path[:] = paths; sys.modules[ENTRY_MODULE_NAME] = main
    value = dict(schema=ORDINARY_ENTRY_SCHEMA, authority='DRAFT_NONAUTHORITATIVE', scope='ordinary_file_entry_self_check_only',
        role=role, context_sha=context_sha, entry_path=str(ROOT/NEW_SOURCES[1]), entry_pin=context['source_pins'][NEW_SOURCES[1]],
        executable=context['executable'], cwd=str(ROOT), argv_sha=digest(expected), orig_argv_sha=digest(list(sys.orig_argv)),
        sys_path=list(paths), sys_path_sha=digest(paths), main_is_canonical_module=True, main_spec_is_none=True,
        project_imports_before_bootstrap=preimports, project_import_scan='module_file_paths_and_project_namespaces',
        flags=dict(dont_write_bytecode=True, no_user_site=True, hash_randomization=False),
        independent_OS_commandline_verified=False, full_runtime_closure_verified=False,
        F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
    raw = canonical(value); require(len(raw) <= 16384, 'ordinary bootstrap proof cap')
    checked_ordinary_bootstrap(value, role, context_sha, expected, context)
    _DIRECT_BOOTSTRAP = OrdinaryFileBootstrap(raw, main, expected, paths)
    return _DIRECT_BOOTSTRAP


def _ordinary_bootstrap_context(role, context):
    schemas = dict(parent=ROLE_PROBE_SCHEMA, fresh=ROLE_PROBE_SCHEMA, supervise=INVOCATION_SCHEMA)
    require(role in schemas and type(context) is dict and context.get('schema') == schemas[role]
        and context.get('authority') == 'DRAFT_NONAUTHORITATIVE' and context.get('scope') == ROLE_PROBE_SCOPE
        and context.get('repo_root') == str(ROOT)
        and all(context.get(k) is False for k in (*GATES, 'F_launch_admitted', 'saved_P1_fresh_process_verified',
            'saved_P1_parent_adoption_verified')), 'closed ordinary bootstrap context required')
    return context


def _ordinary_preimports(main, *, modules=None):
    found = []
    for name, value in tuple((sys.modules if modules is None else modules).items()):
        if value is main: continue
        selected = name in ('src', 'experiments', 'tests') or name.startswith(('src.', 'experiments.', 'tests.', 'pyomo', 'highspy'))
        file = vars(value).get('__file__') if isinstance(value, ModuleType) else None
        if type(file) is str and file and not file.startswith('<'):
            selected |= Path(os.path.abspath(file)).is_relative_to(ROOT)
        if selected: found.append(name)
    return sorted(found)


def checked_ordinary_bootstrap(value, role, context_sha, argv, context):
    _ordinary_bootstrap_context(role, context)
    keys(value, 'schema authority scope role context_sha entry_path entry_pin executable cwd argv_sha orig_argv_sha '
        'sys_path sys_path_sha main_is_canonical_module main_spec_is_none project_imports_before_bootstrap project_import_scan flags '
        'independent_OS_commandline_verified full_runtime_closure_verified F_launch_admitted '
        'saved_P1_fresh_process_verified saved_P1_parent_adoption_verified '+' '.join(GATES))
    require(value['schema'] == ORDINARY_ENTRY_SCHEMA and value['authority'] == 'DRAFT_NONAUTHORITATIVE'
        and value['scope'] == 'ordinary_file_entry_self_check_only' and value['role'] == role and value['context_sha'] == context_sha
        and value['entry_path'] == str(ROOT/NEW_SOURCES[1]) and value['entry_pin'] == context['source_pins'][NEW_SOURCES[1]]
        and value['executable'] == context['executable'] and value['cwd'] == str(ROOT)
        and value['argv_sha'] == value['orig_argv_sha'] == digest(argv)
        and value['main_is_canonical_module'] is value['main_spec_is_none'] is True and value['project_imports_before_bootstrap'] == []
        and value['project_import_scan'] == 'module_file_paths_and_project_namespaces'
        and canonical(value['flags']) == canonical(dict(dont_write_bytecode=True, no_user_site=True, hash_randomization=False))
        and all(value[name] is False for name in (*GATES, 'F_launch_admitted', 'saved_P1_fresh_process_verified',
            'saved_P1_parent_adoption_verified', 'independent_OS_commandline_verified', 'full_runtime_closure_verified')),
        'ordinary file bootstrap diagnostic binding differs')
    paths = _checked_entry_paths(value['sys_path'], installed=True)
    require(value['sys_path_sha'] == digest(paths) and len(canonical(value)) <= 16384, 'ordinary bootstrap search path/proof cap differs')
    return value


def _ordinary_file_dispatch(argv):
    values = ordinary_file_arguments(argv); expected = ordinary_file_argv(**values); _direct_main_shape(expected)
    if values['role'] == 'supervise':
        return _ordinary_invocation_controller(values['mailbox_name'], values['request_sha'], values['context_sha'],
            values['ack_sha'], values['channel_name'], values['channel_nonce'], values['context_path'])
    return _ordinary_role_entry(values['role'], values['context_path'], values['context_sha'], values['tree_sha'],
        values['channel_name'], values['channel_nonce'])


def _saved_file_tokens(role, context_path, context_sha, tree_sha, channel_name, channel_nonce):
    require(role in ('parent', 'fresh'), 'saved supervise requires a separate trusted invocation')
    require(type(context_path) is str and 0 < len(context_path) <= 4096 and '\0' not in context_path,
        'bounded saved context path required')
    path = Path(context_path)
    require(path.is_absolute() and '..' not in path.parts and path.name == 'context.json'
        and str(path.absolute()) == context_path, 'canonical saved context path required')
    require(_hex64(context_sha) and _hex64(tree_sha) and _hex64(channel_nonce)
        and type(channel_name) is str and channel_name.startswith(STAGE_PREFIX)
        and _hex64(channel_name[len(STAGE_PREFIX):]), 'closed saved transport required')
    values = [('context', context_path), ('context-sha', context_sha), ('tree-sha', tree_sha),
        ('channel', channel_name), ('nonce', channel_nonce)]
    return [str(EXE), '-B', '-s', str(ROOT/NEW_SOURCES[1]), '--saved-entry', '--'+role,
        *(token for name, value in values for token in ('--'+name, value))]


def saved_file_arguments(argv):
    names = ['context', 'context-sha', 'tree-sha', 'channel', 'nonce']
    require(type(argv) is list and len(argv) == 12 and all(type(v) is str and '\0' not in v for v in argv)
        and argv[0] == '--saved-entry' and argv[1] in ('--parent', '--fresh')
        and argv[2::2] == ['--'+n for n in names], 'closed saved argument order/count required')
    role = argv[1][2:]; context_path, context_sha, tree_sha, channel_name, channel_nonce = argv[3::2]
    require(_saved_file_tokens(role, context_path, context_sha, tree_sha, channel_name, channel_nonce)[4:] == argv,
        'canonical saved arguments differ')
    return dict(role=role, context_path=context_path, context_sha=context_sha, tree_sha=tree_sha,
        channel_name=channel_name, channel_nonce=channel_nonce)


def _saved_transport(role, context_sha, tree_sha, channel_name, channel_nonce):
    # The role determines the descriptor. A caller cannot supply a different one.
    _saved_file_tokens(role, str(OUTPUT/'context.json'), context_sha, tree_sha, channel_name, channel_nonce)
    return dict(role=role, context_sha=context_sha, tree_sha=tree_sha, channel_name=channel_name,
        channel_nonce=channel_nonce, descriptor_sha=sha256(stage_descriptor(role)).hexdigest())


@dataclass(frozen=True, init=False)
class SavedFileBootstrap:
    """Held saved input binding; no lease, owner, scientific or run authority."""
    raw: bytes
    sha: str
    transport: bytes
    proof_raw: bytes
    main: object
    argv: tuple
    paths: tuple
    environment: tuple
    creator: tuple
    channel: object
    commit: str

    def __init__(self, raw, sha, transport, proof_raw, main, argv, paths):
        values = dict(raw=raw, sha=sha, transport=canonical(transport), proof_raw=proof_raw, main=main,
            argv=tuple(argv), paths=tuple(paths), environment=tuple(sorted(parse(raw)['environment'].items())),
            creator=(os.getpid(), get_ident()), channel=None)
        for name, value in values.items(): object.__setattr__(self, name, value)
        object.__setattr__(self, 'commit', digest(self._image()))
        self.check(transport['role'], raw, sha, require_channel=False)

    def _image(self):
        channel = self.channel
        endpoint = None if channel is None else (id(channel), channel.name, channel.nonce, channel.context_sha,
            sha256(channel.descriptor).hexdigest(), pin(channel._header) if type(channel._header) is bytes else None)
        return (sha256(self.raw).hexdigest(), self.sha, sha256(self.transport).hexdigest(),
            sha256(self.proof_raw).hexdigest(), id(self.main), self.argv, self.paths, self.environment, self.creator, endpoint)

    def check(self, role, raw, sha, *, tree_sha=None, require_channel=True):
        require(self.creator == (os.getpid(), get_ident()) and digest(self._image()) == self.commit
            and type(raw) is bytes and raw == self.raw and sha == self.sha == sha256(raw).hexdigest(),
            'creating saved bootstrap context required')
        value = parse(self.transport)
        require(role == value['role'] and (tree_sha is None or tree_sha == value['tree_sha']), 'saved role/tree binding differs')
        require(_DIRECT_BOOTSTRAP is None and _direct_main_shape(list(self.argv)) is self.main
            and sys.modules.get(ENTRY_MODULE_NAME) is self.main and tuple(sys.path) == self.paths,
            'saved main/alias/path/argv drift')
        _saved_environment_bookend(self.environment)
        proof = parse(self.proof_raw); entry = ROOT/NEW_SOURCES[1]
        require(list(identity(ordinary(entry))) == proof['entry_identity']
            and [list(row) for row in directories(entry.parent)] == proof['entry_parent_directories'],
            'saved entry file/parent identity drift')
        if require_channel:
            channel = self.channel
            require(type(channel) is StageChannel and not channel._reader and type(channel._header) is bytes,
                'held saved Open-only writer required')
            channel._live()
            require((channel.name, channel.nonce, channel.context_sha, sha256(channel.descriptor).hexdigest())
                == (value['channel_name'], value['channel_nonce'], self.sha, value['descriptor_sha']), 'saved endpoint binding differs')
        return self

    def bind_channel(self, channel):
        value = parse(self.transport); self.check(value['role'], self.raw, self.sha, require_channel=False)
        require(self.channel is None and type(channel) is StageChannel and not channel._reader
            and type(channel._header) is bytes, 'single saved Open-only writer required')
        channel._live()
        require((channel.name, channel.nonce, channel.context_sha, channel.descriptor)
            == (value['channel_name'], value['channel_nonce'], self.sha, stage_descriptor(value['role'])),
            'saved endpoint binding differs')
        object.__setattr__(self, 'channel', channel); object.__setattr__(self, 'commit', digest(self._image()))
        return self.check(value['role'], self.raw, self.sha)

    def proof(self):
        self.check(parse(self.transport)['role'], self.raw, self.sha)
        return parse(self.proof_raw)

    def __reduce__(self): raise TypeError('held saved bootstrap cannot be serialized')


def _held_saved_bootstrap(role, raw, sha, *, tree_sha=None, require_channel=True):
    require(type(_SAVED_BOOTSTRAP) is SavedFileBootstrap, 'creating saved file bootstrap required')
    return _SAVED_BOOTSTRAP.check(role, raw, sha, tree_sha=tree_sha, require_channel=require_channel)


def _saved_environment_bookend(expected):
    require(environment() == dict(expected) and all(os.environ.get(k) == v for k, v in expected)
        and not any(k in os.environ for k in ('PYTHONPATH', 'PYTHONHOME', 'PYTHONSTARTUP')), 'saved actual environment drift')


def _bind_saved_main(role, raw, sha, tree_sha, channel_name, channel_nonce):
    global _SAVED_BOOTSTRAP
    require(_DIRECT_BOOTSTRAP is _SAVED_BOOTSTRAP is None, 'single saved bootstrap required')
    context = check_context(raw, sha)
    require(context['output_mode'] == 'saved_P1_F_validation' and context['output_root'] == str(OUTPUT),
        'fixed saved execution input mode required')
    expected = argv_for(role, raw, sha, tree_sha=tree_sha, channel_name=channel_name, channel_nonce=channel_nonce)
    main = _direct_main_shape(expected)
    existing = sys.modules.get(ENTRY_MODULE_NAME)
    require(existing is None or existing is main, 'canonical saved ENTRY already occupied')
    require(_ordinary_preimports(main) == [], 'project/science module preceded saved bootstrap')
    require(all(os.environ.get(k) == v for k, v in context['environment'].items())
        and not any(k in os.environ for k in ('PYTHONPATH', 'PYTHONHOME', 'PYTHONSTARTUP')), 'uncontrolled saved Python environment')
    paths = _checked_entry_paths(tuple(sys.path), installed=False)
    paths = _checked_entry_paths((str(ROOT), *paths[1:]), installed=True)
    transport = _saved_transport(role, sha, tree_sha, channel_name, channel_nonce)
    entry = Path(main.__file__); entry_identity = identity(ordinary(entry)); entry_parents = directories(entry.parent)
    proof = dict(schema='staged_saved_F_file_binding_development_v1', authority='DRAFT_NONAUTHORITATIVE',
        scope='saved_entry_binding_development_only', role=role, context_sha=sha, transport_sha=digest(transport),
        entry_path=str(ROOT/NEW_SOURCES[1]), entry_pin=pin(read(entry)), entry_identity=list(entry_identity),
        entry_parent_directories=[list(row) for row in entry_parents], executable=context['executable'],
        argv_sha=digest(expected), orig_argv_sha=digest(list(sys.orig_argv)), sys_path_sha=digest(paths),
        independent_OS_commandline_verified=False, full_runtime_closure_verified=False,
        F_launch_admitted=False, saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False, **GATES)
    require(proof['entry_pin'] == context['source_pins'][NEW_SOURCES[1]], 'saved entry source bytes differ')
    require(identity(ordinary(entry)) == entry_identity and directories(entry.parent) == entry_parents,
        'saved entry identity changed during bootstrap')
    image = canonical(proof); require(len(image) <= 16384, 'saved bootstrap proof cap')
    sys.path[:] = paths; sys.modules[ENTRY_MODULE_NAME] = main
    held = SavedFileBootstrap(raw, sha, transport, image, main, expected, paths)
    _SAVED_BOOTSTRAP = held
    return held


def _open_saved_role_inputs(argv):
    """Future saved role bootstrap seam. Opens transport; never runs science."""
    values = saved_file_arguments(argv)
    require(values['context_path'] == str(OUTPUT/'context.json'), 'fixed saved context path required')
    raw = read(values['context_path'])
    held = _bind_saved_main(values['role'], raw, values['context_sha'], values['tree_sha'],
        values['channel_name'], values['channel_nonce'])
    context = parse(raw)
    require(values['context_path'] == str(Path(context['output_root'])/'context.json'), 'saved context path differs')
    store = RoleStore(raw, values['context_sha'], values['tree_sha'], values['role'])
    channel = StageChannel.attach(values['channel_name'], values['channel_nonce'], values['context_sha'], stage_descriptor(values['role']))
    try:
        held.bind_channel(channel); store.check()
        return store, held, channel
    except BaseException as primary:
        try: channel.close()
        except BaseException as cleanup:
            raise StageChannelConstructionUnresolved(channel, primary, cleanup, 'saved_binding_cleanup') from primary
        raise


@dataclass(frozen=True, init=False)
class SavedOwnerInputs:
    """Immutable constructor data, deliberately without a launch operation."""
    raw: bytes
    store: object
    reservation: tuple
    channel: object
    creator: tuple
    _attempt_state: tuple

    def __init__(self, raw, store, reservation, channel):
        for name, value in dict(raw=raw, store=store, reservation=reservation, channel=channel,
                creator=(os.getpid(), get_ident())).items(): object.__setattr__(self, name, value)
        object.__setattr__(self, '_attempt_state', (False, digest((*self._base_image(), id(None), False)), None))

    @property
    def constructor_claimed(self): return self._attempt_state[0]

    @property
    def commit(self): return self._attempt_state[1]

    def _base_image(self):
        return pin(self.raw), id(self.store), id(self.reservation), self.reservation, id(self.channel), self.creator

    def _image(self):
        return (*self._base_image(), id(self._attempt_state[2]), self.constructor_claimed)

    def immutable_entry(self):
        require(self.creator == (os.getpid(), get_ident()) and self.commit == digest(self._image()),
            'creating saved owner inputs required')
        store = self.store
        require(type(store) is RoleStore and store.creator == self.creator and store.schema == SCHEMA
            and (str(store.root), store.sha, store.tree, store.writer, store.schema) == store.binding
            and sha256(store.raw).hexdigest() == store.sha and self.reservation is store.child_reservation
            and store.child_consumed is True and digest([store.child_reservation, True]) == store.reservation_commit,
            'immutable saved store/reservation changed')
        value = parse(self.raw)
        require(value['context_sha'] == store.sha and value['tree_sha'] == digest(store.tree)
            and value['writer'] == store.writer and value['role'] == self.reservation[0]
            and canonical(value['reservation']) == canonical(list(self.reservation)), 'immutable saved input projection differs')
        return value

    def check(self):
        self.immutable_entry()
        require(self.constructor_claimed is False, 'saved constructor inputs already claimed')
        return self._unbound_bookend()

    def _unbound_bookend(self):
        value = parse(self.raw); context = _saved_owner_store(self.store, value['role'], self.reservation, consumed=True)
        _saved_owner_endpoint(self.channel, value['role'], self.store.sha)
        expected = _saved_owner_image(value['role'], context, self.store, self.reservation, self.channel)
        require(self.raw == canonical(expected), 'saved owner constructor inputs drift')
        return value

    def claim_constructor(self):
        raise ValueError('constructor claim requires the single attempt-state manager')

    def __reduce__(self): raise TypeError('saved constructor inputs cannot be serialized')


def _saved_owner_endpoint(channel, role, sha):
    require(role in ('parent', 'fresh') and type(channel) is StageChannel, 'closed saved owner role/endpoint required')
    channel._live()
    require(channel._reader and channel._header is None and channel.context_sha == sha
        and channel.descriptor == stage_descriptor(role), 'unbound saved observer endpoint required')


def _saved_owner_store(store, role, reservation, *, consumed):
    require(type(store) is RoleStore, 'held saved role store required')
    store.check(); context = check_context(store.raw, store.sha)
    _saved_environment_bookend(tuple(sorted(context['environment'].items())))
    require(context['schema'] == SCHEMA and context['output_mode'] == 'saved_P1_F_validation'
        and (store.writer, role) in (('controller', 'parent'), ('parent', 'fresh'))
        and reservation is store.child_reservation and type(reservation) is tuple
        and len(reservation) == 4 and reservation[0] == role and reservation[3] == store.creator
        and type(reservation[1]) is float and math.isfinite(reservation[1]) and _hex64(reservation[2])
        and context['invocation_started'] <= reservation[1] <= time.monotonic() <= context['deadline']
        and store.child_consumed is consumed,
        'saved store/role/reservation binding differs')
    return context


def _saved_owner_image(role, context, store, reservation, channel):
    require(context['output_mode'] == 'saved_P1_F_validation' and context['output_root'] == str(OUTPUT), 'saved owner context required')
    tree_sha = digest(store.tree)
    args = _saved_file_tokens(role, str(OUTPUT/'context.json'), store.sha, tree_sha, channel.name, channel.nonce)
    return dict(schema='staged_saved_F_owner_inputs_development_v1', authority='DRAFT_NONAUTHORITATIVE',
        scope='saved_constructor_inputs_only', role=role, context_sha=store.sha, tree_sha=tree_sha,
        writer=store.writer, reservation=list(reservation),
        argv=args, command_line=subprocess.list2cmdline(args), cwd=str(ROOT), source_sha=digest(context['source_pins']),
        executable=context['executable'], environment_sha=digest(context['environment']),
        channel_name=channel.name, channel_nonce=channel.nonce, descriptor_sha=sha256(channel.descriptor).hexdigest(),
        native_owner_constructed=False, run_authority=False, F_launch_admitted=False, **GATES)


def saved_owner_inputs(role, store, reservation, *, channel):
    context = _saved_owner_store(store, role, reservation, consumed=False)
    _saved_owner_endpoint(channel, role, store.sha)
    # Constructing one set of launch inputs spends the existing reservation.
    # A future constructor must retain this exact object and original start.
    store.consume_child(role, reservation)
    image = canonical(_saved_owner_image(role, context, store, reservation, channel))
    require(len(image) <= 16384, 'saved owner constructor input cap')
    return SavedOwnerInputs(image, store, reservation, channel)


_SAVED_LAUNCH_ISSUER = None


class _SavedLaunchIssuer:
    def __new__(cls, *args, **kwargs): raise TypeError('saved launch issuer remains closed')
    def check(self, permit, inputs): raise ValueError('saved launch issuer remains closed')


class SavedChildLaunchPermit:
    """No issuer exists in this draft. Binding state alone never authorizes launch."""
    def __new__(cls, *args, **kwargs): raise TypeError('saved launch issuer remains closed')

    def _image(self):
        return (id(self.inputs), self.input_pin, id(self.inputs.store), id(self.inputs.reservation),
            self.inputs.reservation, id(self.inputs.channel), id(self.issuer), self.creator)

    @property
    def used(self): return self.inputs.constructor_claimed and self.inputs._attempt_state[2] is self

    @property
    def commit(self): return self.binding_commit

    def _binding_entry(self, inputs, *, used):
        require(self.creator == (os.getpid(), get_ident()) and self.inputs is inputs and self.used is used
            and inputs.constructor_claimed is used and self.commit == digest(self._image())
            and self.input_pin == pin(inputs.raw), 'saved launch permit binding differs')
        inputs.immutable_entry()

    def _consume_binding(self, inputs):
        _commit_saved_attempt(inputs, self)

    def consume(self, inputs):
        issuer = _saved_launch_issuer()
        issuer.check(self, inputs)
        self._consume_binding(inputs)

    def __reduce__(self): raise TypeError('saved launch permit cannot be serialized')


def _saved_launch_issuer():
    require(type(_SAVED_LAUNCH_ISSUER) is _SavedLaunchIssuer, 'saved launch issuer remains closed')
    return _SAVED_LAUNCH_ISSUER


def construct_saved_stage(inputs, permit):
    # Check authority before production preflight, allocation or factory lookup.
    _saved_launch_issuer()
    require(type(inputs) is SavedOwnerInputs and type(permit) is SavedChildLaunchPermit, 'issued saved child permit required')
    return _construct_saved_stage(inputs, permit, None)


def _construct_saved_stage_for_test(inputs, *, script='normal'):
    return _construct_saved_stage(inputs, None, _SavedUnitConstruction(inputs, script))


_SAVED_UNIT_SCRIPTS = ('normal', 'init_early', 'init_job', 'released', 'layers', 'release', 'poll', 'sample',
    'rss', 'commit', 'fast', 'nonzero', 'no_terminal', 'descendant', 'quiesce', 'inventory', 'close')


@dataclass(frozen=True, init=False)
class _SavedUnitConstruction:
    def __init__(self, inputs, script):
        require(type(inputs) is SavedOwnerInputs, 'exact saved unit inputs required')
        require(type(script) is str and script in _SAVED_UNIT_SCRIPTS, 'closed saved unit fault script required')
        _saved_unit_code_check()
        object.__setattr__(self, 'inputs', inputs); object.__setattr__(self, 'script', script)
        object.__setattr__(self, 'identity', _own_process_identity(_stage_api()))
        object.__setattr__(self, 'creator', (os.getpid(), get_ident()))
        object.__setattr__(self, 'commit', digest((id(inputs), pin(inputs.raw), script, self.identity, self.creator)))

    def entry(self, inputs):
        require(self.creator == (os.getpid(), get_ident()) and self.inputs is inputs
            and self.commit == digest((id(inputs), pin(inputs.raw), self.script, self.identity, self.creator)),
            'creating unit constructor capability required')
        _saved_unit_code_check()
        return _SavedUnitOwner

    def __reduce__(self): raise TypeError('unit construction capability cannot be serialized')


def _saved_unit_emit(unit):
    # The only transport effect is the already bound page-file RAM endpoint.
    channel = unit.inputs.channel
    writer = StageChannel.attach(channel.name, channel.nonce, channel.context_sha, channel.descriptor)
    try:
        writer.enter('fresh')
        if unit.script != 'no_terminal': writer.enter('terminal')
    finally: writer.close()


class _SavedUnitKernel:
    def __init__(self, owner): self.owner = owner
    def TerminateJobObject(self, *args): return self.owner.kill()


class _SavedUnitOwner:
    """Fixed stub: no process, filesystem or arbitrary callback capability."""
    def __init__(self, args, *, cwd, environment, max_process_commit_bytes, max_job_commit_bytes, _unit):
        self.unit = _unit; self.calls = ['init']; self.args = tuple(args)
        self.kwargs = dict(cwd=cwd, environment=dict(environment), max_process_commit_bytes=max_process_commit_bytes,
            max_job_commit_bytes=max_job_commit_bytes)
        self.pid, self.creation_filetime = _unit.identity
        self._primary = ValueError('saved unit primary')
        self._secondary = {n:OSError(n+' secondary') for n in ('termination', 'quiesce', 'owner_close', 'channel_close')}
        self._process = self._thread = self._job = None; self._members = {}; self._released = False
        self.quiescence_witness = None; self.polls = 0
        if _unit.script == 'init_early': raise self._primary
        self._job = 1; self._k = _SavedUnitKernel(self)
        if _unit.script in ('init_job', 'layers'): raise self._primary
        if _unit.script == 'released': self._released = True

    def _live_owner(self): _saved_unit_code_check(self)
    def kill(self):
        self.calls.append('kill')
        if self.unit.script == 'layers': raise self._secondary['termination']
        return True

    def release(self):
        self.calls.append('release'); self._released = True
        if self.unit.script == 'release': raise self._primary
        _saved_unit_emit(self.unit)

    def poll(self):
        self.polls += 1
        if self.unit.script == 'poll': raise self._primary
        if self.unit.script == 'fast' or self.polls > 1: return 7 if self.unit.script == 'nonzero' else 0
        return None

    def sample(self):
        self.calls.append('sample')
        if self.unit.script == 'sample': raise self._primary
        return dict(rss_bytes=1024**3+1 if self.unit.script == 'rss' else 100,
            peak_job_commit_bytes=2*1024**3+1 if self.unit.script == 'commit' else 200,
            pids=[self.pid+1] if self.unit.script == 'descendant' else [], processes=0)

    def quiesce(self, *, max_seconds):
        self.calls.append('quiesce'); require(0 < max_seconds <= 5, 'bounded unit quiescence required')
        if self.unit.script in ('quiesce', 'layers'): raise self._secondary['quiesce']
        self.quiescence_witness = dict(observed_unique_member_handles=1, all_handles_signaled=True,
            member_identities=[dict(pid=self.pid, creation_filetime=self.creation_filetime)], total_processes=1,
            final_pids=[], active_processes=0, complete_inventory=self.unit.script != 'inventory')

    def close(self):
        self.calls.append('close')
        if self.unit.script in ('close', 'layers'): raise self._secondary['owner_close']
        self._process = self._thread = self._job = None; self._members = {}


_SAVED_UNIT_OWNER_TYPE = _SavedUnitOwner
_SAVED_UNIT_KERNEL_TYPE = _SavedUnitKernel
_SAVED_UNIT_SEAL = tuple((cls, name, getattr(cls, name), getattr(cls, name).__code__,
    getattr(cls, name).__defaults__, getattr(cls, name).__closure__) for cls, names in (
        (_SavedUnitOwner, ('__init__', '_live_owner', 'kill', 'release', 'poll', 'sample', 'quiesce', 'close')),
        (_SavedUnitKernel, ('__init__', 'TerminateJobObject'))) for name in names)
_SAVED_UNIT_EMIT_SEAL = _saved_unit_emit, _saved_unit_emit.__code__


def _saved_unit_code_check(owner=None):
    require(_SavedUnitOwner is _SAVED_UNIT_OWNER_TYPE and _SavedUnitKernel is _SAVED_UNIT_KERNEL_TYPE
        and _saved_unit_emit is _SAVED_UNIT_EMIT_SEAL[0]
        and _saved_unit_emit.__code__ is _SAVED_UNIT_EMIT_SEAL[1], 'fixed unit implementation changed')
    for cls, name, method, code, defaults, closure in _SAVED_UNIT_SEAL:
        require(getattr(cls, name) is method and method.__code__ is code and method.__defaults__ == defaults
            and method.__closure__ is closure, 'fixed unit method changed')
        if owner is not None and cls is _SAVED_UNIT_OWNER_TYPE:
            bound = getattr(owner, name)
            require(getattr(bound, '__func__', None) is method and getattr(bound, '__self__', None) is owner,
                'fixed unit instance method changed')
    if owner is not None:
        require(type(owner) is _SAVED_UNIT_OWNER_TYPE, 'fixed unit owner required')
        require(type(owner._k) is _SAVED_UNIT_KERNEL_TYPE and owner._k.owner is owner, 'fixed unit kernel required')
        method = owner._k.TerminateJobObject
        require(getattr(method, '__func__', None) is _SavedUnitKernel.TerminateJobObject
            and getattr(method, '__self__', None) is owner._k, 'fixed unit kernel method changed')


def _commit_saved_attempt(inputs, permit):
    inputs.immutable_entry()
    require(inputs.constructor_claimed is False, 'saved constructor inputs already claimed')
    if permit is not None: permit._binding_entry(inputs, used=False)
    # Permit use is derived from this exact state; there is no second ledger write.
    state = (True, digest((*inputs._base_image(), id(permit), True)), permit)
    object.__setattr__(inputs, '_attempt_state', state)


def _saved_startup_image(value, inputs, real_owner):
    return dict(schema='staged_saved_F_saved_CreateProcess_inputs_development_v1', authority='DRAFT_NONAUTHORITATIVE',
        scope='saved_child_startup_development_only', role=value['role'], creator_pid=os.getpid(),
        argv=value['argv'], command_line=value['command_line'], cwd=value['cwd'], environment_sha=value['environment_sha'],
        context_sha=value['context_sha'], tree_sha=value['tree_sha'], source_sha=value['source_sha'], executable=value['executable'],
        descriptor_sha=value['descriptor_sha'], channel_name=value['channel_name'], channel_nonce=value['channel_nonce'],
        input_image_sha=sha256(inputs.raw).hexdigest(), reservation_start=inputs.reservation[1],
        owner_pid=2**32-1, owner_creation_filetime=2**64-1,
        native_owner_constructed=real_owner, actual_os_commandline_independently_verified=False)


def _saved_constructor_bookend(inputs, value, *, owner=None):
    require(inputs.constructor_claimed is True, 'claimed saved constructor inputs required')
    inputs.immutable_entry()
    context = _saved_owner_store(inputs.store, value['role'], inputs.reservation, consumed=True)
    channel = inputs.channel; channel._live()
    require(channel._reader and channel.context_sha == inputs.store.sha and channel.descriptor == stage_descriptor(value['role'])
        and canonical(_saved_owner_image(value['role'], context, inputs.store, inputs.reservation, channel)) == inputs.raw,
        'saved constructor binding changed')
    if owner is not None:
        require(owner._released is False and type(channel._header) is bytes, 'suspended captured saved owner required')
        header = parse(_stage_decode(channel._header, STAGE_HEADER_COMMIT))
        require((header['owner_pid'], header['owner_creation_filetime']) == (owner.pid, owner.creation_filetime), 'saved captured owner differs')
    total = min(context['deadline'], inputs.reservation[1]+channel.spec['total_seconds'])
    require(time.monotonic() < total-channel.spec['quiesce_seconds']-channel.spec['terminal_seconds'], 'saved constructor active deadline')
    return context


def _cleanup_saved_owner(owner, channel, deadline):
    errors = []
    if owner is not None:
        if getattr(owner, '_job', None) is not None:
            try: _stop_owned_job(owner)
            except BaseException as error: errors.append(('termination', error))
            try:
                remaining = min(channel.spec['quiesce_seconds'], deadline-channel.spec['terminal_seconds']-time.monotonic())
                owner.quiesce(max_seconds=remaining if remaining > 0 else channel.spec['quiesce_seconds'])
            except BaseException as error: errors.append(('quiesce', error))
        try: owner.close()
        except BaseException as error: errors.append(('owner_close', error))
    try: channel.close()
    except BaseException as error: errors.append(('channel_close', error))
    return errors


class SavedStageUnresolved(StageConstructionUnresolved):
    def __init__(self, inputs, permit, owner, channel, primary, cleanup, phase, stage=None):
        self.inputs, self.permit, self.channel, self.primary = inputs, permit, channel, primary
        self.cleanup_objects, self.phase, self.stage = tuple(cleanup), phase, stage
        super().__init__(owner, primary, [dict(layer=layer, **_stage_error(error)) for layer, error in cleanup])
        self.args = ('saved stage unresolved at '+phase,)


def _saved_channel_image(channel):
    name, nonce, sha, descriptor = channel._binding_inputs
    return ((name, nonce, sha, pin(descriptor)),
        (channel.name, channel.nonce, channel.context_sha, pin(channel.descriptor)), channel._reader,
        channel._creator, pin(channel._header))


@dataclass(frozen=True, init=False)
class SavedStageBinding:
    inputs: SavedOwnerInputs
    permit: object
    owner: object
    upstream: StageChannel
    bootstrap: SavedFileBootstrap
    deadline: float
    real_owner: bool
    startup: bytes
    creator: tuple
    commit: str
    errors: tuple
    unit: object

    def __init__(self, inputs, permit, owner, startup, deadline, real_owner, unit=None):
        require(inputs.constructor_claimed is True and type(real_owner) is bool, 'claimed saved stage binding required')
        if real_owner:
            require(type(permit) is SavedChildLaunchPermit, 'consumed saved permit required')
            require(type(permit.issuer) is _SavedLaunchIssuer, 'issued saved authority identity required')
            permit._binding_entry(inputs, used=True)
            require(unit is None, 'native owner cannot carry a unit script')
        else:
            require(permit is None and type(unit) is _SavedUnitConstruction and owner.unit is unit,
                'exact unit owner capability required')
            unit.entry(inputs)
        bootstrap = _held_saved_bootstrap(inputs.store.writer, inputs.store.raw, inputs.store.sha, tree_sha=digest(inputs.store.tree))
        for name, value in dict(inputs=inputs, permit=permit, owner=owner, upstream=bootstrap.channel,
                bootstrap=bootstrap, deadline=deadline, real_owner=real_owner, startup=startup,
                creator=(os.getpid(), get_ident()), errors=(), unit=unit).items(): object.__setattr__(self, name, value)
        object.__setattr__(self, 'commit', digest(self._image()))

    def _image(self):
        return (id(self.inputs), self.inputs.commit, pin(self.inputs.raw), id(self.owner), self.owner.pid,
            self.owner.creation_filetime, id(self.inputs.channel), _saved_channel_image(self.inputs.channel),
            id(self.upstream), _saved_channel_image(self.upstream), id(self.bootstrap), self.bootstrap.commit, self.deadline,
            self.real_owner, pin(self.startup), self.creator, id(self.permit), id(self.unit),
            None if self.unit is None else (self.unit.commit, self.unit.script),
            [(layer, id(error), pin(image)) for layer, error, image in self.errors])

    def retain_error(self, layer, error):
        require(self.creator == (os.getpid(), get_ident()) and self.commit == digest(self._image()), 'creating saved error holder required')
        require(layer in ('termination', 'monitor', 'relay_active', 'relay_quiesce', 'relay_terminal',
            'quiesce', 'channel_bookend', 'owner_close', 'channel_close'), 'closed saved error layer required')
        if any(row[0] == layer for row in self.errors): return
        object.__setattr__(self, 'errors', self.errors+((layer, error, canonical(_stage_error(error))),))
        object.__setattr__(self, 'commit', digest(self._image()))

    def entry(self, held):
        require(self.creator == (os.getpid(), get_ident()) and self.commit == digest(self._image()), 'creating saved stage binding required')
        self.inputs.immutable_entry()
        if not self.real_owner:
            require(self.owner.unit is self.unit, 'original unit capability required')
            _saved_unit_code_check(self.owner); self.unit.entry(self.inputs)
        require(not held._saved_error_retention_unresolved, 'saved error retention unresolved')
        require(self.bootstrap is _SAVED_BOOTSTRAP and self.upstream is self.bootstrap.channel
            and held.owner is self.owner and held.channel is self.inputs.channel and held.startup == self.startup
            and held.real_owner is self.real_owner and held.created_at == self.inputs.reservation[1]
            and self.inputs.constructor_claimed is True, 'exact saved held owner/relay required')
        if self.real_owner:
            self.permit._binding_entry(self.inputs, used=True)

    def prewatch(self, held):
        self.entry(held)
        require(not held._attempted and self.upstream is _SAVED_BOOTSTRAP.channel
            and self.inputs.store.writer == 'parent' and self.inputs.channel.spec['role'] == 'fresh', 'saved fresh-parent relay required')
        self.upstream._live()
        require(not self.upstream._reader and self.upstream.descriptor == stage_descriptor('parent')
            and self.upstream.context_sha == self.inputs.store.sha, 'saved upstream binding differs')
        value = parse(self.inputs.raw)
        _saved_constructor_bookend(self.inputs, value, owner=self.owner)

    def __reduce__(self): raise TypeError('live saved stage binding cannot be serialized')


def _construct_saved_stage(inputs, permit, unit):
    require(type(inputs) is SavedOwnerInputs, 'exact saved owner inputs required')
    real_owner = unit is None
    if real_owner:
        issuer = _saved_launch_issuer()
        require(type(permit) is SavedChildLaunchPermit, 'issued saved child permit required')
        require(permit.issuer is issuer, 'saved issuer identity differs')
        issuer.check(permit, inputs); permit._binding_entry(inputs, used=False)
    else:
        require(permit is None and type(unit) is _SavedUnitConstruction, 'injected unit saved construction capability required')
        owner_factory = unit.entry(inputs)
    inputs.immutable_entry()
    require(inputs.constructor_claimed is False, 'saved constructor inputs already claimed')
    owner = None; channel = inputs.channel; phase = 'claim'
    deadline = parse(inputs.store.raw)['deadline']
    try:
        _commit_saved_attempt(inputs, permit)
        value = inputs._unbound_bookend()
        context = _saved_constructor_bookend(inputs, value)
        startup = _saved_startup_image(value, inputs, real_owner)
        require(len(canonical(startup)) <= 16384, 'saved startup image cap')
        if real_owner:
            from src.staged_rts24_process_guard_v1 import OwnedChild
            factory = OwnedChild
        else: factory = unit.entry(inputs)
        phase = 'constructor'; owner = object.__new__(factory)
        spawn_args, spawn_environment = list(value['argv']), dict(context['environment'])
        factory.__init__(owner, spawn_args, cwd=ROOT, environment=spawn_environment,
            max_process_commit_bytes=channel.spec['process_commit_bytes'], max_job_commit_bytes=channel.spec['job_commit_bytes'],
            **({} if real_owner else {'_unit':unit}))
        require(spawn_args == value['argv'] and spawn_environment == context['environment'], 'saved passed argv/environment changed')
        phase = 'bind_owner'; channel.bind_owner(owner)
        startup.update(owner_pid=owner.pid, owner_creation_filetime=owner.creation_filetime)
        phase = 'startup_encode'; raw = canonical(startup); require(len(raw) <= 16384, 'saved captured startup cap')
        phase = 'post_capture_bookend'; _saved_constructor_bookend(inputs, value, owner=owner)
        binding = SavedStageBinding(inputs, permit, owner, raw, deadline, real_owner, unit)
        return OwnedStage(owner, channel, raw, inputs.reservation[1], real_owner, domain='saved', launch_binding=binding)
    except BaseException as primary:
        cleanup = _cleanup_saved_owner(owner, channel, deadline)
        raise SavedStageUnresolved(inputs, permit, owner, channel, primary, cleanup, phase) from primary


def watch_saved_stage(held):
    require(type(held) is OwnedStage, 'exact saved retained stage required')
    try:
        require(held.domain == 'saved' and type(held.launch_binding) is SavedStageBinding, 'exact saved binding required')
        held._entry()
    except BaseException as primary:
        raise SavedStageEntryUnresolved(held, primary) from primary
    binding = held.launch_binding
    try:
        binding.prewatch(held)
        return _watch_owned_stage(held, relay=binding.upstream, absolute_deadline=binding.deadline)
    except BaseException as primary:
        cleanup = []
        if not held._attempted:
            try: held._entry()
            except BaseException as entry_error:
                raise SavedStageEntryUnresolved(held, primary, entry_error) from primary
            object.__setattr__(held, '_attempted', True)
            cleanup = _cleanup_saved_owner(held.owner, held.channel, binding.deadline)
        raise SavedStageUnresolved(binding.inputs, binding.permit, binding.owner, binding.inputs.channel,
            primary, cleanup, 'watch', stage=held) from primary


class SavedStageEntryUnresolved(RuntimeError):
    def __init__(self, stage, primary, entry_error=None):
        self.stage, self.owner, self.channel, self.primary = stage, stage.owner, stage.channel, primary
        self.entry_error = primary if entry_error is None else entry_error
        self.ownership_validated = False
        super().__init__('saved stage entry identity unresolved; original stage retained')

    def __reduce__(self): raise TypeError('unresolved saved entry cannot be serialized')


def saved_stage_process_record(held):
    require(type(held) is OwnedStage and held.domain == 'saved', 'saved retained observation required')
    held._entry(); require(held._attempted and type(held.last_image) is bytes, 'saved terminal record unavailable')
    value = parse(held.last_image)
    keys(value, 'schema authority scope owner_evidence startup descriptor exit_code primary_stop_reason monitor_error '
        'termination_requested termination_call_succeeded termination_error quiesce_error close_error channel_error '
        'final_bookend_error channel_close_error quiet_witness_consistent relay_error job_quiet_confirmed quiescence_witness '
        'stage_process_observed_successfully logic_path_completed stage_transcript_complete frames_observed phases_observed '
        'transcript_sha stage_header transcript_frames samples sampled_tree_peak_rss_bytes terminal_tree_rss_bytes peak_job_commit_bytes '
        'release_attempted terminal_system_helpers construction_seconds observation_seconds remaining_total_seconds total_deadline terminal_accepted '
        'terminal_exit_deadline terminal_exit_cap_seconds terminal_exit_limiting_deadline root_exit_observed_at termination_requested_at '
        'quiesce_started_at quiesce_completed_at close_attempts_finished_at observation_finished_at active_io_scope artifact_contents_read '
        'external_constructor_and_monitor_interrupt_bound_proved terminal_publication_bound_proved clock poll_interval_seconds '
        'F_launch_admitted saved_P1_fresh_process_verified saved_P1_parent_adoption_verified '+' '.join(GATES))
    require(value['schema'] == 'staged_saved_F_saved_child_process_development_v1'
        and value['scope'] == 'saved_retained_child_stage_development_only' and value['authority'] == 'DRAFT_NONAUTHORITATIVE'
        and canonical(value['startup']) == held.startup and value['descriptor'] == held.channel.spec
        and value['owner_evidence'] == ('direct_owned_child' if held.real_owner else 'injected_unit_owner')
        and canonical(value['stage_header']) == _stage_decode(held.channel._header, STAGE_HEADER_COMMIT)
        and value['transcript_sha'] == sha256(b''.join(held.channel._history)).hexdigest()
        and value['transcript_frames'] == [parse(_stage_decode(s, STAGE_COMMIT)) for s in held.channel._history]
        and all(value[k] is False for k in (*GATES, 'F_launch_admitted', 'saved_P1_fresh_process_verified', 'saved_P1_parent_adoption_verified')),
        'saved observation record binding differs')
    return value


def read_saved_after_quiet(store, name, held):
    record = saved_stage_process_record(held)
    binding = held.launch_binding
    require(held.real_owner and binding.real_owner and binding.inputs.store is store
        and record['stage_process_observed_successfully'] is record['job_quiet_confirmed'] is True
        and held.owner._process is held.owner._job is held.owner._thread is None and not held.owner._members
        and _stage_complete_witness(held.owner.quiescence_witness, held.owner.pid, held.owner.creation_filetime)
        and canonical(held.owner.quiescence_witness) == canonical(record['quiescence_witness'])
        and held.channel._view is held.channel._map is held.channel._mutex is None,
        'closed real saved owner quiet required before content')
    require(store.writer == 'parent' and name in TARGETS and name.startswith('worker/fresh/'), 'saved child target required')
    _saved_owner_store(store, 'fresh', binding.inputs.reservation, consumed=True)
    store.accounting(); raw = read(store.root/name)
    require(len(raw) <= role_target_caps()[name], 'saved child target cap')
    store.accounting(); return raw


EXPECTATION_SCHEMA = 'staged_saved_P1_caller_expectation_development_v1'
EXPECTATION_CONTEXT_SCHEMA = 'staged_saved_P1_expectation_context_development_v1'
EXPECTATION_ADAPTER_PIN = dict(bytes=17247, sha256='26b919e385f9d7042587db490dab694fc5bf1643665ab4bf94a1c9bac8087396')
EXPECTATION_SOURCE_RAW_CAP = 2*1024**2
EXPECTATION_FILES = tuple(sorted(('launcher.json', 'trusted_binding.json', 'start.json', 'request_schedule.json', 'fresh.json',
    *(f'trusted_prefixes/prefix_{n:06d}.json' for n in range(6)),
    *(f'points/point_{n:04d}/{leaf}.json' for n in range(1, 22) for leaf in ('request', 'result')))))


def _expectation_binding_entry(binding):
    adapter, functions = binding
    require(sys.modules.get('src.staged_rts24_saved_fresh_adoption_v1') is adapter
        and Path(adapter.__file__).absolute() == ROOT/NEW_SOURCES[0], 'canonical expectation adapter required')
    for module, name, function, code, defaults, kwdefaults in functions:
        require(getattr(module, name) is function and type(function) is FunctionType
            and function.__globals__ is vars(module) and function.__code__ is code
            and function.__defaults__ == defaults and canonical(function.__kwdefaults__) == kwdefaults
            and function.__closure__ is None, 'fixed expectation callable changed')
    return adapter


def _expectation_adapter(expected):
    require(type(expected) is dict and expected.get(NEW_SOURCES[0]) == EXPECTATION_ADAPTER_PIN,
        'frozen expectation projection dependency required')
    adapter = binding = primary = None
    try:
        names = source_names()
        require(len(names) == 49 and set(names) == set(expected), 'closed expectation source set required')
        for value in expected.values():
            keys(value, 'bytes sha256')
            require(type(value['bytes']) is int and 0 <= value['bytes'] <= 8*1024**2,
                'expectation source size differs')
        require(sum(value['bytes'] for value in expected.values()) <= EXPECTATION_SOURCE_RAW_CAP,
            'expectation source raw byte cap')
        source_bytes = {}
        for name in names:
            raw = read(ROOT/name)
            require(pin(raw) == expected[name], 'expectation initial source differs')
            source_bytes[name] = raw
        require({name:pin(raw) for name,raw in source_bytes.items()} == expected
            and Path(sys.executable).absolute() == EXE, 'expectation source/runtime differs')
        from src import staged_rts24_saved_fresh_adoption_v1 as adapter
        dependencies = [(adapter, n) for n in ('hold', 'capture', 'bookend', 'caller_image', 'sources', 'validate_metrics')]
        dependencies += [(adapter.core, 'load_fixture'), (adapter.mechanical, 'inventory'),
            (adapter.codec, 'read_bytes'), (adapter.prefix.point, '_outer')]
        compiled = {}; functions = []
        for module, name in dependencies:
            path = Path(module.__file__).absolute(); relative = path.relative_to(ROOT).as_posix()
            require(relative in source_bytes, 'expectation callable source path differs')
            raw = source_bytes[relative]
            require(pin(raw) == expected[relative], 'expectation callable source differs')
            if relative not in compiled:
                unit = compile(raw, str(path), 'exec', dont_inherit=True, optimize=sys.flags.optimize)
                compiled[relative] = {c.co_name:c for c in unit.co_consts if type(c) is CodeType}
            function = getattr(module, name)
            require(type(function) is FunctionType and function.__globals__ is vars(module)
                and function.__code__ == compiled[relative][name] and function.__closure__ is None,
                'original fixed expectation callable required')
            if module is adapter and name == 'bookend':
                require(function.__defaults__ is None and function.__kwdefaults__ == {'inventory':True}, 'full bookend default required')
            elif module is adapter:
                require(function.__defaults__ is function.__kwdefaults__ is None, 'fixed adapter defaults required')
            functions.append((module, name, function, function.__code__, function.__defaults__, canonical(function.__kwdefaults__)))
        binding = adapter, tuple(functions)
        require(_expectation_binding_entry(binding) is adapter and adapter.P1 == P1 and adapter.SCOPE == SCOPE,
            'fixed expectation input scope required')
    except BaseException as error:
        primary = error
    errors = []
    try:
        if adapter is None:
            require(source_pins() == expected, 'expectation source final differs')
        else:
            adapter.sources(expected)
    except BaseException as error:
        errors.append(('source_final',error))
    if errors: raise SavedExpectationUnresolved(primary,errors) from primary
    if primary is not None: raise primary
    return binding


def _expectation_metadata(root, expected_files):
    root = Path(root).absolute(); root_chain = directories(root)
    files = {}; folders = {}; aliases = set(); entries = total = 0
    def walk(path, depth):
        nonlocal entries, total
        require(depth <= 12, 'expectation metadata depth cap')
        info = ordinary(path, directory=True); folders[path.relative_to(root).as_posix()] = info.st_dev, info.st_ino
        with os.scandir(path) as stream:
            for item in stream:
                entries += 1; require(entries <= 16384, 'expectation metadata entry cap')
                child = Path(item.path); name = child.relative_to(root).as_posix(); folded = name.casefold()
                require(folded not in aliases, 'expectation metadata case alias'); aliases.add(folded)
                if item.is_dir(follow_symlinks=False): walk(child, depth+1)
                else:
                    info = ordinary(child); require(name in expected_files, 'unexpected expectation input file')
                    require(info.st_size == expected_files[name]['bytes'] and info.st_size <= 8*1024**2,
                        'expectation file size differs')
                    files[name] = identity(info); total += info.st_size
                    require(len(files) <= 683 and total <= 2950863, 'expectation input metadata cap')
    walk(root, 0)
    require(set(files) == set(expected_files) and directories(root) == root_chain, 'expectation metadata set/root differs')
    return dict(files=files, directories=folders)


def _expectation_read(root, name, expected_pin, expected_identity):
    path = Path(root)/name; parent = directories(path.parent); before = identity(ordinary(path))
    require(before == expected_identity and before[2] <= 8*1024**2, 'expectation file changed before read')
    with path.open('rb') as stream:
        require(identity(os.fstat(stream.fileno())) == before, 'expectation handle changed before read')
        raw = stream.read(before[2]+1)
        require(identity(os.fstat(stream.fileno())) == before, 'expectation handle changed during read')
    require(identity(ordinary(path)) == before and directories(path.parent) == parent and pin(raw) == expected_pin,
        'expectation file/parent/pin changed after read')
    return raw


class SavedExpectationUnresolved(ValueError):
    def __init__(self, primary, bookend_errors):
        self.primary, self.bookend_errors = primary, tuple(bookend_errors)
        super().__init__('saved expectation projection/bookend unresolved')
    def __reduce__(self): raise TypeError('local expectation errors cannot be serialized')


@dataclass(frozen=True, init=False, eq=False)
class SavedCallerExpectation:
    raw: bytes
    image: bytes
    creator: tuple
    commit: str
    def __new__(cls, *args, **kwargs): raise TypeError('capture a caller expectation explicitly')

    def _image(self): return pin(self.raw), pin(self.image), self.creator

    def entry(self):
        require(type(self) is SavedCallerExpectation and self.creator == (os.getpid(), get_ident())
            and self.commit == digest(self._image()), 'creating immutable caller expectation required')
        return self

    def __reduce__(self): raise TypeError('caller expectation has no transferable authority')


def capture_saved_expectation(expected_sources):
    """Expected data only: 53 pinned reads and metadata, never a full-content witness."""
    require(type(expected_sources) is dict, 'closed expected source data required')
    source = parse(canonical(expected_sources)); binding = _expectation_adapter(source)
    adapter = _expectation_binding_entry(binding); anchor = P1.parent/'p1_execution_review_01/postcheck_03.stdout.json'
    anchor_id = identity(ordinary(anchor)); anchor_dirs = directories(anchor.parent); root_dirs = directories(P1)
    anchor_raw = read(anchor); require(sha256(anchor_raw).hexdigest() == ANCHOR_SHA, 'expectation external anchor differs')
    files = json.loads(anchor_raw)['p1_files']
    require(type(files) is dict and len(files) == 683 and sum(p['bytes'] for p in files.values()) == 2950863,
        'closed expected P1 catalog required')
    require(len(EXPECTATION_FILES) == 53 and set(EXPECTATION_FILES) <= set(files), 'fixed expectation read set differs')
    before = _expectation_metadata(P1, files)
    def bookends():
        errors = []
        try:
            require(read(anchor) == anchor_raw and identity(ordinary(anchor)) == anchor_id
                and directories(anchor.parent) == anchor_dirs, 'expectation anchor bookend differs')
        except BaseException as error: errors.append(('anchor', error))
        try:
            require(directories(P1) == root_dirs and _expectation_metadata(P1, files) == before,
                'expectation metadata bookend differs')
        except BaseException as error: errors.append(('metadata', error))
        try: _expectation_binding_entry(binding); adapter.sources(source)
        except BaseException as error: errors.append(('source', error))
        return errors
    try:
        raw = {n:_expectation_read(P1, n, files[n], before['files'][n]) for n in EXPECTATION_FILES}
        fixture = adapter.core.load_fixture(); outer = parse(raw['launcher.json']); trusted = parse(raw['trusted_binding.json'])
        adapter.prefix.point._outer(outer); start = parse(raw['start.json'])
        bindings = tuple(parse(raw[f'trusted_prefixes/prefix_{n:06d}.json']) for n in range(6))
        expected = dict(fixture_sha=adapter.core.digest(fixture), initial_state_sha=bindings[0]['known_state_sha'],
            after_state_shas=tuple(row['known_state_sha'] for row in bindings[1:]), pins_sha=adapter.core.digest(start['pins']),
            registration_sha=start['registration_sha'], slots=tuple(parse(raw['request_schedule.json'])[:21]),
            point_files={str(i):{n[len(f'points/point_{i:04d}/'):]:p for n,p in files.items()
                if n.startswith(f'points/point_{i:04d}/')} for i in range(1,22)})
        metrics = parse(raw['fresh.json'])['metrics']; adapter.validate_metrics(metrics)
        refs = [dict(ordinal=i, role=expected['slots'][i-1]['role'],
            query_sha=parse(raw[f'points/point_{i:04d}/request.json'])['query_sha'],
            evidence_ref=parse(raw[f'points/point_{i:04d}/result.json'])['evidence_ref']) for i in range(1,22)]
        projection = SimpleNamespace(files=files, fixture=fixture, outer=outer, trusted=trusted, expectations=expected,
            bindings=bindings, source=source, anchor_raw=anchor_raw, anchor_identity=anchor_id,
            anchor_directories=anchor_dirs, root_directories=root_dirs,
            inventory=dict(pins=files, **before), historical_metrics=metrics, expected_evidence_refs=refs)
        image = adapter.caller_image(projection)
    except BaseException as primary:
        errors = bookends()
        if errors: raise SavedExpectationUnresolved(primary, errors) from primary
        raise
    errors = bookends()
    if errors: raise SavedExpectationUnresolved(None, errors)
    value = dict(schema=EXPECTATION_SCHEMA, authority='DRAFT_NONAUTHORITATIVE', scope=SCOPE,
        caller_expectation_core=parse(image), caller_expectation_sha=sha256(image).hexdigest(),
        source_sha=digest(source), input_pins_sha=digest(files), content_read_files=list(EXPECTATION_FILES),
        metadata_passes=2, full_P1_content_verified=False, F_launch_admitted=False, **GATES)
    encoded = canonical(value); require(len(encoded) <= 2*1024**2 and len(image) <= 2*1024**2, 'expectation data byte cap')
    result = object.__new__(SavedCallerExpectation)
    for name, item in dict(raw=encoded, image=image, creator=(os.getpid(),get_ident())).items(): object.__setattr__(result,name,item)
    object.__setattr__(result,'commit',digest(result._image()))
    return result.entry()


def validate_expectation_context(value):
    keys(value, 'schema authority scope repo_root input_root output_root output_mode output_parent_directories source_pins '
        'executable environment anchor_sha input_files invocation_started deadline stage_seconds limits inherited_sources_pin '
        'caller_expectation_core caller_expectation_sha expectation_sha full_P1_content_verified '+' '.join(GATES))
    require(value['schema'] == EXPECTATION_CONTEXT_SCHEMA and value['authority'] == 'DRAFT_NONAUTHORITATIVE'
        and value['scope'] == SCOPE and value['full_P1_content_verified'] is False
        and all(value[n] is False for n in GATES), 'expectation context domain differs')
    require(value['repo_root'] == str(ROOT) and value['input_root'] == str(P1), 'expectation fixed roots differ')
    output = Path(value['output_root']); mode = output_mode(output)
    require(output.is_absolute() and str(output.absolute()) == str(output) and '..' not in output.parts
        and not output.is_relative_to(P1) and not P1.is_relative_to(output)
        and value['output_mode'] == {'saved_P1_F_validation':'saved_P1_expectation_only',
            'ordinary_pytest_fixture':'ordinary_expectation_fixture'}[mode], 'expectation output mode differs')
    require(value['output_parent_directories'] == [list(row) for row in directories(output.parent)], 'expectation output parent differs')
    require(value['stage_seconds'] == STAGE_SECONDS and value['limits'] == CAPS, 'expectation budget differs')
    require(type(value['invocation_started']) is float and math.isfinite(value['invocation_started'])
        and 0 < value['invocation_started'] <= time.monotonic() and type(value['deadline']) is float
        and value['deadline'] == value['invocation_started']+180, 'expectation absolute clock differs')
    core = value['caller_expectation_core']
    keys(core,'files fixture_sha outer trusted expectations bindings source anchor_path anchor_pin anchor_identity '
        'anchor_directories root_directories historical_metrics expected_evidence_refs inventory')
    keys(core['inventory'],'pins files directories')
    require(type(value['source_pins']) is dict and type(value['input_files']) is dict
        and value['caller_expectation_sha'] == digest(core)
        and core['files'] == value['input_files'] and core['source'] == value['source_pins']
        and value['anchor_sha'] == ANCHOR_SHA and _hex64(value['expectation_sha']), 'expectation core binding differs')
    require(set(value['source_pins']) == set(source_names()) and len(value['input_files']) == 683, 'expectation source/input set differs')
    for item in tuple(value['source_pins'].values())+tuple(value['input_files'].values())+(value['inherited_sources_pin'],):
        keys(item,'bytes sha256')
        require(type(item['bytes']) is int and 0 <= item['bytes'] <= 8*1024**2 and _hex64(item['sha256']), 'expectation pin shape differs')
    keys(value['executable'],'path pin identity python'); keys(value['executable']['pin'],'bytes sha256')
    require(value['executable']['path'] == str(EXE) and value['executable']['python'] == sys.version
        and type(value['executable']['pin']['bytes']) is int and 0 < value['executable']['pin']['bytes'] <= 8*1024**2
        and _hex64(value['executable']['pin']['sha256']) and type(value['executable']['identity']) is list
        and len(value['executable']['identity']) == 4 and all(type(n) is int and n >= 0 for n in value['executable']['identity'])
        and type(value['environment']) is dict and all(type(k) is type(v) is str for k,v in value['environment'].items()),
        'expectation executable/environment differs')
    require(len(canonical(value)) <= 2*1024**2, 'expectation context byte cap')
    return value


def check_expectation_context(raw, expected_sha):
    require(type(raw) is bytes and _hex64(expected_sha) and sha256(raw).hexdigest() == expected_sha, 'expectation context SHA differs')
    value = validate_expectation_context(parse(raw))
    require(Path.cwd().absolute() == ROOT and Path(sys.executable).absolute() == EXE
        and source_pins() == value['source_pins'] and environment() == value['environment'], 'expectation live source/runtime differs')
    require(pin(read(INHERITED)) == value['inherited_sources_pin'], 'expectation inherited source catalog differs')
    anchor = read(P1.parent/'p1_execution_review_01/postcheck_03.stdout.json')
    require(sha256(anchor).hexdigest() == ANCHOR_SHA and json.loads(anchor)['p1_files'] == value['input_files'], 'expectation anchor map differs')
    require(pin(read(EXE, allow_links=True)) == value['executable']['pin']
        and list(identity(ordinary(EXE, allow_links=True))) == value['executable']['identity'], 'expectation executable changed')
    require(time.monotonic() <= value['deadline'], 'expectation context expired')
    return value


def context_from_saved_expectation(expectation, output_root, *, started):
    require(type(expectation) is SavedCallerExpectation, 'exact expectation data required')
    expectation.entry(); core = parse(expectation.image); source = source_pins()
    require(core['source'] == source and type(started) is float and math.isfinite(started)
        and 0 < started <= time.monotonic(), 'current expectation/start required')
    output = Path(output_root).absolute(); mode = output_mode(output)
    require(not os.path.lexists(output), 'dedicated expectation output already exists')
    value = dict(schema=EXPECTATION_CONTEXT_SCHEMA, authority='DRAFT_NONAUTHORITATIVE', scope=SCOPE,
        repo_root=str(ROOT), input_root=str(P1), output_root=str(output),
        output_mode={'saved_P1_F_validation':'saved_P1_expectation_only', 'ordinary_pytest_fixture':'ordinary_expectation_fixture'}[mode],
        output_parent_directories=[list(row) for row in directories(output.parent)], source_pins=source,
        executable=dict(path=str(EXE), pin=pin(read(EXE,allow_links=True)),
            identity=list(identity(ordinary(EXE,allow_links=True))), python=sys.version), environment=environment(),
        anchor_sha=ANCHOR_SHA, input_files=core['files'], invocation_started=started, deadline=started+180,
        stage_seconds=dict(STAGE_SECONDS), limits=dict(CAPS), inherited_sources_pin=pin(read(INHERITED)),
        caller_expectation_core=core, caller_expectation_sha=sha256(expectation.image).hexdigest(),
        expectation_sha=sha256(expectation.raw).hexdigest(), full_P1_content_verified=False, **GATES)
    raw = canonical(validate_expectation_context(value)); check_expectation_context(raw,sha256(raw).hexdigest())
    expectation.entry(); return raw


@dataclass(frozen=True, init=False, eq=False, repr=False)
class VerifiedSavedInput:
    expectation: SavedCallerExpectation
    context_raw: bytes
    context_sha: str
    _held: object
    held_image_sha: str
    stage: str
    creator: tuple
    binding: tuple
    commit: str
    _state: tuple
    real_verified: bool
    def __new__(cls, *args, **kwargs): raise TypeError('verify local saved input explicitly')

    def _image(self):
        return (id(self.expectation), pin(self.expectation.raw), pin(self.context_raw), self.context_sha,
            id(self._held), self.held_image_sha, self.stage, self.creator, id(self.binding), self.real_verified)

    def _identity_entry(self):
        require(type(self) is VerifiedSavedInput and self.creator == (os.getpid(),get_ident())
            and self.commit == digest(self._image()) and self.real_verified is False, 'creating local input probe required')
        self.expectation.entry(); adapter = _expectation_binding_entry(self.binding)
        require(type(self._held) is adapter.HeldInput and self._held.image == self.expectation.image
            and sha256(self._held.image).hexdigest() == self.held_image_sha
            and adapter.caller_image(self._held) == self._held.image, 'exact immutable probe HeldInput required')
        require(set(self._held.inventory['raw']) == set(self._held.files)
            and all(pin(raw) == self._held.files[n] for n,raw in self._held.inventory['raw'].items()), 'probe raw snapshot changed')
        return self

    def entry(self):
        self._identity_entry()
        require(self._state[1] == digest((self._state[0], id(self._state[2])))
            and self._state[2] is None, 'verified input bookend is unresolved')
        return self

    def __reduce__(self): raise TypeError('verified local input cannot be serialized')


def _probe_saved_expectation_input(expectation, context_raw, context_sha, *, stage):
    """Ordinary local probe only; production G0/H3 awaits trusted-role/global closure."""
    require(type(expectation) is SavedCallerExpectation and type(stage) is str and stage in ('G0','H3'), 'expectation and closed input verification stage required')
    expectation.entry(); context = check_expectation_context(context_raw,context_sha)
    require(context['output_mode'] == 'ordinary_expectation_fixture'
        and context['expectation_sha'] == sha256(expectation.raw).hexdigest()
        and canonical(context['caller_expectation_core']) == expectation.image, 'verification expectation/context differs')
    binding = _expectation_adapter(context['source_pins']); adapter = _expectation_binding_entry(binding)
    held = None; primary = None; final_errors = []
    try:
        held = adapter.hold(context['source_pins'], expectation.image)
        require(type(held) is adapter.HeldInput and held.image == expectation.image, 'full original local probe required')
    except BaseException as error: primary = error
    try: _expectation_binding_entry(binding)
    except BaseException as error: final_errors.append(('binding_final',error))
    try: expectation.entry()
    except BaseException as error: final_errors.append(('expectation_final',error))
    try: check_expectation_context(context_raw,context_sha)
    except BaseException as error: final_errors.append(('context_final',error))
    if final_errors: raise SavedExpectationUnresolved(primary,final_errors) from primary
    if primary is not None: raise primary
    result = object.__new__(VerifiedSavedInput)
    for name,value in dict(expectation=expectation, context_raw=context_raw,context_sha=context_sha,_held=held,
            held_image_sha=sha256(held.image).hexdigest(),stage=stage,creator=(os.getpid(),get_ident()),binding=binding,
            real_verified=False).items():
        object.__setattr__(result,name,value)
    object.__setattr__(result,'commit',digest(result._image()))
    object.__setattr__(result,'_state',((),digest(((),id(None))),None))
    result.entry(); return result


def _probe_bookend_saved_input(verified, stage):
    require(type(verified) is VerifiedSavedInput and verified.stage == 'G0' and type(stage) is str and stage in ('G2','G3'), 'G0 verified input required for G2/G3')
    verified.entry(); held = verified._held; progress = verified._state[0]
    context_raw, context_sha = verified.context_raw, verified.context_sha
    require(progress == (() if stage == 'G2' else ('G2',)), 'single ordered same-input bookends required')
    adapter = _expectation_binding_entry(verified.binding)
    marker = object()
    object.__setattr__(verified,'_state',(progress,digest((progress,id(marker))),marker))
    primary = None; final_errors = []
    try:
        check_expectation_context(context_raw,context_sha)
        adapter.bookend(held)
        require(verified._identity_entry() is verified and verified._held is held, 'same G0 probe input required after bookend')
    except BaseException as error: primary = error
    try: verified._identity_entry()
    except BaseException as error: final_errors.append(('input_final',error))
    try: check_expectation_context(context_raw,context_sha)
    except BaseException as error: final_errors.append(('context_final',error))
    if primary is not None or final_errors:
        error = SavedExpectationUnresolved(primary,final_errors) if final_errors else primary
        object.__setattr__(verified,'_state',(progress,digest((progress,id(error))),error))
        if final_errors: raise error from primary
        raise error
    updated = progress+(stage,)
    object.__setattr__(verified,'_state',(updated,digest((updated,id(None))),None))
    return dict(stage=stage,context_sha=verified.context_sha,caller_expectation_sha=verified.held_image_sha,
        local_full_input_bookend=True,real_verified=False, actual_saved_F_execution=False,F_launch_admitted=False,**GATES)


SUCCESSOR_SCHEMA = 'staged_saved_F_successor_context_development_v1'
SUCCESSOR_REQUEST_SCHEMA = 'staged_saved_F_successor_request_development_v1'
SUCCESSOR_PYTHON_VERSION = '3.12.12 | packaged by Anaconda, Inc. | (main, Oct 21 2025, 20:05:38) [MSC v.1929 64 bit (AMD64)]'
SUCCESSOR_SPEC_PIN = (18167, 'b151876e286f24dca3571134e4506e55978f0fe1dee949b76005f3e3c24b2f90')
SUCCESSOR_CONTRACT_PINS = ((2777, '767b0119ee6de14f720099897eafb158803433b4291529a786a4e3e281ed148d'),
    (776, 'ecffb262d87b6595e4d66451768ada7780c73e6e2ea0fc0e5b88834aadb32343'),
    (3301, 'fbb536393e7246487f3b91af0b691da317f1dbb238f5fdd40f770c286ce3dc1e'))


def _successor_integer(value, low, high):
    require(type(value) is int and low <= value <= high, 'successor integer domain differs')


def _successor_pin(value):
    keys(value, 'bytes sha256'); _successor_integer(value['bytes'], 0, 8*1024**2)
    require(_hex64(value['sha256']), 'successor pin SHA differs')


def _successor_pin_map(value, count, total=None):
    require(type(value) is dict and len(value) == count, 'successor pin set differs')
    folded = set()
    for name, item in value.items():
        require(type(name) is str and name and name != '.' and '\\' not in name and ':' not in name
            and '\x00' not in name and not Path(name).is_absolute() and '..' not in Path(name).parts
            and Path(name).as_posix() == name and name.casefold() not in folded, 'successor relative path differs')
        folded.add(name.casefold()); _successor_pin(item)
    size = sum(item['bytes'] for item in value.values())
    require(size == total if total is not None else size <= 2*1024**2, 'successor aggregate bytes differ')


def _successor_identity(value):
    keys(value, 'pid creation_filetime')
    _successor_integer(value['pid'], 1, 2**32-1); _successor_integer(value['creation_filetime'], 1, 2**64-1)


def _successor_directories(value, path):
    paths = [str(p) for p in reversed((path, *path.parents))]
    require(type(value) is list and 1 <= len(value) <= 16 and len(value) == len(paths), 'successor directory chain differs')
    for row, expected in zip(value, paths):
        require(type(row) is list and len(row) == 3 and row[0] == expected, 'successor directory path differs')
        _successor_integer(row[1], 0, 2**64-1); _successor_integer(row[2], 1, 2**128-1)


def _successor_executable(value):
    keys(value, 'path pin identity python'); _successor_pin(value['pin'])
    require(value['path'] == str(EXE) and value['python'] == SUCCESSOR_PYTHON_VERSION and value['pin']['bytes'] > 0,
        'successor executable declaration differs')
    row = value['identity']; require(type(row) is list and len(row) == 4, 'successor executable identity differs')
    for item in row: _successor_integer(item, 0, 2**128-1)
    require(row[2] == value['pin']['bytes'], 'successor executable size differs')


def _successor_environment(value):
    allowed = {'APPDATA','COMMONPROGRAMFILES','COMSPEC','CONDA_DEFAULT_ENV','CONDA_PREFIX','LOCALAPPDATA',
        'NUMBER_OF_PROCESSORS','PATH','PATHEXT','PROCESSOR_ARCHITECTURE','PROGRAMFILES','PROGRAMFILES(X86)',
        'SYSTEMROOT','TEMP','TMP','USERPROFILE','WINDIR','PYTHONDONTWRITEBYTECODE','PYTHONNOUSERSITE',
        'PYTHONHASHSEED','OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS'}
    require(type(value) is dict and len({k.upper() for k in value}) == len(value), 'successor environment key alias')
    require(all(type(k) is type(v) is str and k.upper() in allowed and len(v) <= 32768 for k,v in value.items())
        and len(canonical(value)) <= 131072, 'successor environment shape differs')
    for name in ('PYTHONDONTWRITEBYTECODE','PYTHONNOUSERSITE','OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS'):
        require(value.get(name) == '1', 'successor fixed environment differs')
    require(value.get('PYTHONHASHSEED') == '0', 'successor hash seed differs')


@dataclass(frozen=True, init=False, eq=False, repr=False)
class SavedSuccessorDataCheck:
    _raw: bytes
    _request_raw: bytes
    _expectation_raw: bytes
    basis_sha: str
    anchor_sha: str
    contract_shas: tuple
    spec_pin: tuple
    declared_now: float
    commit: str
    def __new__(cls, *args, **kwargs): raise TypeError('validate successor data explicitly')

    def _image(self):
        return (pin(self._raw),pin(self._request_raw),pin(self._expectation_raw),self.basis_sha,
            self.anchor_sha,self.contract_shas,self.spec_pin,self.declared_now)

    def entry(self):
        require(type(self) is SavedSuccessorDataCheck and self.spec_pin == SUCCESSOR_SPEC_PIN
            and self.contract_shas == tuple(p[1] for p in SUCCESSOR_CONTRACT_PINS)
            and self.anchor_sha == ANCHOR_SHA and self.commit == digest(self._image()), 'successor data result changed')
        return self

    @property
    def raw(self): self.entry(); return self._raw
    @property
    def request_raw(self): self.entry(); return self._request_raw
    @property
    def expectation_raw(self): self.entry(); return self._expectation_raw
    @property
    def context_sha(self): self.entry(); return sha256(self._raw).hexdigest()
    @property
    def request_sha(self): self.entry(); return sha256(self._request_raw).hexdigest()
    @property
    def expectation_sha(self): self.entry(); return sha256(self._expectation_raw).hexdigest()
    @property
    def status_raw(self):
        self.entry()
        return canonical(dict(schema='staged_saved_F_successor_static_data_check_v1',data_only=True,
            declared_time_consistent=True,actual_sources_verified=False,actual_kernel_identity_verified=False,
            actual_clock_verified=False,actual_executable_verified=False,actual_environment_verified=False,
            actual_filesystem_identity_verified=False,deadline_enforced=False,full_P1_content_verified=False,
            run_authority=False,F_launch_admitted=False,native_authorized=False,resource_admission=False,
            formal_result=False,scientific_evidence_adopted=False,public_P2_execution_enabled=False))

    def __reduce__(self): raise TypeError('static data result is not transferable authority')


def validate_saved_successor_data(context_raw, request_raw, *, expectation_raw, host_basis_raw, anchor_raw,
        runtime_contract_raw, deadline_contract_raw, request_contract_raw, now):
    """Pure data relationships only; no filesystem, clock, kernel or role authority."""
    for raw, cap in ((context_raw,2*1024**2),(request_raw,32768),(expectation_raw,2*1024**2),
            (host_basis_raw,2*1024**2),(anchor_raw,8*1024**2),(runtime_contract_raw,65536),
            (deadline_contract_raw,65536),(request_contract_raw,65536)):
        require(type(raw) is bytes and len(raw) <= cap, 'successor raw byte cap')
    profiles = (runtime_contract_raw,deadline_contract_raw,request_contract_raw)
    for raw, (size, sha) in zip(profiles,SUCCESSOR_CONTRACT_PINS):
        require(pin(raw) == dict(bytes=size,sha256=sha), 'successor fixed contract differs'); parse(raw)
    runtime = parse(runtime_contract_raw)
    context, request, expectation, basis = map(parse,(context_raw,request_raw,expectation_raw,host_basis_raw))
    keys(context, 'schema authority scope repo_root input_root output_root output_mode output_parent_directories '
        'source_pins executable environment anchor_sha input_files invocation_started deadline stage_seconds limits '
        'inherited_sources_pin caller_expectation_core caller_expectation_sha expectation_sha full_P1_content_verified '
        'request_sha broker_identity runtime_binding_contract_sha deadline_profile_sha '+' '.join(GATES))
    keys(request, 'schema authority scope nonce host_identity repo_root input_root output_root source_sha executable_pin '
        'environment_sha input_pins_sha caller_expectation_sha expectation_sha anchor_sha invocation_started deadline '
        'runtime_binding_contract_sha deadline_profile_sha limits')
    keys(basis,'source_pins executable environment host_identity broker_identity output_parent_directories')
    keys(expectation, 'schema authority scope caller_expectation_core caller_expectation_sha source_sha input_pins_sha '
        'content_read_files metadata_passes full_P1_content_verified F_launch_admitted '+' '.join(GATES))
    require(context['schema'] == SUCCESSOR_SCHEMA and request['schema'] == SUCCESSOR_REQUEST_SCHEMA
        and expectation['schema'] == EXPECTATION_SCHEMA, 'successor schema differs')
    for value in (context,request,expectation):
        require(value['authority'] == 'DRAFT_NONAUTHORITATIVE' and value['scope'] == SCOPE, 'successor authority/scope differs')
    require(context['output_mode'] == 'saved_P1_successor_draft', 'successor output mode differs')
    for value in (context,expectation):
        require(value['full_P1_content_verified'] is False and all(value[n] is False for n in GATES), 'successor gate differs')
    require(expectation['F_launch_admitted'] is False and type(expectation['metadata_passes']) is int
        and expectation['metadata_passes'] == 2 and expectation['content_read_files'] == list(EXPECTATION_FILES),
        'successor expectation envelope differs')
    for value in (context,request):
        require(value['repo_root'] == str(ROOT) and value['input_root'] == str(P1) and value['output_root'] == str(OUTPUT)
            and canonical(value['limits']) == canonical(CAPS), 'successor roots/limits differ')
    require(canonical(context['stage_seconds']) == canonical(STAGE_SECONDS), 'successor stage caps differ')
    for name in ('limits','stage_seconds'):
        for item in context[name].values(): _successor_integer(item,0,2**64-1)
    for item in request['limits'].values(): _successor_integer(item,0,2**64-1)
    _successor_pin_map(basis['source_pins'],49)
    require(set(basis['source_pins']) == set(runtime['source_names']), 'successor source closure differs')
    _successor_executable(basis['executable']); _successor_environment(basis['environment'])
    _successor_identity(basis['host_identity']); _successor_identity(basis['broker_identity'])
    _successor_directories(basis['output_parent_directories'],OUTPUT.parent)
    for name in ('source_pins','executable','environment','broker_identity','output_parent_directories'):
        require(canonical(context[name]) == canonical(basis[name]), 'successor independent basis differs')
    require(_hex64(request['nonce']) and canonical(request['host_identity']) == canonical(basis['host_identity'])
        and canonical(request['executable_pin']) == canonical(basis['executable']['pin']), 'successor host request differs')
    require(sha256(anchor_raw).hexdigest() == ANCHOR_SHA, 'successor external anchor differs')
    files = json.loads(anchor_raw)['p1_files']; _successor_pin_map(files,683,2950863)
    require(context['anchor_sha'] == request['anchor_sha'] == ANCHOR_SHA
        and canonical(context['input_files']) == canonical(files), 'successor external input pins differ')
    _successor_pin(context['inherited_sources_pin'])
    require(context['inherited_sources_pin'] == dict(bytes=7011,sha256=INHERITED_SHA), 'successor inherited source pin differs')
    core = expectation['caller_expectation_core']
    keys(core, 'files fixture_sha outer trusted expectations bindings source anchor_path anchor_pin anchor_identity '
        'anchor_directories root_directories historical_metrics expected_evidence_refs inventory')
    keys(core['inventory'],'pins files directories')
    require(_hex64(core['fixture_sha']) and type(core['outer']) is type(core['trusted']) is type(core['expectations']) is type(core['historical_metrics']) is dict
        and type(core['bindings']) is list and len(core['bindings']) == 6
        and type(core['expected_evidence_refs']) is list and len(core['expected_evidence_refs']) == 21,
        'successor expected core shape differs')
    require(core['files'] == core['inventory']['pins'] == files and core['source'] == basis['source_pins']
        and core['anchor_path'] == str(P1.parent/'p1_execution_review_01/postcheck_03.stdout.json')
        and core['anchor_pin'] == pin(anchor_raw), 'successor expected core bindings differ')
    _successor_directories(core['anchor_directories'],P1.parent/'p1_execution_review_01')
    _successor_directories(core['root_directories'],P1)
    anchor_row = core['anchor_identity']
    require(type(anchor_row) is list and len(anchor_row) == 4 and anchor_row[2] == len(anchor_raw), 'successor anchor identity differs')
    for item in anchor_row: _successor_integer(item,0,2**128-1)
    require(type(core['inventory']['files']) is dict and set(core['inventory']['files']) == set(files)
        and type(core['inventory']['directories']) is dict, 'successor metadata inventory differs')
    file_ids = set()
    for name,row in core['inventory']['files'].items():
        require(type(row) is list and len(row) == 4 and row[2] == files[name]['bytes'], 'successor metadata file differs')
        for item in row: _successor_integer(item,0,2**128-1)
        require(row[1] > 0 and tuple(row[:2]) not in file_ids, 'successor metadata file alias')
        file_ids.add(tuple(row[:2]))
    folders = core['inventory']['directories']; require(1 <= len(folders) <= 16384 and '.' in folders, 'successor directory metadata count')
    aliases = set(); file_names_folded = {n.casefold() for n in files}
    for name,row in folders.items():
        require(type(name) is str and name and '\\' not in name and ':' not in name and '\x00' not in name
            and not Path(name).is_absolute() and '..' not in Path(name).parts and Path(name).as_posix() == name
            and name.casefold() not in aliases and name.casefold() not in file_names_folded,
            'successor directory metadata path')
        aliases.add(name.casefold()); require(type(row) is list and len(row) == 2, 'successor directory metadata row')
        _successor_integer(row[0],0,2**64-1); _successor_integer(row[1],1,2**128-1)
    for name in files:
        require(all(parent.as_posix() in folders for parent in Path(name).parents), 'successor metadata parent missing')
    require(canonical(context['caller_expectation_core']) == canonical(core)
        and context['caller_expectation_sha'] == expectation['caller_expectation_sha'] == digest(core)
        and context['expectation_sha'] == sha256(expectation_raw).hexdigest()
        and expectation['source_sha'] == digest(basis['source_pins']) and expectation['input_pins_sha'] == digest(files),
        'successor independent expectation differs')
    for name, value in (('source_sha',basis['source_pins']),('environment_sha',basis['environment']),
            ('input_pins_sha',files),('caller_expectation_sha',core)):
        require(request[name] == digest(value), 'successor request digest differs')
    require(request['expectation_sha'] == context['expectation_sha']
        and context['request_sha'] == sha256(request_raw).hexdigest(), 'successor request binding differs')
    for name, sha in (('runtime_binding_contract_sha',SUCCESSOR_CONTRACT_PINS[0][1]),
            ('deadline_profile_sha',SUCCESSOR_CONTRACT_PINS[1][1])):
        require(context[name] == request[name] == sha, 'successor profile digest differs')
    start, deadline = context['invocation_started'],context['deadline']
    require(type(start) is type(deadline) is type(now) is float and all(math.isfinite(v) for v in (start,deadline,now))
        and 0 < start <= now <= deadline and deadline == start+180
        and type(request['invocation_started']) is type(request['deadline']) is float
        and request['invocation_started'] == start and request['deadline'] == deadline, 'successor declared time differs')
    result = object.__new__(SavedSuccessorDataCheck)
    for name,value in dict(_raw=context_raw,_request_raw=request_raw,_expectation_raw=expectation_raw,
            basis_sha=sha256(host_basis_raw).hexdigest(),anchor_sha=ANCHOR_SHA,
            contract_shas=tuple(p[1] for p in SUCCESSOR_CONTRACT_PINS),spec_pin=SUCCESSOR_SPEC_PIN,declared_now=now).items():
        object.__setattr__(result,name,value)
    object.__setattr__(result,'commit',digest(result._image()))
    return result.entry()


def _saved_self_api():
    require(os.name == 'nt', 'Windows self identity required')
    api = C.WinDLL('kernel32', use_last_error=True)
    definitions = {
        'GetCurrentProcessId': ((), W.DWORD), 'GetCurrentThreadId': ((), W.DWORD),
        'OpenProcess': ((W.DWORD,W.BOOL,W.DWORD), W.HANDLE),
        'OpenThread': ((W.DWORD,W.BOOL,W.DWORD), W.HANDLE),
        'GetProcessId': ((W.HANDLE,), W.DWORD), 'GetThreadId': ((W.HANDLE,), W.DWORD),
        'GetProcessIdOfThread': ((W.HANDLE,), W.DWORD),
        'GetProcessTimes': ((W.HANDLE,)+(C.POINTER(W.FILETIME),)*4, W.BOOL),
        'GetThreadTimes': ((W.HANDLE,)+(C.POINTER(W.FILETIME),)*4, W.BOOL),
        'QueryFullProcessImageNameW': ((W.HANDLE,W.DWORD,W.LPWSTR,C.POINTER(W.DWORD)), W.BOOL),
        'GetCommandLineW': ((), W.LPWSTR),
        'GetHandleInformation': ((W.HANDLE,C.POINTER(W.DWORD)), W.BOOL),
        'CloseHandle': ((W.HANDLE,), W.BOOL),
    }
    functions = []
    for name,(args,result) in definitions.items():
        function = getattr(api,name); function.argtypes, function.restype = list(args),result
        functions.append((name,function,args,result))
    return api,tuple(functions)


def _saved_self_checked_api(anchor):
    require(type(anchor._api) is C.WinDLL, 'original self kernel DLL required')
    for name,function,args,result in anchor._functions:
        require(getattr(anchor._api,name) is function and tuple(function.argtypes) == args
            and function.restype is result, 'self kernel function/signature changed')
    return anchor._api


def _saved_self_creation(function,handle):
    created,ended,kernel,user = (W.FILETIME() for _ in range(4))
    _native(function(handle,C.byref(created),C.byref(ended),C.byref(kernel),C.byref(user)))
    value = created.dwLowDateTime | created.dwHighDateTime << 32
    require(0 < value < 2**64, 'self creation time unavailable')
    return value


def _saved_self_snapshot(anchor):
    api = _saved_self_checked_api(anchor)
    pid,tid = _native(api.GetCurrentProcessId()),_native(api.GetCurrentThreadId())
    require(anchor.creator == (pid,get_ident(),tid), 'creating self process/thread required')
    process,thread = anchor._pending
    require(type(process) is type(thread) is int and 0 < process != thread > 0
        and api.GetProcessId(process) == api.GetProcessIdOfThread(thread) == pid
        and api.GetThreadId(thread) == tid, 'retained self HANDLE identity differs')
    for handle in (process,thread):
        flags = W.DWORD(); _native(api.GetHandleInformation(handle,C.byref(flags)))
        require(not flags.value & 1, 'self query HANDLE inherited')
    image = C.create_unicode_buffer(32768); count = W.DWORD(len(image))
    _native(api.QueryFullProcessImageNameW(process,0,image,C.byref(count)))
    require(0 < count.value < len(image) and len(image.value) == count.value
        and Path(image.value).is_absolute(), 'self kernel image unavailable')
    command = api.GetCommandLineW()
    require(type(command) is str and command and '\0' not in command
        and len(command.encode('utf-16-le')) < 65536, 'self OS command line unavailable')
    return dict(pid=pid,tid=tid,process_creation_filetime=_saved_self_creation(api.GetProcessTimes,process),
        thread_creation_filetime=_saved_self_creation(api.GetThreadTimes,thread),
        image_path=image.value,command_line=command)


class SavedSelfAnchorUnresolved(Exception):
    def __init__(self,anchor,primary,cleanup_errors):
        self.anchor,self.primary,self.cleanup_errors = anchor,primary,tuple(cleanup_errors)
        super().__init__('self HANDLE cleanup remains unresolved')
    def __reduce__(self): raise TypeError('unresolved self HANDLE state cannot be serialized')


@dataclass(frozen=True,init=False,eq=False,repr=False)
class SavedSelfProcessAnchor:
    """Current self query HANDLEs; not an upstream, role, owner or input capability."""
    _api: object
    _functions: tuple
    _bindings: tuple
    creator: tuple
    _pending: tuple
    _raw: bytes
    _phase: str
    _failure: object
    _commit: str

    def __new__(cls,*args,**kwargs): raise TypeError('self anchor requires current kernel observations')

    def _image(self):
        return (id(self._api),self._api._handle,
            tuple((name,id(fn),tuple(map(id,args)),id(result)) for name,fn,args,result in self._functions),
            tuple((name,id(fn),id(code),id(defaults),pin(kw),id(closure),cells)
                for name,fn,code,defaults,kw,closure,cells in self._bindings),
            self.creator,self._pending,pin(self._raw),self._phase,id(self._failure))

    def _immutable_entry(self,*,check_query=True):
        require(type(self) is SavedSelfProcessAnchor and self.creator[:2] == (os.getpid(),get_ident())
            and type(self._pending) is tuple and len(self._pending) == 2
            and type(self._raw) is bytes and len(self._raw) <= 131072
            and self._commit == digest(self._image()), 'immutable creating self anchor required')
        if check_query:
            for name,fn,code,defaults,kw,closure,cells in self._bindings:
                require(globals().get(name) is fn and fn.__code__ is code and fn.__defaults__ is defaults
                    and canonical(fn.__kwdefaults__) == kw and fn.__closure__ is closure
                    and tuple(id(cell.cell_contents) for cell in closure or ()) == cells,
                    'self query callable changed')
        return self

    def entry(self):
        self._immutable_entry(); require(self._phase == 'live', 'self anchor is not live')
        value = parse(self._raw)
        require(canonical(_saved_self_snapshot(self)) == canonical(value['observation']), 'self kernel bookend differs')
        return self

    @property
    def raw(self): self.entry(); return self._raw

    def close(self):
        self._immutable_entry(check_query=False)
        if self._phase == 'closed': return
        if self._phase == 'unresolved':
            raise SavedSelfAnchorUnresolved(self,*self._failure) from self._failure[0]
        require(self._phase == 'live', 'self construction is incomplete')
        primary = None
        try: self.entry()
        except BaseException as error: primary = error
        _saved_self_release(self,primary)

    def __reduce__(self): raise TypeError('retained self HANDLEs cannot be serialized')


def _saved_self_state(anchor,phase,pending,*,failure=None):
    object.__setattr__(anchor,'_phase',phase); object.__setattr__(anchor,'_pending',tuple(pending))
    object.__setattr__(anchor,'_failure',failure); object.__setattr__(anchor,'_commit',digest(anchor._image()))


def _saved_self_close_handle(function,handle):
    require(tuple(function.argtypes) == (W.HANDLE,) and function.restype is W.BOOL,
        'self close function signature changed')
    _native(function(handle))


def _saved_self_release(anchor,primary):
    pending = list(anchor._pending); errors = []
    closer = next(fn for name,fn,_,_ in anchor._functions if name == 'CloseHandle')
    information = next(fn for name,fn,_,_ in anchor._functions if name == 'GetHandleInformation')
    for index in (1,0):
        handle = pending[index]
        if handle is None: continue
        try:
            _saved_self_close_handle(closer,handle)
            require(tuple(information.argtypes) == (W.HANDLE,C.POINTER(W.DWORD)) and information.restype is W.BOOL,
                'self close witness signature changed')
            flags = W.DWORD(); C.set_last_error(0)
            still_valid = information(handle,C.byref(flags)); error = C.get_last_error()
            require(not still_valid and error == 6, 'self HANDLE close is not confirmed')
            pending[index] = None
        except BaseException as error: errors.append(('thread' if index else 'process',error))
    _saved_self_state(anchor,'unresolved' if errors else 'closed',pending,
        failure=(primary,tuple(errors)) if errors else None)
    if errors: raise SavedSelfAnchorUnresolved(anchor,primary,errors) from primary
    if primary is not None: raise primary


def open_saved_self_anchor():
    """Open only current self query handles; never starts a role or imports science."""
    api,functions = _saved_self_api(); anchor = object.__new__(SavedSelfProcessAnchor)
    creator = (_native(api.GetCurrentProcessId()),get_ident(),_native(api.GetCurrentThreadId()))
    bindings = []
    for name in ('_saved_self_snapshot','_saved_self_checked_api','_saved_self_creation','_native'):
        fn = globals()[name]
        bindings.append((name,fn,fn.__code__,fn.__defaults__,canonical(fn.__kwdefaults__),fn.__closure__,
            tuple(id(cell.cell_contents) for cell in fn.__closure__ or ())))
    for name,value in dict(_api=api,_functions=functions,_bindings=tuple(bindings),creator=creator,_raw=b'').items():
        object.__setattr__(anchor,name,value)
    _saved_self_state(anchor,'opening',(None,None))
    try:
        process = _native(api.OpenProcess(0x1000,False,creator[0]))
        _saved_self_state(anchor,'opening',(process,None))
        thread = _native(api.OpenThread(0x0800,False,creator[2]))
        _saved_self_state(anchor,'opening',(process,thread))
        anchor._immutable_entry()
        observation = _saved_self_snapshot(anchor)
        raw = canonical(dict(schema='staged_saved_F_self_process_anchor_development_v1',
            authority='DRAFT_NONAUTHORITATIVE',scope='current_process_thread_query_only',
            observation=observation,query_process_access=0x1000,query_thread_access=0x0800,
            local_self_handles_observed=True,role_bootstrap_verified=False,external_owner_verified=False,
            full_runtime_closure_verified=False,full_P1_content_verified=False,run_authority=False,F_launch_admitted=False,**GATES))
        require(len(raw) <= 131072, 'self observation raw cap')
        object.__setattr__(anchor,'_raw',raw); _saved_self_state(anchor,'live',(process,thread))
        return anchor.entry()
    except BaseException as primary:
        _saved_self_release(anchor,primary)


DIRECT_ENTRY_PROBE_FLAG = '--ordinary-successor-entry-observe'
DIRECT_ENTRY_PROBE_FAULTS = ('argv','alias','path','environment','helper','commit','oversize')
_DIRECT_ENTRY_OBSERVATION_ATTEMPTED = False


def _direct_entry_main():
    main = sys.modules.get('__main__')
    require(main is not None and main is sys.modules.get(__name__) and main.__name__ == '__main__'
        and main.__spec__ is None and Path(main.__file__).absolute() == ROOT/NEW_SOURCES[1],
        'direct successor observation main required')
    require(Path.cwd().absolute() == ROOT and Path(sys.executable).absolute() == EXE
        and sys.flags.dont_write_bytecode == sys.flags.no_user_site == 1
        and sys.flags.hash_randomization == sys.flags.optimize == 0, 'controlled direct observation interpreter required')
    return main


def _direct_entry_control():
    main = _direct_entry_main(); actual_environment = dict(os.environ)
    require(actual_environment == environment() and not any(k in actual_environment
        for k in ('PYTHONPATH','PYTHONHOME','PYTHONSTARTUP')), 'direct Python-visible environment differs')
    require(all(type(v) is str and '\0' not in v and len(v) <= 4096 for v in (*sys.argv,*sys.orig_argv))
        and len(sys.argv) <= 32 and len(sys.orig_argv) <= 35, 'bounded direct argv required')
    return dict(main_name=main.__name__,main_spec_is_none=True,entry_path=str(Path(main.__file__).absolute()),
        canonical_alias_is_main=sys.modules.get(ENTRY_MODULE_NAME) is main,argv=list(sys.argv),orig_argv=list(sys.orig_argv),
        sys_path=list(sys.path),cwd=str(Path.cwd().absolute()),executable_path=str(Path(sys.executable).absolute()),
        python=sys.version,environment=actual_environment,
        flags=dict(dont_write_bytecode=True,no_user_site=True,hash_randomization=False,optimize=0))


def _direct_entry_files():
    names = source_names(); require(len(names) == 49, 'direct source set differs')
    require(sum(ordinary(ROOT/name).st_size for name in names) <= 2*1024**2, 'direct source aggregate raw cap')
    sources = {}; entry_raw = None
    for name in (*names,'@executable'):
        path = EXE if name == '@executable' else ROOT/name; links = name == '@executable'
        before = identity(ordinary(path,allow_links=links)); parents = directories(path.parent)
        raw = read(path,allow_links=links)
        require(identity(ordinary(path,allow_links=links)) == before and directories(path.parent) == parents,
            'direct source/EXE identity changed')
        sources[name] = dict(pin=pin(raw),identity=list(before),parents=[list(row) for row in parents])
        if name == NEW_SOURCES[1]: entry_raw = raw
    require(sum(sources[name]['pin']['bytes'] for name in names) <= 2*1024**2, 'direct actual source aggregate cap')
    return canonical(sources),entry_raw


def _direct_entry_restore(main,initial,installed):
    errors = []
    if sys.modules.get(ENTRY_MODULE_NAME) is main: del sys.modules[ENTRY_MODULE_NAME]
    else: errors.append(('alias_restore',ValueError('foreign direct alias was not overwritten')))
    if tuple(sys.path) == installed: sys.path[:] = initial
    else: errors.append(('path_restore',ValueError('foreign direct paths were not overwritten')))
    return errors


class SavedDirectEntryUnresolved(Exception):
    def __init__(self,observation,anchor,primary,secondary):
        self.observation,self.anchor,self.primary,self.secondary = observation,anchor,primary,tuple(secondary)
        super().__init__('ordinary direct entry remains unresolved')
    def __reduce__(self): raise TypeError('unresolved direct entry cannot be serialized')


@dataclass(frozen=True,init=False,eq=False,repr=False)
class SavedDirectEntryObservation:
    """Ordinary local observation; never a trusted upstream or role capability."""
    _main: object
    _anchor: object
    _initial: tuple
    _paths: tuple
    _control_raw: bytes
    _files_raw: bytes
    _kernel_raw: bytes
    _module_code: object
    _bindings: tuple
    _creator: tuple
    _owner: tuple
    _owner_commit: str
    _close_state: tuple
    _phase: str
    _failure: object
    _commit: str

    def __new__(cls,*args,**kwargs): raise TypeError('direct observation requires cold main mechanics')

    def _image(self):
        return (id(self._main),id(self._anchor),self._initial,self._paths,pin(self._control_raw),pin(self._files_raw),
            pin(self._kernel_raw),id(self._module_code),self._creator,self._phase,id(self._failure),
            id(self._owner),self._owner_commit,
            tuple((name,id(fn),id(code),id(defaults),pin(kw),id(closure)) for name,fn,code,defaults,kw,closure in self._bindings))

    def _intrinsic(self):
        owner = self._ownership()
        require(type(self) is SavedDirectEntryObservation and self._creator == (os.getpid(),get_ident())
            and self._main is owner[0] and self._anchor is owner[1] and self._creator == owner[2]
            and self._initial == owner[3] and self._paths == owner[4] and self._commit == digest(self._image()),
            'creating immutable direct observation required')

    def _ownership(self):
        owner = self._owner
        require(type(self) is SavedDirectEntryObservation and type(owner) is tuple and len(owner) == 5
            and type(owner[1]) is SavedSelfProcessAnchor and owner[2] == (os.getpid(),get_ident())
            and self._owner_commit == digest((id(owner[0]),id(owner[1]),owner[2],owner[3],owner[4]))
            and type(self._close_state) is tuple and len(self._close_state) == 2 and type(self._close_state[0]) is bool
            and self._close_state[1] == digest((id(owner),self._owner_commit,self._close_state[0])),
            'direct cleanup ownership is unresolved')
        return owner

    def entry(self):
        self._intrinsic(); require(self._phase == 'live', 'direct observation is not live')
        for name,fn,code,defaults,kw,closure in self._bindings:
            require(globals().get(name) is fn and fn.__code__ is code and fn.__defaults__ is defaults
                and canonical(fn.__kwdefaults__) == kw and fn.__closure__ is closure, 'direct observation dependency changed')
        require(_direct_entry_main() is self._main and tuple(sys.path) == self._paths
            and canonical(_direct_entry_control()) == self._control_raw, 'direct entry control changed')
        self._anchor.entry(); require(self._anchor.raw == self._kernel_raw, 'direct self anchor changed')
        files,entry_raw = _direct_entry_files()
        require(files == self._files_raw and self._module_code == compile(entry_raw,str(ROOT/NEW_SOURCES[1]),
            'exec',dont_inherit=True,optimize=0), 'direct source read/identity or loaded code changed')
        return self

    @property
    def raw(self):
        self.entry()
        raw = canonical(dict(schema='staged_saved_F_ordinary_direct_entry_observation_v1',authority='DRAFT_NONAUTHORITATIVE',
            ordinary_probe=True,role_binding=False,external_Job_owner=False,full_runtime_closure_verified=False,
            full_P1_content_verified=False,run_authority=False,F_launch_admitted=False,
            initial_sys_path=list(self._initial),control=parse(self._control_raw),files=parse(self._files_raw),
            self_observation=parse(self._kernel_raw),module_code_matches_disk=True,**GATES))
        require(len(raw) <= 131072, 'direct observation raw cap'); return raw

    def close(self):
        try: owner = self._ownership()
        except BaseException as primary:
            raise SavedDirectEntryUnresolved(self,getattr(self,'_anchor',None),primary,(('ownership',primary),)) from primary
        main,anchor,creator,initial,installed = owner
        if self._close_state[0]:
            require(self._phase == 'closed' and anchor._phase == 'closed', 'direct observation cleanup cannot be retried')
            return
        object.__setattr__(self,'_close_state',(True,digest((id(owner),self._owner_commit,True))))
        errors = []
        # Full binding drift is a final-bookend error; the separate immutable
        # ownership tuple still identifies the resources that may be cleaned.
        try: self.entry()
        except BaseException as error: errors.append(('final_bookend',error))
        try: errors.extend(_direct_entry_restore(main,initial,installed))
        except BaseException as error: errors.append(('restore',error))
        if ENTRY_MODULE_NAME in sys.modules or tuple(sys.path) != initial:
            errors.append(('restore_witness',ValueError('direct alias/path restore is unresolved')))
        try: anchor.close()
        except BaseException as error: errors.append(('self_anchor_close',error))
        object.__setattr__(self,'_phase','unresolved' if errors else 'closed')
        object.__setattr__(self,'_failure',tuple(errors) if errors else None)
        object.__setattr__(self,'_commit',digest(self._image()))
        if errors: raise SavedDirectEntryUnresolved(self,anchor,None,errors)

    def __reduce__(self): raise TypeError('ordinary direct observation cannot be serialized')


def capture_saved_direct_entry_observation():
    global _DIRECT_ENTRY_OBSERVATION_ATTEMPTED
    main = _direct_entry_main()
    require(_DIRECT_ENTRY_OBSERVATION_ATTEMPTED is False, 'single direct observation attempt required')
    _DIRECT_ENTRY_OBSERVATION_ATTEMPTED = True
    require(sys.modules.get(ENTRY_MODULE_NAME) is None and _ordinary_preimports(main) == [],
        'cold direct observation requires no canonical alias/project preimports')
    initial = _checked_entry_paths(tuple(sys.path),installed=False)
    installed = _checked_entry_paths((str(ROOT),*initial[1:]),installed=True)
    frame = sys._getframe(1); module_code = None
    while frame is not None:
        if frame.f_globals is vars(main) and frame.f_code.co_name == '<module>': module_code = frame.f_code; break
        frame = frame.f_back
    require(type(module_code) is CodeType, 'active direct module frame required')
    anchor = observation = None; alias_installed = False; errors = []
    try:
        files,entry_raw = _direct_entry_files()
        require(module_code == compile(entry_raw,str(ROOT/NEW_SOURCES[1]),'exec',dont_inherit=True,optimize=0),
            'loaded direct module code differs from disk')
        anchor = open_saved_self_anchor(); kernel = anchor.raw
        require(str(Path(parse(kernel)['observation']['image_path']).absolute()).casefold() == str(EXE).casefold(),
            'direct kernel executable image differs')
        sys.path[:] = installed; sys.modules[ENTRY_MODULE_NAME] = main; alias_installed = True
        bindings = []
        for name in ('_direct_entry_main','_direct_entry_control','_direct_entry_files','read','source_names','directories','ordinary'):
            fn = globals()[name]; bindings.append((name,fn,fn.__code__,fn.__defaults__,canonical(fn.__kwdefaults__),fn.__closure__))
        observation = object.__new__(SavedDirectEntryObservation)
        creator = (os.getpid(),get_ident()); owner = (main,anchor,creator,initial,installed)
        owner_commit = digest((id(main),id(anchor),creator,initial,installed))
        for name,value in dict(_main=main,_anchor=anchor,_initial=initial,_paths=installed,
            _control_raw=canonical(_direct_entry_control()),_files_raw=files,_kernel_raw=kernel,
            _module_code=module_code,_bindings=tuple(bindings),_creator=creator,_owner=owner,_owner_commit=owner_commit,
            _close_state=(False,digest((id(owner),owner_commit,False))),_phase='live',_failure=None).items():
            object.__setattr__(observation,name,value)
        object.__setattr__(observation,'_commit',digest(observation._image())); observation._intrinsic()
        return observation
    except BaseException as primary:
        if alias_installed:
            try: errors.extend(_direct_entry_restore(main,initial,installed))
            except BaseException as error: errors.append(('construction_restore',error))
        if anchor is not None:
            try: anchor.close()
            except BaseException as error: errors.append(('construction_self_close',error))
        if errors: raise SavedDirectEntryUnresolved(observation,anchor,primary,errors) from primary
        raise


def _direct_entry_error_image(error,budget,depth=3,seen=frozenset()):
    if budget[0] <= 0 or depth < 0 or id(error) in seen:
        return dict(type='BoundedError',message='error image limit',primary=None,secondary=[],truncated=True)
    budget[0] -= 1; seen = seen|{id(error)}
    primary = getattr(error,'primary',None)
    children = getattr(error,'secondary',getattr(error,'cleanup_errors',()))
    return dict(type=type(error).__name__[:64],message=str(error)[:192],
        primary=None if primary is None else _direct_entry_error_image(primary,budget,depth-1,seen),
        secondary=[dict(layer=str(layer)[:64],error=_direct_entry_error_image(child,budget,depth-1,seen))
            for layer,child in tuple(children)[:8]],truncated=len(children)>8)


def _ordinary_direct_entry_cli(argv):
    counts = dict(process_attempts=0,P1_open_attempts=0,actual_F_open_attempts=0,write_attempts=0)
    active = True
    def audit(event,args):
        if not active: return
        if event == 'subprocess.Popen' or event == 'os.system' or event.startswith('os.spawn'):
            counts['process_attempts'] += 1; raise ValueError('ordinary direct child cannot launch a process')
        if event == 'open' and isinstance(args[0],(str,bytes,os.PathLike)):
            path = os.path.normcase(os.path.abspath(os.fsdecode(args[0])))
            for root,key in ((P1,'P1_open_attempts'),(OUTPUT.parent,'actual_F_open_attempts')):
                prefix = os.path.normcase(str(root))
                if path == prefix or path.startswith(prefix+os.sep):
                    counts[key] += 1; raise ValueError('ordinary direct child attempted saved result access')
            mode,flags = args[1:3]
            if (type(mode) is str and any(c in mode for c in 'wax+')) or (type(flags) is int and flags&(os.O_WRONLY|os.O_RDWR|os.O_CREAT|os.O_TRUNC|os.O_APPEND)):
                counts['write_attempts'] += 1; raise ValueError('ordinary direct child attempted file write')
        if event in ('os.mkdir','os.remove','os.rmdir','os.rename','os.link','os.symlink'):
            counts['write_attempts'] += 1; raise ValueError('ordinary direct child attempted filesystem mutation')
    sys.addaudithook(audit)
    observation = None; primary = None; secondary = []; raw = None
    try:
        require(argv == [DIRECT_ENTRY_PROBE_FLAG] or (len(argv) == 3 and argv[:2] == [DIRECT_ENTRY_PROBE_FLAG,'--fault']
            and argv[2] in DIRECT_ENTRY_PROBE_FAULTS), 'closed ordinary direct probe arguments required')
        if len(argv) == 3 and argv[2] == 'oversize':
            for _ in range(9): sys.stdout.buffer.write(b'x'*16384); sys.stdout.buffer.flush()
            time.sleep(10)
            raise ValueError('oversize runner failed to stop the ordinary child')
        observation = capture_saved_direct_entry_observation()
        fault = argv[2] if len(argv) == 3 else None
        if fault == 'argv': sys.argv.append('ordinary-probe-drift')
        elif fault == 'alias': sys.modules[ENTRY_MODULE_NAME] = ModuleType('ordinary_probe_foreign_alias')
        elif fault == 'path': sys.path.append(str(ROOT/'ordinary_probe_foreign_path'))
        elif fault == 'environment': os.environ['PYTHONPATH'] = 'ordinary-probe-injected'
        elif fault == 'helper': globals()['_direct_entry_files'] = lambda: (observation._files_raw,b'')
        elif fault == 'commit': object.__setattr__(observation,'_commit','ordinary-probe-commit-drift')
        raw = observation.raw
    except BaseException as error: primary = error
    finally:
        if observation is not None:
            try: observation.close()
            except BaseException as error: secondary.append(error)
        active = False
    closed = observation is not None and observation._anchor._phase == 'closed'
    error_budget = [24]
    value = dict(schema='staged_saved_F_ordinary_direct_probe_record_v1',authority='DRAFT_NONAUTHORITATIVE',
        status='completed' if primary is None and not secondary else 'failed',ordinary_probe=True,
        observation=parse(raw) if primary is None and not secondary else None,self_handles_closed=closed,
        audit_window='ordinary_dispatch_to_cleanup',audit_counts=counts,audit_hook_active_at_end=False,
        primary=None if primary is None else _direct_entry_error_image(primary,error_budget),
        secondary=[_direct_entry_error_image(error,error_budget) for error in secondary],
        role_binding=False,external_Job_owner=False,full_runtime_closure_verified=False,run_authority=False,F_launch_admitted=False,**GATES)
    output = canonical(value); require(len(output) <= 131072, 'ordinary direct stdout cap')
    sys.stdout.buffer.write(output+b'\n');sys.stdout.buffer.flush()
    raise SystemExit(0 if value['status'] == 'completed' else 1)


SAVED_ROLE_REGISTRY_PIN = (21981, 'd5e467a761ea5d50c939f9b76fd702775381341996c3a0aaf5e563025a62520b')
SAVED_ROLE_TEMPLATE_PIN = (2231, '36cff2e3fa3a11da0d6a2de7a088e8be94d528a1f2a2c33e14a88f03d57a0d0a')
_SAVED_ROLE_PRODUCERS = dict(controller='broker', parent='controller', fresh='parent')
_SAVED_ROLE_PROJECTIONS = dict(controller=('broker_ACK_verified',),
    parent=('controller_bootstrap','controller_G0','controller_store','controller_issuer'),
    fresh=('parent_bootstrap','parent_hold','parent_store','parent_issuer'))


def _saved_role_bytes(raw, cap):
    require(type(raw) is bytes and 0 < len(raw) <= cap, 'role data raw byte cap')
    return parse(raw)


def _saved_role_time(value):
    require(type(value) is float and math.isfinite(value) and 0 < value < 1e12, 'role declared time domain')


def _saved_role_identity(value):
    require(type(value) is list and len(value) == 2, 'role declared process identity shape')
    _successor_integer(value[0],1,2**32-1); _successor_integer(value[1],1,2**64-1)


def _saved_role_name(value):
    require(type(value) is str and value.startswith('Local\\') and 6 < len(value) <= 192
        and all(c in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-' for c in value[6:]),
        'role transport name domain')


def _saved_role_shape(raw, name, registry):
    spec = registry['schemas'][name]; value = _saved_role_bytes(raw,spec['encoded_value_cap'])
    require(type(value) is dict and set(value) == set(spec['fields']), 'role frozen fields differ')
    for field, rule in spec['fields'].items():
        item = value[field]
        if type(rule) is dict:
            require(canonical(item) == canonical(rule['literal']), 'role frozen literal differs')
        elif rule == 'sha256': require(_hex64(item), 'role SHA domain')
        elif rule == 'identity': _saved_role_identity(item)
        elif rule == 'time': _saved_role_time(item)
        elif rule == 'path':
            require(type(item) is str and '\0' not in item and Path(item).is_absolute()
                and len(canonical(item)) <= 4096, 'role path domain')
        elif rule == 'name': _saved_role_name(item)
        elif rule == 'pin':
            _successor_pin(item); require(item['bytes'] > 0, 'role positive pin bytes required')
        elif rule == 'receipt':
            keys(item,'bytes sha256 identity'); _successor_integer(item['bytes'],1,2*1024**2)
            require(_hex64(item['sha256']) and type(item['identity']) is list and len(item['identity']) == 4, 'role receipt shape')
            for part in item['identity']: _successor_integer(part,0,2**64-1)
            require(item['identity'][2] == item['bytes'], 'role receipt declared size differs')
        else: require(rule == 'true' and item is True, 'role data-only literal differs')
    for field, rule in spec['field_equalities'].items():
        require(value[field] == rule['literal'], 'role fixed artifact SHA differs')
    return value


def _saved_role_declaration(raw, name, producer, consumer, context, request, stage_nonce,
        packet_sha, binding_sha, extra=''):
    value = _saved_role_bytes(raw,65536)
    keys(value,'schema data_only producer_role consumer_role context_sha request_sha stage_nonce packet_sha '
        'permit_binding_sha declared_at '+extra)
    require(value['schema'] == 'staged_saved_F_successor_'+name+'_declaration_data_v1'
        and value['data_only'] is True and value['producer_role'] == producer and value['consumer_role'] == consumer,
        'role declaration domain differs')
    require(value['context_sha'] == context and value['request_sha'] == request and value['stage_nonce'] == stage_nonce
        and value['packet_sha'] == packet_sha and value['permit_binding_sha'] == binding_sha,
        'role declaration upstream binding differs')
    _saved_role_time(value['declared_at'])
    return value


def _saved_role_publication(raw, tree_raw, context, request_sha):
    value = _saved_role_bytes(raw,65536)
    keys(value,'schema data_only producer_role consumer_role context_sha request_sha stage_nonce declared_at '
        'tree_declared_at producer_identity context_path context_receipt root_directories role_tree_pin')
    require(value['schema'] == 'staged_saved_F_successor_publication_declaration_data_v1'
        and value['data_only'] is True and value['producer_role'] == 'broker'
        and value['consumer_role'] == 'successor_entry_data_validation'
        and value['context_sha'] == digest(context) and value['request_sha'] == request_sha
        and _hex64(value['stage_nonce']), 'role publication declaration domain')
    _saved_role_identity(value['producer_identity'])
    broker = context['broker_identity']
    require(value['producer_identity'] == [broker['pid'],broker['creation_filetime']], 'role publication producer declaration')
    _saved_role_time(value['declared_at']); _saved_role_time(value['tree_declared_at'])
    require(value['context_path'] == str(OUTPUT/'context.json'), 'role publication context path')
    receipt = value['context_receipt']; keys(receipt,'bytes sha256 identity')
    _successor_integer(receipt['bytes'],1,2*1024**2)
    require(dict(bytes=receipt['bytes'],sha256=receipt['sha256']) == pin(canonical(context))
        and type(receipt['identity']) is list and len(receipt['identity']) == 4, 'role publication receipt declaration')
    for part in receipt['identity']: _successor_integer(part,0,2**64-1)
    require(receipt['identity'][2] == receipt['bytes'], 'role publication receipt size')
    _successor_directories(value['root_directories'],OUTPUT)
    require(value['root_directories'][:-1] == context['output_parent_directories'], 'role publication root chain declaration')
    tree = _saved_role_bytes(tree_raw,65536)
    _successor_pin(value['role_tree_pin'])
    require(type(tree) is list and len(tree) == 7 and value['role_tree_pin'] == pin(tree_raw), 'role tree image declaration')
    for row, name in zip(tree[:6],('', 'worker','worker/fresh','worker/fresh_parent','parent','diagnostics')):
        require(type(row) is list and len(row) == 2 and row[0] == name, 'role tree closed image')
        _successor_directories(row[1],OUTPUT/name)
        require(row[1][:len(value['root_directories'])] == value['root_directories'], 'role tree shared root declaration')
    require(tree[-1] == ['context_file_identity',receipt['identity']], 'role tree context receipt declaration')
    return value


def _saved_role_object_reference(value, obj, *, creator=False):
    keys(value,'object_id commit'+(' creator' if creator else ''))
    _successor_integer(value['object_id'],1,2**64-1)
    require(value['object_id'] == id(obj) and value['commit'] == obj.commit, 'role original data object required')
    if creator:
        require(type(value['creator']) is list and len(value['creator']) == 2, 'role original creator shape')
        for part in value['creator']: _successor_integer(part,1,2**64-1)
        require(value['creator'] == list(obj._creator), 'role original data creator required')


@dataclass(frozen=True,init=False,eq=False,repr=False)
class _SavedEntryData:
    _raws: tuple
    _context_data: SavedSuccessorDataCheck
    _upstream_data: object
    _creator: tuple
    _object_id: int
    _context_id: int
    _context_commit: str
    _upstream_id: int
    _upstream_commit: object
    declared_now: float
    commit: str
    def __new__(cls,*args,**kwargs): raise TypeError('validate role data explicitly')
    def _image(self):
        return (type(self).__name__,tuple(pin(raw) for raw in self._raws),self._creator,self._object_id,
            self._context_id,self._context_commit,self._upstream_id,self._upstream_commit,self.declared_now)
    @property
    def raw(self): self.entry(); return self._raws[0]
    @property
    def permit_raw(self): self.entry(); return self._raws[1]
    @property
    def descriptor_raw(self): self.entry(); return self._raws[2]
    @property
    def packet_sha(self): return sha256(self.raw).hexdigest()
    @property
    def permit_sha(self): return sha256(self.permit_raw).hexdigest()
    @property
    def status_raw(self):
        self.entry()
        return canonical(dict(schema='staged_saved_F_role_static_entry_data_check_v1',data_only=True,
            declared_inputs_consistent=True,declared_order_consistent=True,declared_time_consistent=True,
            frozen_schema_family=10,development_declaration_schema_family=21,
            full_projection_semantics_verified=False,producer_capability_verified=False,consumer_authorization_verified=False,
            wire_header_transport_semantics_verified=False,actual_sources_verified=False,actual_kernel_identity_verified=False,
            actual_filesystem_identity_verified=False,context_origin_creator_verified=False,clock_observed=False,deadline_enforced=False,
            not_expired_physically_verified=False,role_bootstrap=False,reservation_consumed=False,permit_issued=False,
            owned_child_created=False,full_P1_content_verified=False,full_runtime_verified=False,
            run_authority=False,F_launch_admitted=False,native_authorized=False,resource_admission=False,
            formal_result=False,scientific_evidence_adopted=False,public_P2_execution_enabled=False))
    def __reduce__(self): raise TypeError('role data object is not transferable authority')


@dataclass(frozen=True,init=False,eq=False,repr=False)
class SavedControllerEntryData(_SavedEntryData):
    def entry(self): return _saved_role_data_entry(self,SavedControllerEntryData,None)
    def __init_subclass__(cls,**kwargs): raise TypeError('exact controller data type required')


@dataclass(frozen=True,init=False,eq=False,repr=False)
class SavedParentEntryData(_SavedEntryData):
    def entry(self): return _saved_role_data_entry(self,SavedParentEntryData,SavedControllerEntryData)
    def __init_subclass__(cls,**kwargs): raise TypeError('exact parent data type required')


@dataclass(frozen=True,init=False,eq=False,repr=False)
class SavedFreshEntryData(_SavedEntryData):
    def entry(self): return _saved_role_data_entry(self,SavedFreshEntryData,SavedParentEntryData)
    def __init_subclass__(cls,**kwargs): raise TypeError('exact fresh data type required')


def _saved_role_data_entry(value, cls, upstream_cls):
    require(type(value) is cls and value._creator == (os.getpid(),get_ident())
        and value._object_id == id(value) and type(value._context_data) is SavedSuccessorDataCheck
        and value._context_id == id(value._context_data), 'role exact original data/creator required')
    value._context_data.entry()
    require(value._context_commit == value._context_data.commit, 'role context data changed')
    if upstream_cls is None:
        require(value._upstream_data is None and value._upstream_id == id(None) and value._upstream_commit is None,
            'controller data has no upstream role object')
    else:
        source = value._upstream_data
        require(type(source) is upstream_cls and id(source) == value._upstream_id
            and source._context_data is value._context_data, 'role original upstream/context data required')
        source.entry(); require(source.commit == value._upstream_commit, 'role upstream data changed')
    require(value.commit == digest(value._image()), 'role data immutable commit changed')
    return value


def _validate_saved_entry_data(role, cls, packet_raw, permit_raw, descriptor_raw, *, context_data,
        upstream_data, publication_raw, tree_raw, transport_raw, basis_raw, projection_raws,
        registry_raw, templates_raw, now, ack_raw=None, mailbox_header_raw=None, offer_raw=None):
    require(type(context_data) is SavedSuccessorDataCheck, 'exact context data required'); context_data.entry()
    _saved_role_time(now)
    for raw, expected in ((registry_raw,SAVED_ROLE_REGISTRY_PIN),(templates_raw,SAVED_ROLE_TEMPLATE_PIN)):
        require(type(raw) is bytes and len(raw) == expected[0]
            and pin(raw) == dict(bytes=expected[0],sha256=expected[1]), 'role fixed data contract differs')
    registry, templates = parse(registry_raw),parse(templates_raw)
    context, request = parse(context_data.raw),parse(context_data.request_raw)
    context_sha, request_sha = context_data.context_sha,context_data.request_sha
    publication = _saved_role_publication(publication_raw,tree_raw,context,request_sha)
    transport = _saved_role_bytes(transport_raw,65536)
    keys(transport,'schema data_only producer_role consumer_role context_sha request_sha entry_transport_name '
        'entry_transport_nonce stage_name stage_nonce')
    producer = _SAVED_ROLE_PRODUCERS[role]
    require(transport['schema'] == 'staged_saved_F_successor_'+role+'_transport_declaration_data_v1'
        and transport['data_only'] is True and transport['producer_role'] == producer and transport['consumer_role'] == role
        and transport['context_sha'] == context_sha and transport['request_sha'] == request_sha, 'role transport declaration domain')
    for name in ('entry_transport_name','stage_name'): _saved_role_name(transport[name])
    for name in ('entry_transport_nonce','stage_nonce'): require(_hex64(transport[name]), 'role transport nonce')
    require(transport['entry_transport_name'] != transport['stage_name']
        and transport['entry_transport_nonce'] != transport['stage_nonce'], 'role transport aliases')
    basis = _saved_role_bytes(basis_raw,65536)
    controller_fields = ' ack_pin mailbox_header_pin offer_pin host_direction_nonce ACK_declared_at' if role == 'controller' else ''
    keys(basis,'schema data_only producer_role consumer_role context_sha request_sha stage_nonce packet_sha '
        'permit_binding_sha producer_identity permit_nonce context_data_identity upstream_data_identity '
        'local_episode projection_pins'+controller_fields)
    require(basis['schema'] == 'staged_saved_F_successor_'+role+'_basis_declaration_data_v1'
        and basis['data_only'] is True and basis['producer_role'] == producer and basis['consumer_role'] == role
        and basis['context_sha'] == context_sha and basis['request_sha'] == request_sha
        and _hex64(basis['permit_nonce']), 'role independent basis domain')
    _saved_role_identity(basis['producer_identity']); _saved_role_object_reference(basis['context_data_identity'],context_data)
    if role == 'controller':
        require(upstream_data is None and basis['upstream_data_identity'] is None, 'controller upstream data domain')
        require(basis['producer_identity'] == publication['producer_identity'], 'controller broker declaration differs')
        source_packet_sha, source_binding_sha, source_stage = None,None,publication['stage_nonce']
    else:
        upstream_cls = SavedControllerEntryData if role == 'parent' else SavedParentEntryData
        require(type(upstream_data) is upstream_cls, 'exact upstream role data required'); upstream_data.entry()
        require(upstream_data._context_data is context_data, 'same original context data required')
        require(upstream_data._raws[3:5] == (publication_raw,tree_raw), 'same original publication/tree declarations required')
        _saved_role_object_reference(basis['upstream_data_identity'],upstream_data,creator=True)
        source_packet_sha,source_binding_sha = upstream_data.packet_sha,upstream_data.permit_sha
        source_stage = parse(upstream_data.raw)['stage_nonce']
        require(basis['producer_identity'] != publication['producer_identity']
            and basis['producer_identity'] != [request['host_identity']['pid'],request['host_identity']['creation_filetime']],
            'downstream producer declaration aliases host/broker')
        require(basis['producer_identity'] != parse(upstream_data._raws[6])['producer_identity'],
            'downstream producer declaration aliases upstream producer')
    require((basis['stage_nonce'],basis['packet_sha'],basis['permit_binding_sha']) ==
        (source_stage,source_packet_sha,source_binding_sha), 'role independent upstream basis differs')
    ancestor_names,ancestor_nonces = set(),{publication['stage_nonce']}
    ancestor = upstream_data
    while ancestor is not None:
        ancestor.entry(); previous_transport = parse(ancestor._raws[5])
        ancestor_names.update(previous_transport[n] for n in ('entry_transport_name','stage_name'))
        ancestor_nonces.update(previous_transport[n] for n in ('entry_transport_nonce','stage_nonce'))
        if type(ancestor) is SavedControllerEntryData:
            ancestor_names.add(parse(ancestor._raws[-2])['mailbox_name'])
        ancestor = ancestor._upstream_data
    require(not {transport['entry_transport_name'],transport['stage_name']}.intersection(ancestor_names)
        and not {transport['entry_transport_nonce'],transport['stage_nonce']}.intersection(ancestor_nonces),
        'role transport aliases ancestor')
    episode = basis['local_episode']
    keys(episode,'schema data_only producer_role consumer_role context_sha request_sha stage_nonce packet_sha '
        'permit_binding_sha producer_identity nonce started deadline')
    episode_kind = 'attempt' if role == 'controller' else 'reservation'
    require(episode['schema'] == 'staged_saved_F_successor_'+role+'_'+episode_kind+'_declaration_data_v1'
        and episode['data_only'] is True and episode['producer_role'] == producer and episode['consumer_role'] == role
        and episode['context_sha'] == context_sha and episode['request_sha'] == request_sha
        and episode['producer_identity'] == basis['producer_identity'] and _hex64(episode['nonce'])
        and (episode['stage_nonce'],episode['packet_sha'],episode['permit_binding_sha']) ==
            (source_stage,source_packet_sha,source_binding_sha), 'role original local episode domain')
    _saved_role_time(episode['started']); _saved_role_time(episode['deadline'])
    _saved_role_identity(episode['producer_identity'])
    descriptor = _saved_role_shape(descriptor_raw,role+'_stage_descriptor',registry)
    total,tail = descriptor['total_seconds'],descriptor['quiesce_seconds']+descriptor['terminal_seconds']
    start,deadline = context['invocation_started'],context['deadline']
    require(episode['deadline'] == min(deadline,episode['started']+total), 'role original episode deadline differs')
    active = min(start+templates['deadlines'][role][0],deadline,episode['deadline']-tail)
    closed = min(start+templates['deadlines'][role][1],deadline,episode['deadline'])
    require(start <= episode['started'] <= now <= active and episode['started'] < active <= closed <= deadline,
        'role declared time/remaining original episode differs')
    projection_names = _SAVED_ROLE_PROJECTIONS[role]
    require(type(projection_raws) is tuple and len(projection_raws) == len(projection_names)
        and type(basis['projection_pins']) is dict and set(basis['projection_pins']) == set(projection_names),
        'role closed projection declarations required')
    projections = []
    for name, raw in zip(projection_names,projection_raws):
        require(type(raw) is bytes and 0 < len(raw) <= 65536, 'role projection raw byte cap')
        _successor_pin(basis['projection_pins'][name])
        require(pin(raw) == basis['projection_pins'][name], 'role independent projection bytes differ')
        extra = 'ACK_sha' if role == 'controller' else 'image_sha'
        value = _saved_role_declaration(raw,name,producer,role,context_sha,request_sha,source_stage,
            source_packet_sha,source_binding_sha,extra)
        require(_hex64(value[extra]), 'role projection image SHA domain')
        projections.append(value)
    if role == 'controller':
        for raw, name in ((ack_raw,'ack_pin'),(mailbox_header_raw,'mailbox_header_pin'),(offer_raw,'offer_pin')):
            require(type(raw) is bytes and 0 < len(raw) <= 65536, 'controller upstream raw cap')
            _successor_pin(basis[name]); require(pin(raw) == basis[name], 'controller independent upstream bytes differ')
        ack = _saved_role_shape(ack_raw,'ACK',registry)
        header = _saved_role_declaration(mailbox_header_raw,'mailbox_header','host','broker',None,request_sha,
            source_stage,None,None,'host_identity broker_identity host_direction_nonce mailbox_name layout_sha')
        offer = _saved_role_declaration(offer_raw,'offer','broker','host',context_sha,request_sha,
            source_stage,None,None,'context_receipt_sha root_directories_sha')
        host = [request['host_identity']['pid'],request['host_identity']['creation_filetime']]
        _saved_role_identity(header['host_identity']); _saved_role_identity(header['broker_identity'])
        _saved_role_name(header['mailbox_name'])
        require(header['mailbox_name'] not in (transport['entry_transport_name'],transport['stage_name']),
            'controller transport aliases mailbox')
        require(_hex64(header['layout_sha']) and _hex64(basis['host_direction_nonce'])
            and header['host_direction_nonce'] == ack['host_direction_nonce'] == basis['host_direction_nonce']
            and header['host_identity'] == ack['host_identity'] == host
            and header['broker_identity'] == ack['broker_identity'] == publication['producer_identity'], 'controller mailbox identity declaration')
        require(ack['request_sha'] == request_sha and ack['context_sha'] == context_sha
            and ack['offer_sha'] == sha256(offer_raw).hexdigest()
            and ack['mailbox_header_sha'] == sha256(mailbox_header_raw).hexdigest()
            and ack['context_receipt_sha'] == offer['context_receipt_sha'] == digest(publication['context_receipt'])
            and ack['root_directories_sha'] == offer['root_directories_sha'] == digest(publication['root_directories'])
            and ack['original_invocation_started'] == start and ack['original_invocation_deadline'] == deadline
            and projections[0]['ACK_sha'] == sha256(ack_raw).hexdigest(), 'controller ACK declaration chain differs')
        _saved_role_time(basis['ACK_declared_at'])
        stamps = (start,header['declared_at'],publication['declared_at'],publication['tree_declared_at'],
            offer['declared_at'],basis['ACK_declared_at'],projections[0]['declared_at'],episode['started'],now)
        upstream_fields = dict(ACK_sha=sha256(ack_raw).hexdigest(),mailbox_header_sha=sha256(mailbox_header_raw).hexdigest(),
            broker_ACK_verified_projection_sha=sha256(projection_raws[0]).hexdigest())
    else:
        require(start <= publication['declared_at'] <= publication['tree_declared_at'] <= projections[0]['declared_at'],
            'role publication declaration order differs')
        stamps = (upstream_data.declared_now,*(v['declared_at'] for v in projections),episode['started'],now)
        upstream_fields = {name+'_projection_sha':sha256(raw).hexdigest() for name,raw in zip(projection_names,projection_raws)}
        upstream_fields[producer+'_permit_binding_sha'] = source_binding_sha
    require(all(a <= b for a,b in zip(stamps,stamps[1:])), 'role declared causal order differs')
    permit = _saved_role_shape(permit_raw,role+'_permit_binding',registry)
    packet = _saved_role_shape(packet_raw,role+'_entry_packet',registry)
    expected = dict(context_sha=context_sha,request_sha=request_sha,original_invocation_started=start,
        original_invocation_deadline=deadline,active_deadline=active,closed_deadline=closed,
        role_tree_sha=sha256(tree_raw).hexdigest(),**upstream_fields)
    if role == 'controller':
        expected.update(controller_attempt_nonce=episode['nonce'],attempt_commit_sha=digest(episode),
            attempt_started=episode['started'],attempt_deadline=episode['deadline'])
    else:
        expected.update(reservation_nonce=episode['nonce'],reservation_commit_sha=digest(episode),
            reservation_started=episode['started'],reservation_deadline=episode['deadline'])
    for value in (permit,packet):
        require(all(canonical(value[n]) == canonical(v) for n,v in expected.items()), 'role independent declared binding differs')
    require(permit['context_receipt_sha'] == digest(publication['context_receipt'])
        and permit['producer_identity'] == basis['producer_identity'] and permit['permit_nonce'] == basis['permit_nonce'],
        'role permit emission declaration differs')
    require(packet['context_path'] == publication['context_path'] and packet['context_receipt'] == publication['context_receipt']
        and packet['root_directories_sha'] == digest(publication['root_directories'])
        and packet['source_sha'] == digest(context['source_pins']) and packet['environment_sha'] == digest(context['environment'])
        and packet['ENTRY_pin'] == context['source_pins']['experiments/staged_rts24_saved_fresh_adoption_v1.py']
        and packet['executable_pin'] == context['executable']['pin'], 'role packet independent publication/source declaration')
    for name in ('entry_transport_name','entry_transport_nonce','stage_name','stage_nonce'):
        require(packet[name] == transport[name], 'role independently held transport differs')
    require(packet['permit_binding_sha'] == descriptor['permit_binding_sha'] == sha256(permit_raw).hexdigest()
        and descriptor['packet_sha'] == sha256(packet_raw).hexdigest(), 'role packet descriptor digest chain differs')
    result = object.__new__(cls)
    raws = (packet_raw,permit_raw,descriptor_raw,publication_raw,tree_raw,transport_raw,basis_raw,
        registry_raw,templates_raw,*projection_raws)+((ack_raw,mailbox_header_raw,offer_raw) if role == 'controller' else ())
    for name, value in dict(_raws=raws,_context_data=context_data,_upstream_data=upstream_data,
            _creator=(os.getpid(),get_ident()),_object_id=id(result),_context_id=id(context_data),
            _context_commit=context_data.commit,_upstream_id=id(upstream_data),
            _upstream_commit=None if upstream_data is None else upstream_data.commit,declared_now=now).items():
        object.__setattr__(result,name,value)
    object.__setattr__(result,'commit',digest(result._image()))
    return result.entry()


def validate_saved_controller_entry_data(packet_raw, permit_raw, descriptor_raw, *, context_data,
        publication_raw, tree_raw, transport_raw, basis_raw, ack_raw, mailbox_header_raw, offer_raw,
        broker_ack_raw, registry_raw, templates_raw, now):
    return _validate_saved_entry_data('controller',SavedControllerEntryData,packet_raw,permit_raw,descriptor_raw,
        context_data=context_data,upstream_data=None,publication_raw=publication_raw,tree_raw=tree_raw,
        transport_raw=transport_raw,basis_raw=basis_raw,projection_raws=(broker_ack_raw,),registry_raw=registry_raw,
        templates_raw=templates_raw,now=now,ack_raw=ack_raw,mailbox_header_raw=mailbox_header_raw,offer_raw=offer_raw)


def validate_saved_parent_entry_data(packet_raw, permit_raw, descriptor_raw, *, context_data, controller_data,
        publication_raw, tree_raw, transport_raw, basis_raw, controller_bootstrap_raw, controller_G0_raw,
        controller_store_raw, controller_issuer_raw, registry_raw, templates_raw, now):
    return _validate_saved_entry_data('parent',SavedParentEntryData,packet_raw,permit_raw,descriptor_raw,
        context_data=context_data,upstream_data=controller_data,publication_raw=publication_raw,tree_raw=tree_raw,
        transport_raw=transport_raw,basis_raw=basis_raw,projection_raws=(controller_bootstrap_raw,controller_G0_raw,
            controller_store_raw,controller_issuer_raw),registry_raw=registry_raw,templates_raw=templates_raw,now=now)


def validate_saved_fresh_entry_data(packet_raw, permit_raw, descriptor_raw, *, context_data, parent_data,
        publication_raw, tree_raw, transport_raw, basis_raw, parent_bootstrap_raw, parent_hold_raw,
        parent_store_raw, parent_issuer_raw, registry_raw, templates_raw, now):
    return _validate_saved_entry_data('fresh',SavedFreshEntryData,packet_raw,permit_raw,descriptor_raw,
        context_data=context_data,upstream_data=parent_data,publication_raw=publication_raw,tree_raw=tree_raw,
        transport_raw=transport_raw,basis_raw=basis_raw,projection_raws=(parent_bootstrap_raw,parent_hold_raw,
            parent_store_raw,parent_issuer_raw),registry_raw=registry_raw,templates_raw=templates_raw,now=now)


SAVED_WIRE_CONTRACT_PINS = (
    (72009,'d80a99d39535e2e3a73028f904e29896674c5033a37ae359646fcbf507d8964f'),
    (2365,'4daee71484dda4eaeb97d54ae9ac333b90d15ca75e8ccd57c93339ef587affd7'),
    (16540,'b2d1ab59add27a996d852f52387907e74e709434504e8d71594d97bbef84f67a'),
    SAVED_ROLE_REGISTRY_PIN,SAVED_ROLE_TEMPLATE_PIN)


@dataclass(frozen=True,init=False,eq=False,repr=False,slots=True)
class _SavedWireData:
    _raws: tuple
    _links: tuple
    _edges: tuple
    _facts: bytes
    _creator: tuple
    _object_id: int
    commit: str
    _wire_final = False
    def __new__(cls,*args,**kwargs): raise TypeError('validate wire data explicitly')
    def __init_subclass__(cls,**kwargs):
        if any(getattr(base,'_wire_final',False) for base in cls.__bases__): raise TypeError('exact wire data type required')
    def _image(self):
        return (type(self).__name__,tuple(pin(raw) for raw in self._raws),
            tuple((name,id(kind),oid,commit,creator,context) for name,kind,oid,commit,creator,context in self._edges),
            tuple(id(link) for link in self._links),pin(self._facts),self._creator,self._object_id)
    def entry(self): return _saved_wire_walk(self,set(),{})
    @property
    def raw(self): self.entry(); return self._raws[0]
    @property
    def status_raw(self):
        self.entry()
        return canonical(dict(schema='staged_saved_F_wire_declared_data_check_v1',data_only=True,
            declared_consistency_only=True,checked_scope=type(self).__name__,
            producer_capability_verified=False,actual_sources_verified=False,actual_kernel_identity_verified=False,
            actual_filesystem_identity_verified=False,actual_clock_verified=False,context_origin_creator_verified=False,
            physical_commit_last_verified=False,concurrency_verified=False,full_runtime_verified=False,full_P1_content_verified=False,
            actual_quiet_verified=False,payload_read_authorized=False,role_bootstrap=False,permit_issued=False,owned_child_created=False,
            actual_fresh=False,final_parent_adoption=False,run_authority=False,F_launch_admitted=False,native_authorized=False,
            scientific_evidence_adopted=False,resource_admission=False,formal_result=False,public_P2_execution_enabled=False))
    def __reduce__(self): raise TypeError('wire data is not transferable authority')


class SavedWireContractData(_SavedWireData): __slots__=(); _wire_final=True
class SavedMailboxHeaderData(_SavedWireData): __slots__=(); _wire_final=True
class SavedMailboxHandshakeData(_SavedWireData): __slots__=(); _wire_final=True
class SavedControllerWireData(_SavedWireData): __slots__=(); _wire_final=True
class SavedParentWireData(_SavedWireData): __slots__=(); _wire_final=True
class SavedFreshWireData(_SavedWireData): __slots__=(); _wire_final=True
class SavedControllerStartupJoinData(_SavedWireData): __slots__=(); _wire_final=True
class SavedParentStartupJoinData(_SavedWireData): __slots__=(); _wire_final=True
class SavedFreshStartupJoinData(_SavedWireData): __slots__=(); _wire_final=True
class SavedControllerBindingData(_SavedWireData): __slots__=(); _wire_final=True
class SavedWireTranscriptData(_SavedWireData): __slots__=(); _wire_final=True
class SavedWireFailureData(_SavedWireData): __slots__=(); _wire_final=True
class SavedControllerReturnData(_SavedWireData): __slots__=(); _wire_final=True
class SavedBrokerReturnData(_SavedWireData): __slots__=(); _wire_final=True
class SavedWireDiagnosticData(_SavedWireData): __slots__=(); _wire_final=True


_SAVED_WIRE_TYPES = (SavedWireContractData,SavedMailboxHeaderData,SavedMailboxHandshakeData,
    SavedControllerWireData,SavedParentWireData,SavedFreshWireData,SavedControllerStartupJoinData,
    SavedParentStartupJoinData,SavedFreshStartupJoinData,SavedControllerBindingData,SavedWireTranscriptData,
    SavedWireFailureData,SavedControllerReturnData,SavedBrokerReturnData,SavedWireDiagnosticData)


def _saved_wire_context_id(value):
    if type(value) is SavedSuccessorDataCheck: return id(value)
    if type(value) in _SAVED_WIRE_TYPES and value._links and type(value._links[0]) is SavedSuccessorDataCheck:
        return id(value._links[0])
    return None


def _saved_wire_walk(value,gray,done):
    require(type(value) in _SAVED_WIRE_TYPES,'exact wire data required')
    oid=id(value); require(oid not in gray,'wire data graph cycle')
    if oid in done: return value
    require(value._creator == (os.getpid(),get_ident()) and value._object_id == oid,'original creating wire data required')
    require(type(value._raws) is tuple and all(type(raw) is bytes for raw in value._raws)
        and sum(map(len,value._raws)) <= 8*1024**2 and type(value._facts) is bytes and len(value._facts) <= 65536,
        'wire immutable raw budget')
    require(type(value._links) is type(value._edges) is tuple and len(value._links)==len(value._edges)<=5,'wire data edge shape')
    _saved_wire_layout(value)
    if type(value) is SavedWireContractData:
        require(len(value._raws)==len(SAVED_WIRE_CONTRACT_PINS) and all(
            len(raw)==expected[0] and sha256(raw).hexdigest()==expected[1]
            for raw,expected in zip(value._raws,SAVED_WIRE_CONTRACT_PINS)),'fixed wire contract changed')
    gray.add(oid)
    try:
        for index,(link,edge) in enumerate(zip(value._links,value._edges)):
            name,kind,expected_id,expected_commit,creator,context=edge
            require(name==str(index) and type(link) is kind and id(link)==expected_id and link.commit==expected_commit,
                'wire original edge object/type/commit required')
            require(_saved_wire_context_id(link)==context,'wire original edge context required')
            if kind is SavedSuccessorDataCheck:
                require(creator is None,'context origin creator not observed')
                if id(link) not in done: link.entry();done[id(link)]=link.commit
            else:
                require(kind in _SAVED_WIRE_TYPES and link._creator==creator==(os.getpid(),get_ident()),'wire edge creator differs')
                _saved_wire_walk(link,gray,done)
        require(value.commit==digest(value._image()),'wire data immutable commit changed')
        done[oid]=value.commit
    finally: gray.remove(oid)
    return value


def _saved_wire_new(cls,raws,links,facts):
    require(cls in _SAVED_WIRE_TYPES,'closed wire result class')
    value=object.__new__(cls)
    edges=tuple((str(index),type(link),id(link),link.commit,
        None if type(link) is SavedSuccessorDataCheck else link._creator,_saved_wire_context_id(link)) for index,link in enumerate(links))
    for name,item in dict(_raws=tuple(raws),_links=tuple(links),_edges=edges,_facts=canonical(facts),
            _creator=(os.getpid(),get_ident()),_object_id=id(value)).items():object.__setattr__(value,name,item)
    object.__setattr__(value,'commit',digest(value._image()));return value.entry()


def validate_saved_wire_contract_data(domains_raw,templates_raw,dag_raw,old_domains_raw,old_templates_raw):
    raws=(domains_raw,templates_raw,dag_raw,old_domains_raw,old_templates_raw)
    for data,expected in zip(raws,SAVED_WIRE_CONTRACT_PINS):
        require(type(data) is bytes and len(data)==expected[0] and sha256(data).hexdigest()==expected[1],
            'fixed wire contract bytes differ')
    return _saved_wire_new(SavedWireContractData,raws,(),dict(schema_count=45,historical_design_sources_only=True))


def _saved_wire_contracts(value):
    require(type(value) is SavedWireContractData,'exact pinned wire contracts required');value.entry()
    return parse(value._raws[0]),parse(value._raws[1]),parse(value._raws[3]),parse(value._raws[4])


def _saved_wire_type(value,ref,contracts,context_data):
    registry,template,old,old_templates=contracts
    if type(ref) is dict:
        if 'literal' in ref:require(canonical(value)==canonical(ref['literal']),'wire fixed literal differs');return
        require(set(ref)=={'nullable'},'wire nullable rule')
        if value is not None:_saved_wire_type(value,ref['nullable'],contracts,context_data)
        return
    if ref.startswith('type:'):return _saved_wire_type(value,ref[5:],contracts,context_data)
    if ref.startswith('schema:'):return _saved_wire_named(value,ref[7:],contracts,context_data)
    rule=registry['types'][ref];kind=rule['kind']
    if kind=='sha':require(_hex64(value),'wire SHA domain')
    elif kind=='uint':_successor_integer(value,rule['low'],rule['high'])
    elif kind=='float':_saved_role_time(value)
    elif kind=='bool':require(type(value) is bool,'wire exact bool required')
    elif kind=='name':_saved_role_name(value)
    elif kind in ('ascii','encoded_string'):
        require(type(value) is str and len(canonical(value))<=rule['encoded_max'],'wire encoded string cap')
        if kind=='ascii':require(len(value)<=rule['characters_max'] and value.isascii(),'wire ASCII type domain')
    elif kind=='enum':require(type(value) is str and value in rule['values'],'wire enum differs')
    elif kind=='nullable':
        if value is not None:_saved_wire_type(value,rule['item'],contracts,context_data)
    elif kind in ('tuple','array'):
        require(type(value) is list,'wire exact array required')
        if kind=='tuple':
            require(len(value)==len(rule['items']),'wire tuple length')
            for item,sub in zip(value,rule['items']):_saved_wire_type(item,sub,contracts,context_data)
        else:
            require(rule['min_items']<=len(value)<=rule['max_items'],'wire array item cap')
            for item in value:_saved_wire_type(item,rule['item'],contracts,context_data)
    elif kind=='object':
        require(type(value) is dict and set(value)==set(rule['fields']),'wire closed object fields')
        for name,sub in rule['fields'].items():_saved_wire_type(value[name],sub,contracts,context_data)
        if ref=='pin':require(rule['bytes_lower']<=value['bytes']<=rule['bytes_upper'],'wire positive pin bytes')
    elif kind=='fixed_directories':
        require(type(value) is list and len(value)==len(rule['paths'])<=16,'wire directory chain')
        for row,path in zip(value,rule['paths']):
            require(type(row) is list and len(row)==3 and row[0]==path,'wire fixed directory path')
            _successor_integer(row[1],0,2**64-1);_successor_integer(row[2],0,2**128-1)
    elif kind=='command_line':
        require(type(value) is str and '\0' not in value and len(canonical(value))<=16384,'wire command line domain')
    elif kind=='union':
        for choice in rule['choices']:
            try:_saved_wire_type(value,choice,contracts,context_data)
            except ValueError:continue
            return
        raise ValueError('wire union domain differs')
    elif kind=='frozen':
        encoded=canonical(value);require(len(encoded)<=rule['encoded_max'],'wire frozen encoded cap')
        if 'frozen_schema' in rule:_saved_role_shape(encoded,rule['frozen_schema'],old)
        elif ref=='old_context':
            require(type(context_data) is SavedSuccessorDataCheck and encoded==context_data._raw,'wire original context data differs')
        else:
            require(ref=='receipt','unknown frozen wire type');keys(value,'bytes sha256 identity')
            _successor_integer(value['bytes'],1,2097152);require(_hex64(value['sha256']),'wire receipt SHA')
            require(type(value['identity']) is list and len(value['identity'])==4,'wire receipt identity')
            for item in value['identity']:_successor_integer(item,0,2**64-1)
            require(value['identity'][2]==value['bytes'],'wire receipt size')
    else:raise ValueError('unknown fixed wire type')


def _saved_wire_named(value,name,contracts,context_data):
    spec=contracts[0]['schemas'][name]
    require(type(value) is dict and set(value)==set(spec['fields']),'wire closed schema fields')
    require(len(canonical(value))<=spec['value_cap'],'wire schema encoded cap')
    for field,ref in spec['fields'].items():_saved_wire_type(value[field],ref,contracts,context_data)
    return value


def _saved_wire_raw(data,name,contracts,context_data):
    require(type(data) is bytes and 0<len(data)<=contracts[0]['schemas'][name]['value_cap'],'wire raw schema cap')
    return _saved_wire_named(parse(data),name,contracts,context_data)


def _saved_wire_slot(raw,size,*,header=False):
    require(type(raw) is bytes and type(size) is int and size in (4096,32768,2113580,4652,36908,18476,131116)
        and 0<len(raw)<=size-44 and type(header) is bool,'wire slot byte cap')
    marker=b'GRIDHDR1' if header else b'GRIDFRM1'
    return struct.pack('<I',len(raw))+raw+b'\0'*(size-44-len(raw))+sha256(raw).digest()+marker


def _saved_wire_decode(slot,size,*,header=False):
    require(type(slot) is bytes and len(slot)==size and type(header) is bool,'wire physical slot size')
    length=struct.unpack('<I',slot[:4])[0];marker=b'GRIDHDR1' if header else b'GRIDFRM1'
    require(0<length<=size-44 and slot[-8:]==marker,'wire slot commit/length differs')
    raw=slot[4:4+length]
    require(slot[4+length:-40]==b'\0'*(size-44-length) and sha256(raw).digest()==slot[-40:-8],
        'wire slot digest/zero tail differs')
    return raw


def _saved_wire_layout(value):
    cls=type(value);ctx=SavedSuccessorDataCheck;contracts=SavedWireContractData
    layouts={SavedWireContractData:(),SavedMailboxHeaderData:(ctx,contracts),
        SavedMailboxHandshakeData:(ctx,contracts,SavedMailboxHeaderData),
        SavedControllerWireData:(ctx,contracts,SavedMailboxHandshakeData),
        SavedParentWireData:(ctx,contracts,SavedControllerStartupJoinData),SavedFreshWireData:(ctx,contracts,SavedParentStartupJoinData),
        SavedControllerStartupJoinData:(ctx,contracts,SavedControllerWireData),SavedParentStartupJoinData:(ctx,contracts,SavedParentWireData),
        SavedFreshStartupJoinData:(ctx,contracts,SavedFreshWireData),
        SavedControllerBindingData:(ctx,contracts,SavedMailboxHandshakeData,SavedControllerStartupJoinData),
        SavedWireFailureData:(contracts,),SavedControllerReturnData:(ctx,contracts,SavedControllerBindingData),
        SavedWireDiagnosticData:(ctx,contracts,SavedControllerWireData)}
    if cls is SavedBrokerReturnData:
        require(len(value._links) in (3,4),'broker return link count')
        expected=(ctx,contracts,SavedMailboxHeaderData)+((SavedControllerReturnData,) if len(value._links)==4 else ())
    elif cls is SavedWireTranscriptData:
        facts=parse(value._facts);role=facts['role'];require(role in ('controller','parent','fresh'),'stage role data domain')
        choices=(SavedControllerWireData,SavedParentWireData,SavedFreshWireData) if facts['early'] else (
            SavedControllerStartupJoinData,SavedParentStartupJoinData,SavedFreshStartupJoinData)
        expected=(ctx,contracts,choices[('controller','parent','fresh').index(role)])
    else:expected=layouts[cls]
    require(tuple(type(link) for link in value._links)==expected,'wire fixed role/field edge differs')
    own_context=_saved_wire_context_id(value)
    if own_context is not None:
        require(all(_saved_wire_context_id(link) in (None,own_context) for link in value._links),'wire shared original context required')


def _saved_wire_ref(value,obj):
    creator=type(obj) is not SavedSuccessorDataCheck
    keys(value,'object_id commit'+(' creator' if creator else ''))
    _successor_integer(value['object_id'],1,2**64-1)
    require(value['object_id']==id(obj) and value['commit']==obj.commit,'wire caller original object differs')
    if creator:
        require(type(value['creator']) is list and value['creator']==list(obj._creator),'wire caller original creator differs')
        for part in value['creator']:_successor_integer(part,1,2**64-1)


def _saved_wire_basis(raw,role,context,upstream,contracts):
    value=_saved_role_bytes(raw,65536)
    keys(value,'schema context_ref upstream_ref producer_identity entry_name entry_nonce stage_name stage_nonce '
        'permit_nonce episode_nonce episode_commit_sha episode_started episode_deadline upstream_stage_nonce role_tree_pin projection_pins projection_image_shas'+
        ('' if role=='controller' else ' input_metadata_sha runtime_binding_sha receipt_commit_sha'))
    require(value['schema']=='staged_saved_F_'+role+'_wire_basis_declaration_v1','wire local basis domain differs')
    _saved_wire_ref(value['context_ref'],context);_saved_wire_ref(value['upstream_ref'],upstream)
    _saved_role_identity(value['producer_identity'])
    for name in ('entry_name','stage_name'):_saved_role_name(value[name])
    for name in ('entry_nonce','stage_nonce','permit_nonce','episode_nonce','episode_commit_sha','upstream_stage_nonce'):
        require(_hex64(value[name]),'wire independent basis SHA')
    require(value['entry_name']!=value['stage_name'] and value['entry_nonce']!=value['stage_nonce'],'wire basis transport aliases')
    for name in ('episode_started','episode_deadline'):_saved_role_time(value[name])
    _saved_wire_type(value['role_tree_pin'],'pin',contracts,context)
    names=contracts[0]['cross_field_constraints']['projections']['bundles'][role]
    require(type(value['projection_pins']) is dict and set(value['projection_pins'])==set(names),'wire basis projection pin domain')
    for p in value['projection_pins'].values():_saved_wire_type(p,'pin',contracts,context)
    image_names={n for n in names if not n.endswith('_bootstrap_projection')}
    require(type(value['projection_image_shas']) is dict and set(value['projection_image_shas'])==image_names,'wire independent projection image domain')
    require(all(_hex64(v) for v in value['projection_image_shas'].values()),'wire independent image SHA')
    if role!='controller':
        require(all(_hex64(value[n]) for n in ('input_metadata_sha','runtime_binding_sha','receipt_commit_sha')),'wire independent opaque image SHA')
    return value


def _saved_wire_mailbox(slot,kind,header_data,contracts,*,previous=None,controller_identity=None):
    require(type(header_data) is SavedMailboxHeaderData,'original mailbox header data required')
    context=header_data._links[0];header=parse(_saved_wire_decode(header_data._raws[0],4096))
    rule=contracts[0]['cross_field_constraints']['mailbox_kinds'][kind]
    raw=_saved_wire_decode(slot,dict(contracts[1]['mailbox_slots'])[kind]);value=_saved_wire_raw(raw,'mailbox_envelope',contracts,context)
    producer=controller_identity if rule['direction']=='controller' else header[
        ('broker' if rule['direction'] in ('broker_terminal','broker_probe') else rule['direction'])+'_identity']
    require(value['kind']==kind and value['sequence']==rule['sequence']
        and value['previous_sha']==('0'*64 if previous is None else sha256(previous).hexdigest())
        and value['producer_identity']==producer and value['direction_nonce']==header['direction_nonces'][rule['direction']]
        and value['binding_sha']==sha256(header_data._raws[0]).hexdigest(),'wire mailbox independent envelope binding differs')
    require((previous is None)==(rule['previous_kind'] is None),'wire mailbox predecessor required')
    if previous is not None:require(parse(previous)['kind']==rule['previous_kind'],'wire mailbox predecessor kind differs')
    _saved_wire_type(value['payload'],contracts[0]['mailbox_payloads'][kind],contracts,context)
    return raw,value['payload']


def validate_saved_mailbox_header_data(header_slot,*,context_data,contract_data,basis_raw):
    require(type(context_data) is SavedSuccessorDataCheck,'wire exact context data required');context_data.entry()
    contracts=_saved_wire_contracts(contract_data);context=parse(context_data._raw);request=parse(context_data._request_raw)
    value=_saved_wire_raw(_saved_wire_decode(header_slot,4096),'mailbox_header',contracts,context_data)
    basis=_saved_role_bytes(basis_raw,65536)
    keys(basis,'schema context_ref mailbox_name direction_nonces context_receipt root_directories broker_stage_nonce broker_episode_commit_sha')
    require(basis['schema']=='staged_saved_F_wire_handshake_basis_declaration_v1','wire handshake local basis domain')
    _saved_wire_ref(basis['context_ref'],context_data);_saved_role_name(basis['mailbox_name'])
    for name in ('broker_stage_nonce','broker_episode_commit_sha'):require(_hex64(basis[name]),'wire broker basis SHA')
    _saved_wire_type(basis['direction_nonces'],'direction_nonces',contracts,context_data)
    require(len(set(basis['direction_nonces'].values()))==5,'wire direction nonces alias')
    _saved_wire_type(basis['context_receipt'],'receipt',contracts,context_data)
    require({k:basis['context_receipt'][k] for k in ('bytes','sha256')}==pin(context_data._raw),'wire context receipt bytes differ')
    _successor_directories(basis['root_directories'],OUTPUT)
    require(basis['root_directories'][:-1]==context['output_parent_directories'],'wire published root chain differs')
    host=request['host_identity'];broker=context['broker_identity']
    require(value['name']==basis['mailbox_name'] and value['request_sha']==sha256(context_data._request_raw).hexdigest()
        and value['direction_nonces']==basis['direction_nonces'] and value['host_identity']==[host['pid'],host['creation_filetime']]
        and value['broker_identity']==[broker['pid'],broker['creation_filetime']],'wire original host/broker header differs')
    return _saved_wire_new(SavedMailboxHeaderData,(header_slot,basis_raw),(context_data,contract_data),dict(header_only=True))


def validate_saved_mailbox_handshake_data(header_data,request_slot,ready_slot,start_slot,offer_slot,ack_slot,*,now):
    require(type(header_data) is SavedMailboxHeaderData,'exact mailbox header data required');header_data.entry();_saved_role_time(now)
    context_data,contract_data=header_data._links;contracts=_saved_wire_contracts(contract_data)
    context=parse(context_data._raw);request=parse(context_data._request_raw);basis=parse(header_data._raws[1])
    header=parse(_saved_wire_decode(header_data._raws[0],4096));request_raw,wire_request=_saved_wire_mailbox(request_slot,'request',header_data,contracts)
    require(canonical(wire_request)==context_data._request_raw,'wire independent original request differs')
    ready_raw,ready=_saved_wire_mailbox(ready_slot,'ready',header_data,contracts)
    start_raw,start=_saved_wire_mailbox(start_slot,'start',header_data,contracts,previous=request_raw)
    offer_raw,offer=_saved_wire_mailbox(offer_slot,'context',header_data,contracts,previous=ready_raw)
    _,ack=_saved_wire_mailbox(ack_slot,'ack',header_data,contracts,previous=start_raw)
    request_sha=sha256(context_data._request_raw).hexdigest();context_sha=sha256(context_data._raw).hexdigest()
    s,d=context['invocation_started'],context['deadline'];header_sha=sha256(header_data._raws[0]).hexdigest()
    require(ready['request_sha']==start['request_sha']==offer['request_sha']==ack['request_sha']==request_sha
        and ready['mailbox_header_sha']==start['mailbox_header_sha']==header_sha
        and ready['broker_identity']==header['broker_identity'] and start['host_identity']==header['host_identity'],
        'wire handshake request/header identities differ')
    for data in (ready,start,ack):
        require(data['original_invocation_started']==s and data['original_invocation_deadline']==d,'wire original invocation clock reset')
    require(ready['standby_deadline']==min(s+10.,d) and s<=ready['ready_at']<=start['sent_at']<=offer['published_at']<=now<ready['standby_deadline'],
        'wire READY/START/publication declared order/deadline')
    require(start['READY_sha']==sha256(canonical(ready)).hexdigest() and offer['START_sha']==sha256(canonical(start)).hexdigest(),
        'wire READY/START raw chain differs')
    require(offer['context_sha']==context_sha and canonical(offer['context'])==context_data._raw
        and offer['context_receipt']==basis['context_receipt'] and offer['root_directories']==basis['root_directories']
        and offer['broker_identity']==header['broker_identity'],'wire independent context offer differs')
    expected=dict(context_sha=context_sha,request_sha=request_sha,offer_sha=sha256(canonical(offer)).hexdigest(),
        mailbox_header_sha=header_sha,context_receipt_sha=digest(basis['context_receipt']),root_directories_sha=digest(basis['root_directories']),
        host_identity=header['host_identity'],broker_identity=header['broker_identity'],host_direction_nonce=header['direction_nonces']['host'],
        runtime_binding_contract_sha=context['runtime_binding_contract_sha'],deadline_profile_sha=context['deadline_profile_sha'])
    require(all(canonical(ack[k])==canonical(v) for k,v in expected.items()),'wire independently bound ACK differs')
    return _saved_wire_new(SavedMailboxHandshakeData,(canonical(ack),request_slot,ready_slot,start_slot,offer_slot,ack_slot),
        (context_data,contract_data,header_data),dict(now=now,context_sha=context_sha,request_sha=request_sha))


def _saved_wire_handshake(value):
    seen=set()
    while type(value) is not SavedMailboxHandshakeData:
        require(type(value) in (SavedControllerWireData,SavedParentWireData,SavedFreshWireData,
            SavedControllerStartupJoinData,SavedParentStartupJoinData,SavedFreshStartupJoinData) and id(value) not in seen,
            'wire original handshake ancestry required')
        seen.add(id(value));value=value._links[2]
    return value


def _saved_wire_tree(raw,header_data):
    tree=_saved_role_bytes(raw,65536);basis=parse(header_data._raws[1])
    require(type(tree) is list and len(tree)==7,'wire role tree image')
    for row,name in zip(tree[:6],('','worker','worker/fresh','worker/fresh_parent','parent','diagnostics')):
        require(type(row) is list and len(row)==2 and row[0]==name,'wire fixed role tree names')
        _successor_directories(row[1],OUTPUT/name)
        require(row[1][:len(basis['root_directories'])]==basis['root_directories'],'wire tree original root differs')
    require(tree[-1]==['context_file_identity',basis['context_receipt']['identity']],'wire tree original context identity differs')


def _saved_wire_argv(role,packet_raw,descriptor_raw,header,handshake,contracts):
    context=handshake._links[0];mailbox=handshake._links[2];mailbox_header=parse(_saved_wire_decode(mailbox._raws[0],4096))
    values=dict(entry_transport_name=header['name'],entry_transport_nonce=header['entry_nonce'],stage_name=header['stage_name'],
        stage_nonce=header['stage_nonce'],packet_sha=sha256(packet_raw).hexdigest(),descriptor_sha=sha256(descriptor_raw).hexdigest(),
        context_sha=sha256(context._raw).hexdigest(),request_sha=sha256(context._request_raw).hexdigest(),
        mailbox_name=mailbox_header['name'],ACK_sha=sha256(handshake._raws[0]).hexdigest())
    grammar=contracts[0]['types'][role+'_argv'];result=[]
    for token,item in zip(grammar['grammar'],grammar['items']):
        result.append(values[token[1:-1]] if token.startswith('{') else item['literal'])
    return result


def _saved_wire_projections(role,bundle,basis,upstream,handshake,contracts,context_data,tree_raw):
    context=parse(context_data._raw);context_sha=sha256(context_data._raw).hexdigest();request_sha=sha256(context_data._request_raw).hexdigest()
    names=contracts[0]['cross_field_constraints']['projections']['bundles'][role]
    require(all(pin(canonical(bundle[name]))==basis['projection_pins'][name] for name in names),'wire independent projection raw differs')
    source_packet=source_binding=None
    if role!='controller':
        source_wire=upstream._links[2];source_packet=sha256(source_wire._raws[0]).hexdigest();source_binding=sha256(source_wire._raws[1]).hexdigest()
        bootstrap=names[0];require(canonical(bundle[bootstrap])==upstream._raws[0],'wire original upstream bootstrap raw differs')
        previous=parse(upstream._facts)['now'];bootstrap_sha=sha256(upstream._raws[0]).hexdigest()
    else:previous=parse(handshake._facts)['now'];bootstrap_sha=None
    for name in names:
        value=bundle[name]
        if name.endswith('_bootstrap_projection'):
            require(value['self_identity']==basis['producer_identity'],'wire upstream bootstrap producer differs')
            continue
        require(value['context_sha']==context_sha and value['request_sha']==request_sha and value['producer_identity']==basis['producer_identity']
            and value['stage_nonce']==basis['upstream_stage_nonce'] and value['source_packet_sha']==source_packet
            and value['source_permit_binding_sha']==source_binding and value['source_image_sha']==basis['projection_image_shas'][name],
            'wire independently declared projection binding differs')
        require(previous<=value['observed_at']<=basis['episode_started'],'wire projection-before-episode order differs');previous=value['observed_at']
        if role=='controller':
            header=handshake._links[2];offer=parse(_saved_wire_decode(handshake._raws[4],2113580))['payload']
            require(value['ACK_sha']==sha256(handshake._raws[0]).hexdigest() and value['mailbox_header_sha']==sha256(header._raws[0]).hexdigest()
                and value['offer_sha']==sha256(canonical(offer)).hexdigest(),'wire broker ACK projection differs')
            continue
        require(value['bootstrap_image_sha']==bootstrap_sha,'wire bootstrap dependency image differs')
        hold_name='controller_G0_projection' if role=='parent' else 'parent_hold_projection'
        if name==hold_name:
            require(value['input_files_sha']==digest(context['input_files']) and value['input_metadata_sha']==basis['input_metadata_sha']
                and value['anchor_sha']==context['anchor_sha'] and value['source_sha']==digest(context['source_pins'])
                and value['runtime_binding_sha']==basis['runtime_binding_sha'],'wire independent hold image differs')
        elif name.endswith('_store_projection'):
            field='G0_image_sha' if role=='parent' else 'hold_image_sha'
            require(value[field]==sha256(canonical(bundle[hold_name])).hexdigest() and value['tree_sha']==sha256(tree_raw).hexdigest()
                and value['receipt_commit_sha']==basis['receipt_commit_sha'],'wire store hold/tree dependency differs')
        else:
            field='G0_image_sha' if role=='parent' else 'hold_image_sha';store='controller_store_projection' if role=='parent' else 'parent_store_projection'
            require(value[field]==sha256(canonical(bundle[hold_name])).hexdigest()
                and value['store_image_sha']==sha256(canonical(bundle[store])).hexdigest(),'wire issuer original dependencies differ')
            if role=='parent':require(value['ACK_sha']==sha256(handshake._raws[0]).hexdigest(),'wire controller issuer ACK differs')


def _validate_saved_role_wire_data(role,cls,entry_slots,descriptor_raw,*,upstream_data,basis_raw,role_tree_raw,now):
    upstream_cls=dict(controller=SavedMailboxHandshakeData,parent=SavedControllerStartupJoinData,fresh=SavedParentStartupJoinData)[role]
    require(type(upstream_data) is upstream_cls,'wire fixed original upstream data required');upstream_data.entry();_saved_role_time(now)
    context_data,contract_data=upstream_data._links[:2];contracts=_saved_wire_contracts(contract_data)
    context=parse(context_data._raw);handshake=_saved_wire_handshake(upstream_data);mailbox=handshake._links[2]
    mailbox_basis=parse(mailbox._raws[1]);mailbox_header=parse(_saved_wire_decode(mailbox._raws[0],4096))
    basis=_saved_wire_basis(basis_raw,role,context_data,upstream_data,contracts)
    _saved_wire_tree(role_tree_raw,mailbox);require(pin(role_tree_raw)==basis['role_tree_pin'],'wire independent role tree pin differs')
    require(type(entry_slots) is tuple and len(entry_slots)==4,'wire complete four-slot entry prefix required')
    header_raw=_saved_wire_decode(entry_slots[0],4096,header=True);header=_saved_wire_raw(header_raw,role+'_entry_header',contracts,context_data)
    bundle_raw=_saved_wire_decode(entry_slots[1],18476);bundle=_saved_wire_raw(bundle_raw,role+'_projection_bundle',contracts,context_data)
    binding_envelope_raw=_saved_wire_decode(entry_slots[2],4652);binding_envelope=_saved_wire_raw(binding_envelope_raw,role+'_binding_frame',contracts,context_data)
    packet_envelope_raw=_saved_wire_decode(entry_slots[3],36908);packet_envelope=_saved_wire_raw(packet_envelope_raw,role+'_packet_frame',contracts,context_data)
    permit_raw=canonical(binding_envelope['payload']);packet_raw=canonical(packet_envelope['payload'])
    permit,packet=binding_envelope['payload'],packet_envelope['payload']
    descriptor=_saved_role_shape(descriptor_raw,role+'_stage_descriptor',contracts[2])
    context_sha=sha256(context_data._raw).hexdigest();request_sha=sha256(context_data._request_raw).hexdigest()
    require(header['context_sha']==context_sha and header['request_sha']==request_sha and header['name']==basis['entry_name']
        and header['entry_nonce']==basis['entry_nonce'] and header['stage_name']==basis['stage_name'] and header['stage_nonce']==basis['stage_nonce']
        and header['producer_identity']==basis['producer_identity'],'wire caller-held entry header differs')
    require(header['packet_sha']==descriptor['packet_sha']==sha256(packet_raw).hexdigest()
        and header['permit_binding_sha']==descriptor['permit_binding_sha']==packet['permit_binding_sha']==sha256(permit_raw).hexdigest()
        and header['descriptor_sha']==sha256(descriptor_raw).hexdigest() and header['projection_bundle_sha']==sha256(bundle_raw).hexdigest(),
        'wire pre-owner hash DAG differs')
    for frame in (binding_envelope,packet_envelope):
        require(frame['producer_identity']==basis['producer_identity'] and frame['direction_nonce']==basis['entry_nonce']
            and frame['binding_sha']==sha256(entry_slots[0]).hexdigest(),'wire entry frame header/producer differs')
    require(binding_envelope['previous_sha']=='0'*64 and packet_envelope['previous_sha']==sha256(binding_envelope_raw).hexdigest(),
        'wire complete entry frame chain differs')
    expected_producer=mailbox_header['broker_identity'] if role=='controller' else parse(upstream_data._raws[0])['self_identity']
    expected_stage=mailbox_basis['broker_stage_nonce'] if role=='controller' else parse(upstream_data._links[2]._raws[0])['stage_nonce']
    require(basis['producer_identity']==expected_producer and basis['upstream_stage_nonce']==expected_stage,'wire producer/upstream stage differs')
    ancestor_names={mailbox_header['name']};ancestor_nonces={mailbox_basis['broker_stage_nonce'],*mailbox_header['direction_nonces'].values()}
    ancestor=None if role=='controller' else upstream_data._links[2]
    while ancestor is not None:
        previous=parse(ancestor._raws[7]);ancestor_names.update((previous['entry_name'],previous['stage_name']))
        ancestor_nonces.update((previous['entry_nonce'],previous['stage_nonce']))
        ancestor=None if type(ancestor) is SavedControllerWireData else ancestor._links[2]._links[2]
    require(not {basis['entry_name'],basis['stage_name']}&ancestor_names and not {basis['entry_nonce'],basis['stage_nonce']}&ancestor_nonces,
        'wire transport aliases ancestor')
    s,d=context['invocation_started'],context['deadline'];tail=descriptor['quiesce_seconds']+descriptor['terminal_seconds']
    require(basis['episode_deadline']==min(d,basis['episode_started']+descriptor['total_seconds']),'wire original episode deadline differs')
    active=min(s+contracts[3]['deadlines'][role][0],d,basis['episode_deadline']-tail)
    closed=min(s+contracts[3]['deadlines'][role][1],d,basis['episode_deadline'])
    require(parse(upstream_data._facts)['now']<=basis['episode_started']<=now<=active and s<=basis['episode_started']<active<=closed<=d,
        'wire original episode remaining declared time')
    common=dict(context_sha=context_sha,request_sha=request_sha,original_invocation_started=s,original_invocation_deadline=d,
        active_deadline=active,closed_deadline=closed,role_tree_sha=sha256(role_tree_raw).hexdigest())
    if role=='controller':common.update(controller_attempt_nonce=basis['episode_nonce'],attempt_commit_sha=basis['episode_commit_sha'],
        attempt_started=basis['episode_started'],attempt_deadline=basis['episode_deadline'],ACK_sha=sha256(handshake._raws[0]).hexdigest(),
        mailbox_header_sha=sha256(mailbox._raws[0]).hexdigest())
    else:common.update(reservation_nonce=basis['episode_nonce'],reservation_commit_sha=basis['episode_commit_sha'],
        reservation_started=basis['episode_started'],reservation_deadline=basis['episode_deadline'],
        **{('controller' if role=='parent' else 'parent')+'_permit_binding_sha':sha256(upstream_data._links[2]._raws[1]).hexdigest()})
    for name,field in contracts[0]['cross_field_constraints']['projections']['packet_sha_fields'][role].items():
        common[field]=sha256(canonical(bundle[name])).hexdigest()
    for value in (permit,packet):require(all(canonical(value[k])==canonical(v) for k,v in common.items()),'wire independent packet/permit fields differ')
    require(permit['producer_identity']==basis['producer_identity'] and permit['permit_nonce']==basis['permit_nonce']
        and permit['context_receipt_sha']==digest(mailbox_basis['context_receipt']),'wire producer permit declaration differs')
    require(packet['context_path']==str(OUTPUT/'context.json') and packet['context_receipt']==mailbox_basis['context_receipt']
        and packet['root_directories_sha']==digest(mailbox_basis['root_directories']) and packet['source_sha']==digest(context['source_pins'])
        and packet['environment_sha']==digest(context['environment']) and packet['ENTRY_pin']==context['source_pins']['experiments/staged_rts24_saved_fresh_adoption_v1.py']
        and packet['executable_pin']==context['executable']['pin'],'wire independent source/publication declaration differs')
    for field,key in (('entry_transport_name','entry_name'),('entry_transport_nonce','entry_nonce'),('stage_name','stage_name'),('stage_nonce','stage_nonce')):
        require(packet[field]==basis[key],'wire independently declared packet transport differs')
    require(header['original_invocation_started']==s and header['original_invocation_deadline']==d,'wire header original deadline differs')
    _saved_wire_projections(role,bundle,basis,upstream_data,handshake,contracts,context_data,role_tree_raw)
    require(header['argv_sha']==digest(_saved_wire_argv(role,packet_raw,descriptor_raw,header,handshake,contracts)),'wire frozen argv SHA differs')
    return _saved_wire_new(cls,(packet_raw,permit_raw,descriptor_raw,*entry_slots,basis_raw,role_tree_raw),
        (context_data,contract_data,upstream_data),dict(role=role,now=now))


def validate_saved_controller_wire_data(entry_slots,descriptor_raw,*,handshake_data,basis_raw,role_tree_raw,now):
    return _validate_saved_role_wire_data('controller',SavedControllerWireData,entry_slots,descriptor_raw,
        upstream_data=handshake_data,basis_raw=basis_raw,role_tree_raw=role_tree_raw,now=now)


def validate_saved_parent_wire_data(entry_slots,descriptor_raw,*,controller_join_data,basis_raw,role_tree_raw,now):
    return _validate_saved_role_wire_data('parent',SavedParentWireData,entry_slots,descriptor_raw,
        upstream_data=controller_join_data,basis_raw=basis_raw,role_tree_raw=role_tree_raw,now=now)


def validate_saved_fresh_wire_data(entry_slots,descriptor_raw,*,parent_join_data,basis_raw,role_tree_raw,now):
    return _validate_saved_role_wire_data('fresh',SavedFreshWireData,entry_slots,descriptor_raw,
        upstream_data=parent_join_data,basis_raw=basis_raw,role_tree_raw=role_tree_raw,now=now)


if __name__ == '__main__':
if __name__ == '__main__':
    if sys.argv[1:2] == ['--ordinary-entry']: _ordinary_file_dispatch(sys.argv[1:])
    elif sys.argv[1:2] == [DIRECT_ENTRY_PROBE_FLAG]: _ordinary_direct_entry_cli(sys.argv[1:])
    else: raise SystemExit('Saved F role execution and trusted invocation remain draft. F launch remains disabled.')
