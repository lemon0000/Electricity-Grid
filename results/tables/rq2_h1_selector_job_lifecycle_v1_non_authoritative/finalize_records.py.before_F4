"""Root-only create-once scoped development evidence; no formal authority."""
from pathlib import Path
import hashlib
import json
import re
import subprocess

p=Path(__file__).parent
def sha(f):return hashlib.sha256(Path(f).read_bytes()).hexdigest()
def read(f):return json.loads(Path(f).read_text(encoding='utf-8'))
def write(f,value):
    with Path(f).open('x',encoding='utf-8') as stream:json.dump(value,stream,indent=2,ensure_ascii=False)

current=read(p/'before_test_02.json')
assert all(sha(f)==h for f,h in current.items())
review=read(p/'independent_review_02.json')
assert review['status']=='PRE_SEAL_SCOPED_FINDINGS_CLOSED' and review['reading_stopped']
assert review['reviewed_hashes']==current
assert review['independent_test']['exit_code']==0 and review['independent_test']['files_unchanged']
tests={}
for stem,count in [('root_test_02',47),('root_regression_01',36)]:
    result=read(p/(stem+'.json'))
    assert result['exit_code']==0 and result['files_unchanged']
    match=re.search(r'(\d+) passed in ([0-9.]+)s',(p/(stem+'.log')).read_text(encoding='utf-8'))
    assert match and int(match[1])==count
    tests[stem]=dict(result,passed=count,pytest_seconds=float(match[2]))

old=Path('results/tables/rq2_h1_selector_worker_transport_v1_non_authoritative/development_checks.json')
assert sha(old)=='ffaac9c43850b0a6ce58506fe21ce50a2f1cc70a25b1aedc4ed6a21b2ee10ce5'
pins=dict(read(old)['files_sha256']);assert len(pins)==1027
assert all(sha(f)==h for f,h in pins.items())
pins.update(current);assert len(pins)==1030
frozen={}
for v,outer_pin,nouter,nrun in [
    (2,'79830ab6c1b31aaef41174544e472ef800674de1f76228793f30f6b87e4f6eba',895,248),
    (3,'e3acc7a6de1c1863ab64a8c1ae67ded9676e01c564a3d4ef2d0be29252f0edcf',1695,251)]:
    outer=Path(f'configs/rq2_normal_h1_calibration_v{v}.OUTER.SHA256SUMS.json')
    members=read(outer)['members'];assert sha(outer)==outer_pin and len(members)==nouter
    assert all(sha(f)==h for f,h in members.items())
    inventory=read(f'results/tables/rq2_normal_h1_full_job_v{v}_non_authoritative/calibration_v{v}.postrun_inventory.json')
    assert len(inventory['members'])==nrun
    for f,item in inventory['members'].items():
        path=Path(inventory['root'])/f
        assert sha(path)==item['sha256'] and path.stat().st_size==item['bytes']
    frozen[str(v)]=dict(outer_sha256=outer_pin,member_count=nouter,member_drift=[],run_count=nrun,run_drift=[])
assembly=read('results/tables/rq2_h1_bootstrap_phase_manifest_binding_v1_non_authoritative/development_checks.json')['reviewed_open_assembly']
assert all(sha(f)==v['sha256']==sha(v['snapshot']) for f,v in assembly.items())
trace=read(old.parent/'append_trace_01.json')
assert all(sha(v['path'])==v['after_sha256'] for v in trace['documents'])
evidence={f.name:sha(f) for f in sorted(p.iterdir()) if f.is_file()}
gates=dict(whole_bootstrap_closed=False,persistent_common_owner_bound=False,group_execution_ready=False,
    common_reference_input_verified=False,selector_producer_connected=False,paired_owner_authenticated=False,
    N_reuse_verified=False,Rref_reuse_verified=False,resource_admission=False,formal_execution_ready=False,
    formal_result=False,native_execution_authorized=False,official_verdict=False,continuation_ready=False,
    owner_consumption_authorized=False,selector_parent_connected=False,non_solver_allowance_verified=False)
write(p/'development_checks.json',dict(schema='h1_selector_job_lifecycle_checks_v1',
    status='PRE_SEAL_SCOPED_FINDINGS_CLOSED',scope='owned generic Job lifecycle and callback ordering; no selector scientific adoption',
    previous_checks_path=old.as_posix(),previous_checks_sha256=sha(old),pin_count=len(pins),files_sha256=pins,
    evidence_sha256=evidence,root_tests=tests,independent_test=review['independent_test'],findings_closed=review['findings_closed'],
    real_windows_job_synthetic_tests=True,synthetic_children_stdlib_only=True,real_native_calls=0,formal_runs=0,
    actual_RTS_group_integration_verified=False,full_192_hour_execution_verified=False,**gates))
checks_sha=sha(p/'development_checks.json');ind=review['independent_test']
summary=f'''

### 2026-10-12 - Selector owned Job lifecycle boundary development reviewed

The new lifecycle layer fixes process/host identities, argv/environment and explicit generic TaskProcessBudget; validates suspended-child initial headroom; calls the parent preparation callback; rechecks owner/request/implementation; then releases and waits once. Exact successful TaskProcessObservation validation and context cleanup precede the first output-reader callback. PID/creation, natural exit0, whole-Job quiescence, configured limits, success markers, samples, finite elapsed, process/Job peaks and complete minimum commit/disk reserve vectors are checked. Active same-identity reentry is rejected. Exceptional close requests termination but does not itself prove active count zero.

PRE_SEAL F1 now restricts inspection to a schema-bound, finite canonical JSON envelope capped at1MiB and roundtrip detached. F2 fixes closed primitive functions/classes/methods at module import, including lower-level Job/resource/store helpers; preinstalled acquire/release/wait/validator replacements and fabricated valid wait observations are rejected before acquisition. F3 uses immutable authority flags with exact identity/key/all-false runtime scope checks. This is drift detection in a trusted Python process, not isolation from arbitrary memory modification. Initial34-passed evidence did not close these findings; the original drafts and review remain preserved.

Final root suite: {tests['root_test_02']['passed']} passed in {tests['root_test_02']['pytest_seconds']}s; unchanged generic Job regression: {tests['root_regression_01']['passed']} passed in {tests['root_regression_01']['pytest_seconds']}s; independent targeted: {ind['passed']} passed/{ind['deselected']} deselected in {ind['pytest_seconds']}s. All final commands exit0 and reviewed bytes unchanged. Tests include real short Windows Jobs with stdlib-only synthetic children, nonzero exit, timeout, surviving descendants, before-release failure, callback replacement, reentry, primitive pre-replacement, payload rejection/detachment and authority flag mutation. Zero real native and zero formal runs.

Evidence: {p.as_posix()}/development_checks.json, SHA256 {checks_sha},1030 pins. All predecessor pins, reviewed open-bootstrap snapshots, v2/v3 outer895/1695 and run248/251 are unchanged. This is scoped PRE_SEAL development closure, not official review or execution authority.

This boundary does not authenticate selector outputs or issue a live Rref capability. Next wire the selector-specific controller: fixed worker argv, durable input/launch/release records, fresh source reconstruction and full worker/scientific/timing output audit, then parent terminal and persistent phase transaction. Actual release must require an exact live Rref parent completion freshly matched to snapshot reference root/terminal/request/cap and Job evidence; a scientific archive or false flag cannot substitute. Parent QPC endpoints are diagnostic only and are not joined with child clocks. Hour1+,192-hour coverage, legal reuse DAG, same-contract LB/UB, complete resource admission, successor seal and fresh official review remain open. selector_parent_connected=false; owner_consumption_authorized=false; non_solver_allowance_verified=false; resource_admission=false; formal_execution_ready=false; formal_result=false; native_execution_authorized=false. New real native still requires a concrete admitted package and specific authority.
'''.encode('utf-8')
updates=[]
for item in trace['documents']:
    target=Path(item['path']);before=target.read_bytes()
    assert sha(target)==item['after_sha256']
    with target.open('ab') as stream:stream.write(summary)
    assert target.read_bytes()==before+summary
    updates.append(dict(path=target.as_posix(),before_sha256=item['after_sha256'],after_sha256=sha(target),original_bytes_preserved=True))
write(p/'append_trace_01.json',dict(documents=updates,development_checks_sha256=checks_sha))
draft=Path('results/tables/rq2_h1_bootstrap_integration_v1_non_authoritative/draft_state_19.json')
write(draft,dict(status='DRAFT_NONAUTHORITATIVE',scope='selector owned generic Job lifecycle boundary',
    development_checks_path=(p/'development_checks.json').as_posix(),development_checks_sha256=checks_sha,**gates))
diff=subprocess.run(['git','diff','--check'],capture_output=True,text=True);assert diff.returncode==0,diff.stdout+diff.stderr
status=subprocess.check_output(['git','status','--short'],text=True)
assert all(sha(f)==h for f,h in pins.items())
write(p/'final_verification_01.json',dict(development_checks_sha256=checks_sha,pin_count=len(pins),pin_drift=[],
    evidence_count=len(evidence),evidence_drift=[f for f,h in evidence.items() if sha(p/f)!=h],frozen=frozen,
    open_assembly_drift=[],document_hashes_match=True,draft_state_path=draft.as_posix(),draft_state_sha256=sha(draft),
    git_diff_check_exit=diff.returncode,git_status_count=len(status.splitlines())))
print(json.dumps(dict(development_checks_sha256=checks_sha,pin_count=len(pins),draft_state_sha256=sha(draft))))
