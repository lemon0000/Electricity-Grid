@pytest.mark.parametrize('after',[False,True])
def test_new_terminal_write_failure_never_returns(factory,monkeypatch,after):
    c=factory();original=m.capture.write
    def fail(path,value):
        if path==c[1]/'terminal.json':
            if after:original(path,value)
            raise OSError('timed terminal confirmation failed')
        return original(path,value)
    monkeypatch.setattr(m.capture,'write',fail)
    with pytest.raises(OSError):run(c)
    assert (c[0]/'terminal.json').exists() and (c[1]/'terminal.json').exists()==after
    with pytest.raises(FileExistsError):run(c)


@pytest.mark.parametrize('target',['science','timing'])
def test_joint_read_bookend_rejects_drift(factory,monkeypatch,target):
    c=factory();out=run(c);original=m.stage.inspect
    def drift(*a,**kw):
        result=original(*a,**kw)
        path=c[0]/'observations.json' if target=='science' else c[1]/'native/intent.json'
        path.write_bytes(path.read_bytes()+b' ')
        return result
    monkeypatch.setattr(m.stage,'inspect',drift)
    with pytest.raises(ValueError):replay(c,out)
