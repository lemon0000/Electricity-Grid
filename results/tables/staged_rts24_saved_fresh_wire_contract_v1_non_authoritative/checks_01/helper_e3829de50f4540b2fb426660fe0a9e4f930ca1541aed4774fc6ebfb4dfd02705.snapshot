def raw(v):return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')
def pin(v):return dict(bytes=len(v),sha256=sha256(v).hexdigest())
def read(p):return json.loads(p.read_bytes())
def names(paths):return {p.relative_to(ROOT).as_posix():pin(p.read_bytes()) for p in paths}
def save(n,v):
    data=raw(v);assert len(data)<=2*1024**2
    with (MAIN/n).open('xb') as f:f.write(data)
def literal(v):return dict(literal=v)
def fields(text,t='sha'):return dict.fromkeys(text.split(),t)
def constant(n):
    if isinstance(n,ast.Constant):return n.value
    if isinstance(n,ast.BinOp) and isinstance(n.op,ast.Pow):return constant(n.left)**constant(n.right)
    if isinstance(n,ast.BinOp) and isinstance(n.op,ast.Mult):return constant(n.left)*constant(n.right)
    assert isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='dict' and not n.args
    return {v.arg:constant(v.value) for v in n.keywords}
def baseline():
    previous=read(PREV/'checks_01/baseline.json');preserved=dict(previous['preserved'])
    preserved.update(names(p for p in PREV.rglob('*') if p.is_file()))
    preserved.update({n:p for n,p in read(PREV/'checks_01/document_checks.json')['documents'].items() if n.startswith('docs/')})
    assert len(preserved)==4290
    sources=read(PREV/'checks_01/admission.json')['source_pins'];assert names(ROOT/n for n in sources)==sources
    assert names(ROOT/n for n in preserved)==preserved
    navigation={}
    for n in read(PREV/'checks_01/document_checks.json')['navigation']:
        data=(ROOT/n).read_bytes();header,sep,body=data.partition(b'\n\n');assert sep
        navigation[n]=dict(header_base64=base64.b64encode(header).decode(),body=pin(body),full=pin(data))
    helpers=names([*MAIN.glob('*.py'),*PACKAGE.glob('*.py')])
    save('baseline.json',dict(authority='DRAFT_NONAUTHORITATIVE',base_head='147fa6162be10976eb16336ae71740e143f8d594',
        sources=sources,preserved=preserved,navigation=navigation,helpers=helpers,scope_pin=pin((ROOT/SCOPE).read_bytes())))
    print(json.dumps(dict(preserved_paths=4290,source_names=49,production_source_changed=False),sort_keys=True))
