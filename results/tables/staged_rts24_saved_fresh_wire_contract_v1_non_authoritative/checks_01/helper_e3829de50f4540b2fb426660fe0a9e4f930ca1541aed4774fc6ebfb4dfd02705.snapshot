        'START keeps request original start/deadline; sent_at is only transmission observation',
        'request/header/READY/START/context/offer/ACK independently joined with host expectation and retained owner',
        'entry allocation sticky claim precedes all allocation; entry header has no future child identity',
        'stage-header binds actual suspended owner and complete descriptor; capture then release then bootstrap',
        'child projection has no parent private capture hash; parent independently joins self proof with retained owner',
        'all projections are data; emitters require exact same-process capabilities and original context/episode',
        'fresh has no issuer; no object id/capability crosses process boundary',
        'failure preserves primary/ordered cleanup/publication uncertainty;24 nodes shared; incomplete cannot authorize success',
        'success/known quiet/content reads need actual retained owners; return JSON cannot grant host consumption',
        'runtime policy/source6500/33 roots/physical deadlines/full workflow resource and actual run authority remain OPEN']
    for role,names_ in bundle_keys.items():
        for name in names_:
            node=name.removesuffix('_projection')
            if node=='broker_ACK_verified':pass
            elif node=='controller_G0':node='G0'
            elif node.endswith('_bootstrap'):node+='_projection'
            edges.append([node,role+'_projection_bundle'])
    # Regenerate order after the explicit projection-carrier dependencies were added.
    order=[];remaining=set(roles)
    while remaining:
        ready=sorted(n for n in remaining if not any(b==n and a in remaining for a,b in edges));assert ready,'projection cycle'
        order.extend(ready);remaining.difference_update(ready)
    kind_bindings={}
    for direction,kinds in directions.items():
        for sequence,kind in enumerate(kinds):
            kind_bindings[kind]=dict(direction=direction,sequence=sequence,previous_kind=None if sequence==0 else kinds[sequence-1],
                producer_binding='controller binding retained owner' if direction=='controller' else 'header.broker_identity' if direction in ('broker_terminal','broker_probe') else 'header.'+direction+'_identity',
                direction_nonce='header.direction_nonces.'+direction,binding_sha='sha256(physical mailbox header slot)',
                consumers=['broker'] if direction=='host' else ['broker','host'] if direction=='controller' else ['host'])
    constraints=dict(mailbox_kinds=kind_bindings,
        entry_frames=dict(binding=dict(sequence=0,previous_sha='0'*64),packet=dict(sequence=1,previous_sha='sha256(canonical accepted binding envelope raw)'),
            producer_identity='header.producer_identity',direction_nonce='header.entry_nonce',binding_sha='sha256(physical entry header slot)'),
        invocation=dict(start_source='request.invocation_started',deadline_source='request.deadline',deadline_offset=180,
            standby='min(original start+10, original deadline)',order=['original start','READY.ready_at','START.sent_at','offer.published_at','ACK time'],
            original_values_equal_in=['READY','START','context','ACK'],sent_at_resets_start=False),
        stage_frames=dict(normal_error_code=None,error_phase='error',error_code_required=True,terminal_and_error_exclusive=True,
            first_normal_sequence=1,first_normal_previous_sha='sha256(canonical accepted bootstrap projection raw)',
            early_error_sequence=0,early_error_previous_sha='0'*64,
            previous_sha='sha256(canonical accepted previous stage frame raw)',binding_sha='sha256(physical stage header slot)',
            bootstrap_slot_excluded_from_phase_sequence=True),
        returns=dict(controller=dict(returned_candidate=dict(required=[n+'_reference' for n in references if n!='failure']+['G2_image_sha'],
                null=['failure_reference','G3_image_sha']),failed=dict(required=['failure_reference'],null=['G3_image_sha']),
                unknown=dict(required=[],null=['G2_image_sha','G3_image_sha'])),
            broker=dict(returned_candidate=dict(required=['controller_return_sha','controller_binding_sha','broker_process_image_sha'],null=['failure_record']),
                failed=dict(required=['failure_record'],null=[]),unknown=dict(required=['failure_record'],null=[]))),
        failure=dict(primary='0 <= primary_index < len(exceptions)',cleanup='unique original ordered indices in exceptions excluding primary',
            incomplete='incomplete == (omitted_count > 0)',lossy='incomplete or any exception.truncated',
            lossy_blocks_complete_quiet=True,quiet_true_requires='actual retained-owner complete witness',
            may_have_published_requires='expected_publication_pin is not None',publication_adoption='unknown; no success from diagnostic',
            context_nullable_phases=['H0','arming','READY','START','context'],request_nullable_phases=['H0'],
            owner_nonnull_requires='direct kernel identity; never sentinel or packet self-report'),
        projections=dict(bundles=bundle_keys,freeze_before='permit',bundle_hash_source='physical entry header projection_bundle_sha',
            packet_sha_fields={r:{n:n+'_sha' for n in keys} for r,keys in bundle_keys.items()},
            coherent_bundle_header_rehash_still_requires_packet_fields=True,
            each_raw_hash_source='independent frozen packet projection SHA fields',bootstrap_carrier='first append-only stage frame index0; full raw+44<=4096',
            bootstrap_before='first phase frame and scientific hold',
            current_development_API_accepts_new_wire=False))
    registry=dict(authority='DRAFT_NONAUTHORITATIVE',implemented=False,schema_count=45,types=types,schemas=schemas,cross_field_constraints=constraints,
        wire_template_pin=template_pin,prior_registry_pin=pin((OLD/'protocol_domains.json').read_bytes()),
        original_source_pins=base['sources'],request_contract_pin=pin((RUNTIME/'request_contract_v2.json').read_bytes()),
        reference_obligations='fixed target/writer/kind; own captured context/request/stage/episode; actual quiet then independent exact read',
        mailbox_payloads=payloads,obligations=obligations,production_validator_implemented=False,actual_F=False,
        scientific_evidence_adopted=False,resource_admission=False,formal_result=False)
    matrix=read(OLD/'verification_matrix.json')['runtime_fault_matrix']+[dict(case=v,status='UNRUN') for v in obligations]
    local_edges=[*old_dag['same_process_capability_edges']]
    for role in ROLES:
        local_edges.extend([[role+'_allocation_attempt',role+'_entry_transport_handles'],
            [role+'_entry_transport_handles',role+'_entry_header'],[role+'_constructor_failed',role+'_entry_transport_close_or_retain']])
    graph=dict(authority='DRAFT_NONAUTHORITATIVE',implemented=False,prior_dag_pin=pin((OLD/'protocol_dag.json').read_bytes()),
        node_roles=roles,topological_order=order,data_order_edges=edges,same_process_capability_edges=local_edges,
        runtime_fault_matrix=matrix,hash_edges=[['frozen_template','wire_template'],['wire_template','wire_registry']],
        allocation_failure_obligation='claim stays consumed; transport closed or same-process unresolved capability retained; no retry',
        retained_failure_objects=['original_episode','sticky_claim','transport_handles','partial_owner_or_none','primary_exception','ordered_cleanup_exceptions'],
        protocol_contract_complete=False,actual_F=False,scientific_evidence_adopted=False,resource_admission=False,formal_result=False)
    for n,v in (('wire_templates.json',template),('wire_domains.json',registry),('wire_dag_matrix.json',graph)):save(n,v)
    target=PACKAGE/'saved_checks.py';assert pin(target.read_bytes())==base['helpers'][target.relative_to(ROOT).as_posix()]
    spec=importlib.util.spec_from_file_location('independent_wire_design_oracle',target);oracle=importlib.util.module_from_spec(spec);spec.loader.exec_module(oracle)
    print(json.dumps(oracle.verify_design(),sort_keys=True))
assert sys.argv[1:] in (['baseline'],['design'])
baseline() if sys.argv[1]=='baseline' else design()
