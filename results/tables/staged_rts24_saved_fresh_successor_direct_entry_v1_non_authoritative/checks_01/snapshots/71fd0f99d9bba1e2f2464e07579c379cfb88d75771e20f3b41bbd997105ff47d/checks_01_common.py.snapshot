"""Stdlib-only source epochs and bounded check evidence."""
from hashlib import sha256
import json
from pathlib import Path

ROOT=Path(__file__).resolve().parents[4]
OUT=Path(__file__).resolve().parent
PRIOR=ROOT/'results/tables/staged_rts24_saved_fresh_successor_self_anchor_v1_non_authoritative/checks_01'
EXE=Path('D:/Miniconda3/envs/compute/python.exe')
SOURCE_PATHS=('src/staged_rts24_saved_fresh_adoption_v1.py',
    'experiments/staged_rts24_saved_fresh_adoption_v1.py','tests/test_staged_rts24_saved_fresh_adoption_v1.py')
MUTABLE=set(SOURCE_PATHS[1:])
OUTPUT_PARENT=ROOT/'results/tables/staged_rts24_saved_fresh_adoption_v1_non_authoritative'
def pin(raw):return dict(bytes=len(raw),sha256=sha256(raw).hexdigest())
def canonical(value):return json.dumps(value,ensure_ascii=True,sort_keys=True,separators=(',',':'),allow_nan=False).encode('ascii')
def read(name):return json.loads((OUT/name).read_bytes())
def epoch(source):return sha256(canonical({n:source[n] for n in SOURCE_PATHS})).hexdigest()


def selected():
    before=json.loads((PRIOR/'group_admission_04.json').read_bytes())['source_pins'];assert len(before)==49
    actual={n:pin((ROOT/n).read_bytes()) for n in before}
    assert all(actual[n]==before[n] for n in before if n not in MUTABLE)
    return actual


def save(name,value):
    p=OUT/name;assert not p.exists(),name
    p.write_bytes((json.dumps(value,sort_keys=True,indent=2)+'\n').encode())


def snapshot(path):
    raw=path.read_bytes();target=OUT/'snapshots'/sha256(raw).hexdigest()/(path.parent.name+'_'+path.name+'.snapshot')
    target.parent.mkdir(parents=True,exist_ok=True)
    if target.exists():assert target.read_bytes()==raw
    else:target.write_bytes(raw)
    return dict(snapshot=target.relative_to(ROOT).as_posix(),pin=pin(raw))
