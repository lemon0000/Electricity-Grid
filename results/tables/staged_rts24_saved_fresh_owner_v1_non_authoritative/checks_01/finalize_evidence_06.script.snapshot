"""Save a draft checkpoint; no lease, actor, seal or scientific adoption."""
from hashlib import sha256
import json
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from experiments import staged_rts24_saved_fresh_adoption_v1 as entry


def pin(raw): return dict(bytes=len(raw), sha256=sha256(raw).hexdigest())
def read(name): return json.loads((OUT/name).read_bytes())
def save(name, value): (OUT/name).write_bytes((json.dumps(value, sort_keys=True, indent=2)+'\n').encode())


labels = [f'owner_bounded_{i:02d}' for i in range(1, 7)]+['stage_regression_01', 'guard_regression_01']
selected = read(labels[0]+'.exit.json')['source_pins']
assert selected == entry.source_pins()
accepted = {}; timings = {}; nodeids = []
for label in labels:
    value = read(label+'.exit.json')
    assert value['exit_code'] == 0 and value['timed_out'] is False and value['source_pins_unchanged'] is True
    assert value['source_pins'] == selected
    accepted[label] = value['nodes']; timings[label] = value['wall_seconds']; nodeids += value['nodes']
assert len(nodeids) == len(set(nodeids)) == 143
spent = sum(read(path.name)['wall_seconds'] for path in OUT.glob('*.exit.json') if read(path.name).get('nodes'))
assert spent <= 240
preserved = read('preservation_inventory.json')
for name, expected in preserved.items(): assert pin((ROOT/name).read_bytes()) == expected, name
save('development_summary.json', dict(authority='DRAFT_NONAUTHORITATIVE', source_pins=selected,
    accepted_groups=accepted, timings=timings, final_nodeids=nodeids, current_epoch_terminal_nodes=143,
    owner_unit_nodes=56, stage_nodes=68, guard_nodes=19, affected_binding_nodes=0,
    related_regression_complete=False, pending_affected_binding_nodes=read('group_admission_06.json')['groups']['binding_affected_01'],
    full_binding_77_rerun=False, frozen_binding_nodes_not_inherited=77,
    pytest_seconds=spent, pytest_cap_seconds=240, static_cap_seconds=60, whole_cap_seconds=300,
    preserved_old_paths=len(preserved), actual_saved_F_execution=False, F_launch_admitted=False,
    saved_P1_fresh_process_verified=False, saved_P1_parent_adoption_verified=False,
    scientific_evidence_adopted=False, resource_admission=False, formal_result=False))
handoff = ROOT/'docs/plan/continuation_handoff_20261025_saved_fresh_owner.md'
report = OUT.parent/'validation_report.md'
contract = ROOT/'docs/plan/staged_deliverability_c_saved_fresh_owner_development_contract_v1.md'
owner_seconds = sum(timings[n] for n in labels[:6])
report.write_text(f'''# C：saved owner/watcher 草稿验证

2026-10-25，DRAFT_NONAUTHORITATIVE。接续[冻结绑定77交接](../../../docs/plan/continuation_handoff_20261025_saved_fresh_binding_completion.md)，按[独立开发合同](../../../docs/plan/staged_deliverability_c_saved_fresh_owner_development_contract_v1.md)实施。root唯一writer，独立只读PRE_SEAL必修finding已闭合；本包没有official verdict或运行授权。

独立saved constructor/watcher、严格saved startup/record reader和quiet后读取接口已编码。输入与permit消费由一个attempt-state tuple提交；public issuer保持关闭。单位入口只接受ENTRY固定stub及闭集script，绑定原unit、固定方法/code与kernel身份；partial owner/channel、primary和cleanup原异常均强持。首次或后续entry身份无效时保留stage并拒绝foreign cleanup；有效owner遇source/clock异常仍走一次有界清理。ordinary wrapper继续拒绝saved domain，共享active core仅使用kernel与固定RAM。

当前同一SF49/source epoch终态通过143个唯一节点：56 owner（六组{owner_seconds:.3f}s），68 stage（{timings['stage_regression_01']:.3f}s），19 guard（{timings['guard_regression_01']:.3f}s）。18个直接相关binding在25.015s到帽后停止，没有终态，保留为待补验；本批相关回归未全部闭合。这些fixture使用logical parent/main/tree和当前PID的真实RAM传输，恒real_owner=false；不是实际saved文件进程、独立child或P1科学重放。完整77旧绑定节点没有在新epoch全跑，旧包仍精确归属原snapshot。

本批pytest累计{spent:.3f}s/240s，独立静态/保存检查帽60s，总帽300s。首轮smoke序列化失败11.609s、修正后的旧epoch三节点10.531s、19节点组25.016s及18 binding组25.015s到帽均保留；超时没有终态，未计通过。owner组随后改为最多10节点/30s，未延长累计帽、没有actor自动重试。18 binding将另按源码不变的只读补验合同固定45s pytest/15s静态，不记入本批通过或挪用本批预算。每次pytest保留三源snapshot、source pins、raw stdout/stderr和exit。静态捕获中collection包含在父捕获内，保存检查保守重复计时并核≤60s。

旧2848路径和P1全683文件保持，scientific src/原guard/outer/原F scope-budget未改。SF49、17 targets、8MiB/64files、四份128KiB record、5,537,792B reservations，以及一次parent/一次fresh、零solver/重试、fresh40+5+5与whole180s不变。实际OUTPUT及其父目录仍不存在。

下一步先以不变源码补验18相关binding；然后固定trusted saved supervisor/issuer和实际role执行的scope/DAG、完整调用与最大合法context/record编码、发布/cleanup失败窗及预算，再决定独立最小实现。实际issuer/public CLI/supervise与saved fresh/最终父端采用未运行，昂贵失败、arming及host I/O硬中断、180s整链和资源准入继续OPEN。saved_P1_fresh_process_verified、saved_P1_parent_adoption_verified、F_launch_admitted、scientific_evidence_adopted、resource_admission、formal_result均false。没有新增模拟小时。

保存入口：[checks_01/saved_checks.py](checks_01/saved_checks.py)；完整分组见[development_summary.json](checks_01/development_summary.json)，只读复核过程见[notes](checks_01/pre_seal_audit_notes.md)。未来ENTRY/tests变化只保留frozen证据，不能自动继承本epoch143当前通过。
''', encoding='utf-8', newline='\n')
handoff.write_text(f'''# C：saved owner/watcher 草稿交接

2026-10-25，DRAFT_NONAUTHORITATIVE，起始HEAD `8528cbe1c7982c83fc7403c54c5990a148c73822`；最终发布hash以远端读回为准。接续[冻结绑定77](continuation_handoff_20261025_saved_fresh_binding_completion.md)。按[独立开发合同](staged_deliverability_c_saved_fresh_owner_development_contract_v1.md)实现saved owner/watcher及严格record/quiet读取接口，public issuer与saved CLI仍关闭，目标继续。

固定stub/script、单一attempt-state消费、原unit/kernel/code身份、partial owner/异常强持及entry无效拒绝foreign cleanup已经独立只读PRE_SEAL复核。当前SF49 epoch143唯一节点终态通过：56 owner、68 stage、19 guard；pytest共{spent:.3f}s/240s，静态帽60s，总帽300s。失败smoke和两次25s超时均原样保留，后者不是通过；18直接相关binding待源码不变的独立45s/15s补验。旧77仅属于其冻结snapshot，新epoch没有全77复跑。全部单位使用logical context和当前PID/RAM，未构造真实saved Native owner。

P1全683、旧2848路径、原F scope-budget/guard/outer、scientific src及全部科学假设保持。实际OUTPUT/父目录不存在，没有B/C/E重放、solver或新模拟小时。fresh40+5+5、whole180s、一次parent/fresh、零重试及原targets/字节帽不变。

报告：[validation_report.md](../../results/tables/staged_rts24_saved_fresh_owner_v1_non_authoritative/validation_report.md)。保存核验：`D:\\Miniconda3\\envs\\compute\\python.exe -B results/tables/staged_rts24_saved_fresh_owner_v1_non_authoritative/checks_01/saved_checks.py`；它区分frozen与current源码，旧77不会继承为本epoch证据。

下一步先补验18相关binding，再固定trusted saved supervisor/issuer、实际role执行和最终父采用的DAG/完整调用/最大合法编码/失败收尾及预算，再进入最小有界实现。实际issuer/supervise/public CLI和真实saved F未开放；昂贵失败、arming及host最终I/O硬中断、整链资源仍OPEN。局部fresh/parent verified与整包科学采用、resource/formal全false。恢复时先核Git/进程、运行保存检查，root唯一writer，继续遵守agent.md §7–9。
''', encoding='utf-8', newline='\n')
prefix = (f'2026-10-25 saved owner/watcher草稿：见[交接]({handoff.name})。当前epoch143唯一节点终态通过（56 owner/68 stage/19 guard），pytest {spent:.3f}s/240s；18相关binding到帽无终态，另固定源码不变的45s/15s补验。固定unit stub无Native，issuer/public saved CLI/实际F及科学/资源/正式门禁仍关闭。旧77仅属于冻结snapshot，未全量继承到新源码。\n\n').encode()
for name, before in read('navigation_before.json').items():
    path = ROOT/name; raw = path.read_bytes()
    assert pin(raw[-before['body']['bytes']:]) == before['body']
    head, separator, body = raw.partition(b'\n\n')
    relative = handoff.name if Path(name).parent.as_posix() == 'docs/plan' else '../plan/'+handoff.name
    added = prefix.replace(handoff.name.encode(), relative.encode())
    if added not in raw: path.write_bytes(head+separator+added+body)
documents = [contract, report, handoff, OUT/'pre_seal_audit_notes.md']
for path in documents:
    for target in re.findall(r'\]\(([^)]+)\)', path.read_text(encoding='utf-8')):
        if '://' not in target: assert (path.parent/target.split('#')[0]).resolve().exists(), (path, target)
save('document_checks.json', dict(authority='DRAFT_NONAUTHORITATIVE', links_resolve=True,
    document_pins={p.relative_to(ROOT).as_posix():pin(p.read_bytes()) for p in documents}))
save('support_pins.json', {p.relative_to(ROOT).as_posix():pin(p.read_bytes()) for p in OUT.rglob('*')
    if p.is_file() and p.name != 'support_pins.json'})
print(json.dumps(dict(terminal_unique_nodes=len(nodeids), pytest_seconds=spent, owner_seconds=owner_seconds,
    preserved_old_paths=len(preserved), document_links_resolve=True)))
