  "findings": {
    "blocker": [
      {
        "id": "caller_constructible_transport_acceptance",
        "finding": "Activation transport v2 exposes begin_transport_attempt(process, ...) and accept_verified_transport(evidence, capability). A caller can supply an arbitrary live Popen and construct capability, ACK, source, receipt, and AcceptedEvidence objects, so acceptance proves only internal consistency and not origin from the sealed production-worker command and anonymous-pipe exchange."
      }
    ],
    "major": [
      {
        "id": "test_seam_bypasses_origin_assurance",
        "finding": "The v2 focused tests directly register caller-built AttemptCapability objects in the controller's active-attempt map and then accept synthetic production evidence; this does not establish a controller-owned spawn-to-append state machine."
      },
      {
        "id": "production_worker_path_not_exercised",
        "finding": "The only real child path is a pre-loader probe that is intentionally outside the production ledger. No sealed internal-production-worker command reaches the authority boundary and returns an explicitly non-accepted production attempt without permitting 0009."
      }
    ],
    "minor": []
  },
  "required_remediation": {
