    "blocker": [],
    "major": [
      {
        "id": "toolhelp_error_semantics",
        "finding": "Process32FirstW failure is not rejected; Process32NextW failure is treated as EOF without requiring GetLastError==ERROR_NO_MORE_FILES; the accepted inventory does not prove that it contains the current PID."
      },
      {
        "id": "checkpoint_exact_lexical_inventory",
        "finding": "Checkpoint inventory uses Path.iterdir/is_file and therefore does not establish an exact lexical tree of nine ordinary, accessible, non-alias files; extra directories, broken aliases, junction/reparse entries, special or unreadable entries, type swaps, and enumeration failures are not all fail-closed."
      },
      {
        "id": "presence_and_locked_interpreter_lstat",
        "finding": "Absent-root classification relies on os.path.lexists, which may collapse access or other OS errors into absence; the locked Python executable is hashed before the same strict lexical ancestor/leaf lstat, reparse, mount, accessibility, and type gate is proved."
      }
    ],
