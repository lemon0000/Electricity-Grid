  "findings": {
    "blocker": [
      {
        "id": "permanently_closed_v4_transport_authority",
        "finding": "The activation candidate points to v4 dispatch/worker entrypoints that permanently reject execution and whose frozen argv/authority contract cannot match a future activation wrapper; the referenced path is therefore not an executable successor transport."
      }
    ],
    "major": [
      {
        "id": "unverified_historical_ledger_records",
        "finding": "The candidate validates only the newly appended mapping. Caller-supplied historical records are not reconstructed from genesis or revalidated for schema, digests, predecessor bindings, identity uniqueness, ordering, source bytes, ACK, and replay, so forged history can unlock block 0009."
      },
      {
        "id": "activation_review_effect_overauthorizes_execution",
        "finding": "The future activation-review receipt schema requires activation_execution_authorized and two_block_pilot_execution_authorized to be true too early. This review may authorize only construction and independent review of an immutable execution wrapper; a later exact receipt and human review must authorize dispatch."
      }
    ],
    "minor": []
  },
